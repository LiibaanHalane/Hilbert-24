library Native_Shortest_Proof
logic CASL

%% Fixed infinite Cech test and the Fredkin-Toffoli return.
%% ce_selected_total_iff_original_unsat uses the original failed clause.
%% cr_gate_is_exact_extra_degeneracy connects the marked gate to every degree.
%% lc_possible_iff_inside_observation is the backward light cone theorem.
%% sl_forced_index_comparison gives exact constancy under partial observation.
%% cd_frozen_cech_clock_equivalence fixes the monitor and clock before the input.
%% The companion proof interprets the fibre equations on the full product
%% of all Eilenberg-Mac Lane factors and accounts for the deterministic clock.
%%
%% Two-sided induction across every cut of the original CNF.
%%   bx_cut_all proves soundness AND reflection across every finite depth.
%%   bx_cut_every_shortest_proof gives the converse for every tied minimum.
%%   bx_read_cut_invariance computes the same two rails at every cut.
%%   gf_positive_iff_checked_terminal and gf_negative_iff_all_checked_terminals
%%   apply to the distinct terminal keys of a shared proof graph.
%%   bm_pos_iff_sure_sat and bm_neg_iff_sure_unsat identify the exact
%%   conclusions from partial observations through the matrix.
%% The work counters use one unit per terminal receipt, lift or join.
%% The observation theorem ranges over Boolean completions of queried values.
%%
%% A single fixed verifier on original CNFs. Read rr_constructed_shortest for
%% the global theorem, rr_right_witness_now for immediate positive release,
%% and rr_matrix_commutes_at_every_split for its native two-corner read.
%% Proof for one verifier V* and any original n-variable input C:
%%   (1) V* accepts 0a precisely for a satisfying n-bit assignment a,
%%       and always accepts 10^(n+1). These lengths are n+1 and n+2.
%%   (2) Split one marked assignment fibre by its next bit. Either inclusion
%%       brings a model back to C. A refutation covers both children.
%%       The sparse Rule 30 product reads their positive OR and negative AND.
%%   (3) At a leaf evaluate the original clauses. Fold by (2), induct on
%%       remaining depth, and emit 0a or the fallback. By (1) this output is
%%       globally shortest among ALL bitstrings accepted by this same V*.
%%   (4) For a negative root, ocScan supplies the first actual failed clause
%%       occurrence for each original assignment. There is no tie policy.
%%
%% Named %implied statements are goals. Constructor equations and explicitly
%% identified instances of free-datatype induction supply their premises.
%% All results here are qualitative; there is no premise about elapsed time.


%% q is one original CNF and a fixed prefix with a next decision bit.
%% Tail ranges over the remaining assignments in the chosen split.
%% Clause identifiers name occurrences in the original CNF.
spec WitnessCoverData =
  sorts Context, Tail, Clause, WholeCover, LeftCover, RightCover
  free type Bit ::= bzero | bone
  free type Address ::= point(Bit; Tail)
  free type Tagged ::= leftTag(Tail) | rightTag(Tail)
  ops split : Address -> Tagged;
      join : Tagged -> Address;
      atWhole : WholeCover * Address -> Clause;
      atLeft : LeftCover * Tail -> Clause;
      atRight : RightCover * Tail -> Clause;
      restrictLeft : WholeCover -> LeftCover;
      restrictRight : WholeCover -> RightCover;
      glue : LeftCover * RightCover -> WholeCover
  preds member : Context * Clause;
        holds : Context * Address * Clause;
        winner : Context * Address;
        branchWinner : Context * Tagged;
        failsAt : Context * Address * Clause;
        allZero, allOne : Context * WholeCover;
        fullCover : Context * WholeCover;
        leftCover : Context * LeftCover;
        rightCover : Context * RightCover

  %% Three constructor coverage laws are explicit instances of free generation.
  forall b : Bit . b = bzero \/ b = bone %(wc_bit_cases)%
  forall x : Address . exists b : Bit; t : Tail . x = point(b,t) %(wc_addr_cases)%
  forall z : Tagged . (exists t : Tail . z = leftTag(t)) \/
                      (exists t : Tail . z = rightTag(t)) %(wc_tag_cases)%
  forall t : Tail
    . split(point(bzero,t)) = leftTag(t) %(wc_split_left)%
    . split(point(bone,t)) = rightTag(t) %(wc_split_right)%
    . join(leftTag(t)) = point(bzero,t) %(wc_join_left)%
    . join(rightTag(t)) = point(bone,t) %(wc_join_right)%

  forall q : Context; x : Address; c : Clause; t : Tail
    . winner(q,x) <=> (forall d : Clause . member(q,d) => holds(q,x,d)) %(wc_winner_def)%
    . failsAt(q,x,c) <=> member(q,c) /\ not holds(q,x,c) %(wc_failure_def)%
    . branchWinner(q,leftTag(t)) <=> winner(q,point(bzero,t)) %(wc_branch_left)%
    . branchWinner(q,rightTag(t)) <=> winner(q,point(bone,t)) %(wc_branch_right)%

  %% At a point, restriction and gluing return the very same clause identifier.
  forall p : WholeCover; l : LeftCover; r : RightCover; t : Tail
    . atLeft(restrictLeft(p),t) = atWhole(p,point(bzero,t)) %(wc_read_left)%
    . atRight(restrictRight(p),t) = atWhole(p,point(bone,t)) %(wc_read_right)%
    . atWhole(glue(l,r),point(bzero,t)) = atLeft(l,t) %(wc_glue_left)%
    . atWhole(glue(l,r),point(bone,t)) = atRight(r,t) %(wc_glue_right)%
  forall p,h : WholeCover
    . (forall x : Address . atWhole(p,x) = atWhole(h,x)) => p = h %(wc_ext_whole)%
  forall l,k : LeftCover
    . (forall t : Tail . atLeft(l,t) = atLeft(k,t)) => l = k %(wc_ext_left)%
  forall r,k : RightCover
    . (forall t : Tail . atRight(r,t) = atRight(k,t)) => r = k %(wc_ext_right)%
  forall q : Context; p : WholeCover; l : LeftCover; r : RightCover
    . allZero(q,p) <=> (forall t : Tail . failsAt(q,point(bzero,t),atWhole(p,point(bzero,t)))) %(wc_zero_def)%
    . allOne(q,p) <=> (forall t : Tail . failsAt(q,point(bone,t),atWhole(p,point(bone,t)))) %(wc_one_def)%
    . fullCover(q,p) <=> (forall x : Address . failsAt(q,x,atWhole(p,x))) %(wc_full_def)%
    . leftCover(q,l) <=> (forall t : Tail . failsAt(q,point(bzero,t),atLeft(l,t))) %(wc_left_def)%
    . rightCover(q,r) <=> (forall t : Tail . failsAt(q,point(bone,t),atRight(r,t))) %(wc_right_def)%
end

spec WitnessCoverProof = WitnessCoverData then
  forall q : Context; x : Address; z : Tagged; p : WholeCover; l : LeftCover; r : RightCover
    . join(split(x)) = x %(wc_positive_source_roundtrip)% %implied
    . split(join(z)) = z %(wc_positive_tag_roundtrip)% %implied
    . winner(q,x) <=> branchWinner(q,split(x)) %(wc_positive_push)% %implied
    . branchWinner(q,z) <=> winner(q,join(z)) %(wc_positive_pull)% %implied
    . (not (exists a : Address . winner(q,a))) <=>
        (not (exists t : Tail . winner(q,point(bzero,t)))) /\
        (not (exists t : Tail . winner(q,point(bone,t)))) %(wc_no_model_split)% %implied
    . restrictLeft(glue(l,r)) = l %(wc_negative_left_roundtrip)% %implied
    . restrictRight(glue(l,r)) = r %(wc_negative_right_roundtrip)% %implied
    . (forall t : Tail . atWhole(glue(restrictLeft(p),restrictRight(p)),point(bzero,t))
                           = atWhole(p,point(bzero,t))) %(wc_glue_read_zero)% %implied
    . (forall t : Tail . atWhole(glue(restrictLeft(p),restrictRight(p)),point(bone,t))
                           = atWhole(p,point(bone,t))) %(wc_glue_read_one)% %implied
    . atWhole(glue(restrictLeft(p),restrictRight(p)),x) = atWhole(p,x)
         %(wc_glue_read_any)% %implied
    . glue(restrictLeft(p),restrictRight(p)) = p %(wc_negative_source_roundtrip)% %implied
    . fullCover(q,p) <=> allZero(q,p) /\ allOne(q,p) %(wc_split_quantifier)% %implied
    . allZero(q,glue(l,r)) <=> leftCover(q,l) %(wc_glue_zero_valid)% %implied
    . allOne(q,glue(l,r)) <=> rightCover(q,r) %(wc_glue_one_valid)% %implied
    . allZero(q,p) <=> leftCover(q,restrictLeft(p)) %(wc_restrict_zero_valid)% %implied
    . allOne(q,p) <=> rightCover(q,restrictRight(p)) %(wc_restrict_one_valid)% %implied
    . fullCover(q,glue(l,r)) <=> leftCover(q,l) /\ rightCover(q,r)
         %(wc_negative_glue_valid)% %implied
    . fullCover(q,p) <=> leftCover(q,restrictLeft(p)) /\ rightCover(q,restrictRight(p))
         %(wc_negative_restrict_valid)% %implied
    . fullCover(q,p) => not winner(q,x) %(wc_cover_excludes_each_assignment)% %implied
end

%% fadd and fmul are addition and multiplication in F_2.
%% Each block tri(a,f,d) denotes the ordinary matrix [[a,0],[f,d]].
%% A frame embeds its first block on ordered coordinates (1,4), its second
%% on (2,3), with zero cross-block entries. These coordinates partition the
%% four basis vectors, so ordinary 4 by 4 multiplication is blockwise.
spec NativeTileData =
  free type FBit ::= fzero | fone
  free type FTriangle ::= tri(FBit; FBit; FBit)
  free type FFrame ::= blocks(FTriangle; FTriangle)
  free type FRails ::= rails(FBit; FBit)
  ops fnot : FBit -> FBit;
      fadd, fmul, fjoin : FBit * FBit -> FBit;
      ruleBit : FBit * FBit * FBit -> FBit;
      blkLeft : FBit * FBit -> FTriangle;
      blkRight : FBit -> FTriangle;
      atSeam : FTriangle -> FBit;
      blkProd : FTriangle * FTriangle -> FTriangle;
      frameProd : FFrame * FFrame -> FFrame;
      leftFactor, rightFactor : FRails -> FFrame;
      readFrame : FFrame -> FRails;
      readSplit : FRails * FRails -> FRails
  forall b : FBit . b = fzero \/ b = fone %(nt_bit_cases)%
  . fnot(fzero) = fone %(nt_not_zero)%
  . fnot(fone) = fzero %(nt_not_one)%
  forall x : FBit
    . fadd(fzero,x) = x %(nt_add_zero)%
    . fadd(fone,x) = fnot(x) %(nt_add_one)%
    . fmul(fzero,x) = fzero %(nt_mul_zero)%
    . fmul(fone,x) = x %(nt_mul_one)%
    . fjoin(fzero,x) = x %(nt_join_zero)%
    . fjoin(fone,x) = fone %(nt_join_one)%
  forall l,c,r,a,f,d,b,g,e : FBit
    . ruleBit(l,c,r) = fadd(l,fjoin(c,r)) %(nt_rule30_def)%
    . blkLeft(l,c) = tri(fone,fnot(l),fnot(c)) %(nt_left_def)%
    . blkRight(r) = tri(fone,fnot(r),fone) %(nt_right_def)%
    . atSeam(tri(a,f,d)) = f %(nt_seam_def)%
    . blkProd(tri(a,f,d),tri(b,g,e)) =
        tri(fmul(a,b),fadd(fmul(f,b),fmul(d,g)),fmul(d,e)) %(nt_matrix_product)%
  forall a,b,c,d : FTriangle; p,n : FBit; x,y : FRails
    . frameProd(blocks(a,b),blocks(c,d)) =
        blocks(blkProd(a,c),blkProd(b,d)) %(nt_block_product)%
    . leftFactor(rails(p,n)) = blocks(blkLeft(fzero,p),blkLeft(fone,fnot(n)))
        %(nt_left_factor)%
    . rightFactor(rails(p,n)) = blocks(blkRight(p),blkRight(fnot(n)))
        %(nt_right_factor)%
    . readFrame(blocks(a,b)) = rails(atSeam(a),atSeam(b)) %(nt_corner_reads)%
    . readSplit(x,y) = readFrame(frameProd(leftFactor(x),rightFactor(y)))
        %(nt_split_def)%
end

spec NativeTileProof = NativeTileData then
  forall a,b,c,d : FTriangle
    . readFrame(frameProd(blocks(a,b),blocks(c,d))) =
        rails(atSeam(blkProd(a,c)),atSeam(blkProd(b,d))) %(nt_read_block_product)% %implied
  forall a,b,d,e,f,g : FBit
    . atSeam(blkProd(tri(a,f,d),tri(b,g,e))) = fadd(fmul(f,b),fmul(d,g))
        %(nt_seam_product)% %implied
  forall x,y,l,c,r,p,n,q,m : FBit
    . fnot(fjoin(fnot(x),fnot(y))) = fmul(x,y) %(nt_demorgan)% %implied
    . fmul(x,fone) = x %(nt_right_unit)% %implied
    . fadd(fnot(l),fmul(fnot(c),fnot(r))) = ruleBit(l,c,r)
        %(nt_rule_gate)% %implied
    . atSeam(blkProd(blkLeft(l,c),blkRight(r))) =
        fadd(fmul(fnot(l),fone),fmul(fnot(c),fnot(r))) %(nt_raw_seam)% %implied
    . atSeam(blkProd(blkLeft(l,c),blkRight(r))) = ruleBit(l,c,r)
        %(nt_rule30_matrix)% %implied
    . ruleBit(fzero,p,q) = fjoin(p,q) %(nt_positive_read)% %implied
    . ruleBit(fone,fnot(n),fnot(m)) = fmul(n,m) %(nt_negative_read)% %implied
    . readSplit(rails(p,n),rails(q,m)) =
        readFrame(frameProd(blocks(blkLeft(fzero,p),blkLeft(fone,fnot(n))),
                            blocks(blkRight(q),blkRight(fnot(m)))))
        %(nt_insert_factors)% %implied
    . readSplit(rails(p,n),rails(q,m)) =
        rails(atSeam(blkProd(blkLeft(fzero,p),blkRight(q))),
              atSeam(blkProd(blkLeft(fone,fnot(n)),blkRight(fnot(m)))))
        %(nt_two_seams)% %implied
    . atSeam(blkProd(blkLeft(fzero,p),blkRight(q))) = ruleBit(fzero,p,q)
        %(nt_rule_at_positive)% %implied
    . atSeam(blkProd(blkLeft(fone,fnot(n)),blkRight(fnot(m)))) =
        ruleBit(fone,fnot(n),fnot(m)) %(nt_rule_at_negative)% %implied
    . readSplit(rails(p,n),rails(q,m)) =
        rails(ruleBit(fzero,p,q),atSeam(blkProd(blkLeft(fone,fnot(n)),blkRight(fnot(m)))))
        %(nt_first_rule_bit)% %implied
    . readSplit(rails(p,n),rails(q,m)) =
        rails(ruleBit(fzero,p,q),ruleBit(fone,fnot(n),fnot(m)))
        %(nt_two_rule_bits)% %implied
    . readSplit(rails(p,n),rails(q,m)) = rails(fjoin(p,q),ruleBit(fone,fnot(n),fnot(m)))
        %(nt_join_first)% %implied
    . readSplit(rails(p,n),rails(q,m)) = rails(fjoin(p,q),fmul(n,m))
        %(nt_two_corners_signed_split)% %implied
    . readSplit(rails(fone,n),rails(q,m)) = rails(fone,fmul(n,m))
        %(nt_one_positive_suffices)% %implied
    . readSplit(rails(fzero,fone),rails(fzero,fzero)) = rails(fzero,fzero)
        %(nt_one_negative_leaves_unknown)% %implied
end

spec FixedVerifierMinimum =
  %% All words, including ill-shaped proofs, belong to the free binary list.
  %% An input declares its width and retains its original clauses. Indices are
  %% zero based. On a well-formed input all literal indices are below the width.
  free type VNat ::= vZ | vS(VNat)
  free type VWord ::= vNil | vZero(VWord) | vOne(VWord)
  free type VLiteral ::= vPos(VNat) | vNeg(VNat)
  free type VClause ::= vEmptyClause | vLitCons(VLiteral; VClause)
  free type VFormula ::= vEmptyFormula | vClauseCons(VClause; VFormula)
  free type VInput ::= vInput(vWidth : VNat; vFormula : VFormula)
  ops vLen : VWord -> VNat; vZeros : VNat -> VWord; vFallback : VInput -> VWord
  preds vLe : VNat * VNat; vLengthLaws : VNat;
        vBitAt : VWord * VNat; vLitTrue : VLiteral * VWord;
        vClauseTrue : VClause * VWord; vFormulaTrue : VFormula * VWord;
        vModel, vAccept, vShortest : VInput * VWord;
        vRefuted : VInput; vPositiveTag : VWord
  forall a : VWord; n,m : VNat
  . vLen(vNil) = vZ %(vm_len_empty)%
  . vLen(vZero(a)) = vS(vLen(a)) %(vm_len_zero)%
  . vLen(vOne(a)) = vS(vLen(a)) %(vm_len_one)%
  . vZeros(vZ) = vNil %(vm_pad_empty)%
  . vZeros(vS(n)) = vZero(vZeros(n)) %(vm_pad_step)%
  . vLe(vZ,n) %(vm_le_zero)%
  . not vLe(vS(n),vZ) %(vm_le_s_zero)%
  . vLe(vS(n),vS(m)) <=> vLe(n,m) %(vm_le_s_s)%
  . vLengthLaws(n) <=> vLen(vZeros(n)) = n /\ vLe(n,n) /\
       vLe(n,vS(n)) /\ not vLe(vS(n),n) %(vm_integer_invariant)%
  %% This is the instance P = vLengthLaws of induction for the free natural
  %% datatype above. Base and successor are proved from the recursion equations.
  . (vLengthLaws(vZ) /\ (forall k : VNat . vLengthLaws(k) => vLengthLaws(vS(k))))
       => (forall k : VNat . vLengthLaws(k)) %(vm_free_natural_induction)%
  . vLengthLaws(vZ) %(vm_length_base)% %implied
  . vLengthLaws(n) => vLengthLaws(vS(n)) %(vm_length_step)% %implied
  . vLengthLaws(n) %(vm_length_all)% %implied

  forall a : VWord; n : VNat; l : VLiteral; d : VClause; f : VFormula
  . not vBitAt(vNil,n) %(vm_lookup_empty)%
  . not vBitAt(vZero(a),vZ) %(vm_lookup_zero)%
  . vBitAt(vOne(a),vZ) %(vm_lookup_one)%
  . vBitAt(vZero(a),vS(n)) <=> vBitAt(a,n) %(vm_lookup_below_zero)%
  . vBitAt(vOne(a),vS(n)) <=> vBitAt(a,n) %(vm_lookup_below_one)%
  . vLitTrue(vPos(n),a) <=> vBitAt(a,n) %(vm_positive_literal)%
  . vLitTrue(vNeg(n),a) <=> not vBitAt(a,n) %(vm_negative_literal)%
  . not vClauseTrue(vEmptyClause,a) %(vm_empty_disjunction)%
  . vClauseTrue(vLitCons(l,d),a) <=> vLitTrue(l,a) \/ vClauseTrue(d,a) %(vm_or_clause)%
  . vFormulaTrue(vEmptyFormula,a) %(vm_empty_conjunction)%
  . vFormulaTrue(vClauseCons(d,f),a) <=> vClauseTrue(d,a) /\ vFormulaTrue(f,a) %(vm_and_formula)%

  forall c : VInput; a,p : VWord
  . vModel(c,a) <=> vLen(a) = vWidth(c) /\ vFormulaTrue(vFormula(c),a) %(vm_original_model)%
  . vRefuted(c) <=> (forall b : VWord . not vModel(c,b)) %(vm_original_refutation)%
  . vFallback(c) = vOne(vZero(vZeros(vWidth(c)))) %(vm_fallback_code)%
  . vAccept(c,p) <=> p = vFallback(c) \/ (exists b : VWord . p = vZero(b) /\ vModel(c,b))
       %(vm_fixed_verifier)%
  . vShortest(c,p) <=> vAccept(c,p) /\ (forall q : VWord . vAccept(c,q) => vLe(vLen(p),vLen(q)))
       %(vm_bit_length_minimum)%
  . vLen(vFallback(c)) = vS(vS(vWidth(c))) %(vm_fallback_length)% %implied
  . vModel(c,a) => vLen(vZero(a)) = vS(vWidth(c)) %(vm_model_length)% %implied
  . not vLe(vLen(vFallback(c)),vS(vWidth(c))) %(vm_fallback_exceeds_model_length)% %implied
  . vAccept(c,p) => (p = vFallback(c) \/ (exists b : VWord . p = vZero(b) /\ vModel(c,b)))
       %(vm_accepted_shapes)% %implied
  . vModel(c,a) => vShortest(c,vZero(a)) %(vm_any_model_is_shortest)% %implied
  . vShortest(c,vFallback(c)) <=> vRefuted(c) %(vm_shortest_fallback_iff_refutation)% %implied
  . vShortest(c,p) <=> ((exists b : VWord . p = vZero(b) /\ vModel(c,b)) \/
       (p = vFallback(c) /\ vRefuted(c))) %(vm_all_minima)% %implied
  . vModel(c,a) => not vShortest(c,vFallback(c)) %(vm_tie_never_changes_tag)% %implied
  %% The decision decoder reads only the first symbol of a returned minimum.
  . not vPositiveTag(vNil) %(vm_empty_tag)%
  . vPositiveTag(vZero(a)) %(vm_model_tag)%
  . not vPositiveTag(vOne(a)) %(vm_reference_tag)%
  . vShortest(c,p) => (vPositiveTag(p) <=> (exists b : VWord . vModel(c,b)))
       %(vm_shortest_tag_decides_original)% %implied
end

%% The source of this fold is the original CNF. The accumulator s stores a
%% prefix in reverse order. rrGraft(s,w) appends the forward suffix w to it.
%% Each split therefore keeps the very same formula and absolute assignment.
spec NativeRoot = FixedVerifierMinimum then
  free type RReceipt ::= rrModel(VWord) | rrNegative
  ops rrTail : VWord -> VWord;
      rrGraft : VWord * VWord -> VWord;
      rrLeaf : VInput * VWord -> RReceipt;
      rrChoose : RReceipt * RReceipt -> RReceipt;
      rrFold : VInput * VWord * VNat -> RReceipt;
      rrEmit : VInput * RReceipt -> VWord
  preds rrIn : VWord * VNat * VWord;
        rrOK : VInput * VWord * VNat * RReceipt;
        rrCorrect : VNat
  %% Constructor elimination, disjointness and injectivity of the declared free types.
  forall w : VWord . w = vNil \/ (exists b : VWord . w = vZero(b)) \/
                                      (exists b : VWord . w = vOne(b)) %(rr_word_cases)%
  forall h : RReceipt . h = rrNegative \/ (exists a : VWord . h = rrModel(a)) %(rr_receipt_cases)%
  forall j,k : VNat
    . not vS(k) = vZ %(rr_zero_disjoint)%
    . vS(k) = vS(j) => k = j %(rr_successor_injective)%
  forall s,w,a : VWord; k : VNat
    . rrTail(vZero(w)) = w %(rr_tail_zero)%
    . rrTail(vOne(w)) = w %(rr_tail_one)%
    . rrTail(vNil) = vNil %(rr_tail_empty)%
    . rrGraft(vNil,w) = w %(rr_graft_empty)%
    . rrGraft(vZero(s),w) = rrGraft(s,vZero(w)) %(rr_graft_zero)%
    . rrGraft(vOne(s),w) = rrGraft(s,vOne(w)) %(rr_graft_one)%
    . rrIn(s,k,a) <=> (exists w : VWord . vLen(w) = k /\ rrGraft(s,w) = a) %(rr_prefix_fibre)%
  forall c : VInput; s,a,b : VWord; k : VNat; h : RReceipt
    . rrOK(c,s,k,rrModel(a)) <=> rrIn(s,k,a) /\ vModel(c,a) %(rr_good_model)%
    . rrOK(c,s,k,rrNegative) <=> (forall w : VWord . rrIn(s,k,w) => not vModel(c,w))
          %(rr_good_refutation)%
    . vModel(c,rrGraft(s,vNil)) => rrLeaf(c,s) = rrModel(rrGraft(s,vNil)) %(rr_leaf_yes)%
    . not vModel(c,rrGraft(s,vNil)) => rrLeaf(c,s) = rrNegative %(rr_leaf_no)%
    . rrChoose(rrModel(a),h) = rrModel(a) %(rr_keep_left)%
    . rrChoose(rrNegative,h) = h %(rr_take_right)%
    . rrFold(c,s,vZ) = rrLeaf(c,s) %(rr_fold_leaf)%
    . rrFold(c,s,vS(k)) = rrChoose(rrFold(c,vZero(s),k),rrFold(c,vOne(s),k)) %(rr_fold_node)%
    . rrEmit(c,rrModel(a)) = vZero(a) %(rr_emit_yes)%
    . rrEmit(c,rrNegative) = vFallback(c) %(rr_emit_no)%
  forall k : VNat
    . rrCorrect(k) <=> (forall c : VInput; s : VWord . rrOK(c,s,k,rrFold(c,s,k))) %(rr_invariant)%
  %% Concrete instance of structural induction for the free type VNat.
  %% The replay must establish both premises before using this rule.
  . (rrCorrect(vZ) /\ (forall k : VNat . rrCorrect(k) => rrCorrect(vS(k))))
       => (forall k : VNat . rrCorrect(k)) %(rr_free_depth_induction)%

  forall c : VInput; s,w,a : VWord; k : VNat; l,r,h : RReceipt
    . (vLen(w) = vZ <=> w = vNil) %(rr_empty_length)% %implied
    . (rrIn(s,vZ,a) <=> a = rrGraft(s,vNil)) %(rr_fibre_leaf)% %implied
    . vLen(w) = vS(k) => ((w = vZero(rrTail(w)) \/ w = vOne(rrTail(w))) /\
                                  vLen(rrTail(w)) = k) %(rr_strip_bit)% %implied
    . vLen(w) = k => rrIn(s,k,rrGraft(s,w)) %(rr_suffix_witness)% %implied
    . vLen(w) = k => rrIn(s,vS(k),rrGraft(vZero(s),w)) %(rr_lift_zero_suffix)% %implied
    . vLen(w) = k => rrIn(s,vS(k),rrGraft(vOne(s),w)) %(rr_lift_one_suffix)% %implied
    . rrIn(vZero(s),k,a) => rrIn(s,vS(k),a) %(rr_lift_zero)% %implied
    . rrIn(vOne(s),k,a) => rrIn(s,vS(k),a) %(rr_lift_one)% %implied
    . vLen(w) = vS(k) /\ w = vZero(rrTail(w)) => rrIn(vZero(s),k,rrGraft(s,w))
          %(rr_child_zero)% %implied
    . vLen(w) = vS(k) /\ w = vOne(rrTail(w)) => rrIn(vOne(s),k,rrGraft(s,w))
          %(rr_child_one)% %implied
    . vLen(w) = vS(k) => rrIn(vZero(s),k,rrGraft(s,w)) \/ rrIn(vOne(s),k,rrGraft(s,w))
          %(rr_suffix_to_child)% %implied
    . rrIn(s,vS(k),a) => (exists u : VWord . vLen(u) = vS(k) /\ rrGraft(s,u) = a)
          %(rr_parent_witness)% %implied
    . vLen(w) = vS(k) /\ rrGraft(s,w) = a => rrIn(vZero(s),k,a) \/ rrIn(vOne(s),k,a)
          %(rr_witness_children)% %implied
    . rrIn(s,vS(k),a) => rrIn(vZero(s),k,a) \/ rrIn(vOne(s),k,a)
          %(rr_parent_to_children)% %implied
    . (rrIn(s,vS(k),a) <=> rrIn(vZero(s),k,a) \/ rrIn(vOne(s),k,a)) %(rr_fibre_split)% %implied
    . (rrIn(vNil,k,a) <=> vLen(a) = k) %(rr_empty_prefix)% %implied
    . vModel(c,rrGraft(s,vNil)) => rrOK(c,s,vZ,rrModel(rrGraft(s,vNil))) %(rr_good_yes_leaf)% %implied
    . not vModel(c,rrGraft(s,vNil)) => rrOK(c,s,vZ,rrNegative) %(rr_good_no_leaf)% %implied
    . rrOK(c,s,vZ,rrLeaf(c,s)) %(rr_checked_leaf)% %implied
    . rrOK(c,vZero(s),k,rrModel(a)) => rrOK(c,s,vS(k),rrModel(a)) %(rr_left_witness_now)% %implied
    . rrOK(c,vOne(s),k,rrModel(a)) => rrOK(c,s,vS(k),rrModel(a)) %(rr_right_witness_now)% %implied
    . rrOK(c,s,k,rrNegative) /\ rrIn(s,k,a) => not vModel(c,a) %(rr_exclude_at)% %implied
    . rrOK(c,vZero(s),k,rrNegative) /\ rrOK(c,vOne(s),k,rrNegative) /\ rrIn(s,vS(k),a)
        => not vModel(c,a) %(rr_exclude_parent_point)% %implied
    . rrOK(c,vZero(s),k,rrNegative) /\ rrOK(c,vOne(s),k,rrNegative) => rrOK(c,s,vS(k),rrNegative)
          %(rr_glue_refutations)% %implied
    . rrOK(c,s,vS(k),rrNegative) => rrOK(c,vZero(s),k,rrNegative) %(rr_restrict_zero)% %implied
    . rrOK(c,s,vS(k),rrNegative) => rrOK(c,vOne(s),k,rrNegative) %(rr_restrict_one)% %implied
    . (rrOK(c,s,vS(k),rrNegative) <=> rrOK(c,vZero(s),k,rrNegative) /\
                                            rrOK(c,vOne(s),k,rrNegative)) %(rr_two_refutations)% %implied
    . rrOK(c,vZero(s),k,l) /\ rrOK(c,vOne(s),k,r) => rrOK(c,s,vS(k),rrChoose(l,r))
          %(rr_checked_split)% %implied
    . rrCorrect(vZ) %(rr_induction_base)% %implied
    . rrCorrect(k) => rrOK(c,s,k,rrFold(c,s,k)) %(rr_depth_at)% %implied
    . rrCorrect(k) => rrOK(c,vZero(s),k,rrFold(c,vZero(s),k)) /\
                        rrOK(c,vOne(s),k,rrFold(c,vOne(s),k)) %(rr_depth_children)% %implied
    . rrCorrect(k) => rrOK(c,s,vS(k),rrChoose(rrFold(c,vZero(s),k),rrFold(c,vOne(s),k)))
          %(rr_merge_children)% %implied
    . rrCorrect(k) => rrOK(c,s,vS(k),rrFold(c,s,vS(k))) %(rr_successor_at)% %implied
    . rrCorrect(k) => rrCorrect(vS(k)) %(rr_induction_step)% %implied
    . rrCorrect(k) %(rr_all_depths)% %implied
    . rrOK(c,vNil,vWidth(c),rrNegative) <=> vRefuted(c) %(rr_full_negative)% %implied
    . rrOK(c,vNil,vWidth(c),h) => vShortest(c,rrEmit(c,h)) %(rr_root_receipt_gives_minimum)% %implied
    . rrOK(c,vNil,vWidth(c),rrFold(c,vNil,vWidth(c))) %(rr_original_root_valid)% %implied
    . vShortest(c,rrEmit(c,rrFold(c,vNil,vWidth(c)))) %(rr_constructed_shortest)% %implied
    . vPositiveTag(rrEmit(c,rrFold(c,vNil,vWidth(c)))) <=> (exists w : VWord . vModel(c,w))
          %(rr_constructed_tag_decides_source)% %implied
end

%% The matrix read is a homomorphism of the actual receipt constructor.
%% A tag forgets the assignment; rrChoose and rrEmit keep it for the proof.
spec NativeRootMatrix = NativeRoot and NativeTileProof then
  op rrTag : RReceipt -> FRails
  forall a : VWord
    . rrTag(rrModel(a)) = rails(fone,fzero) %(rr_tag_model)%
    . rrTag(rrNegative) = rails(fzero,fone) %(rr_tag_negative)%
  forall p,n : FBit
    . readSplit(rails(fone,fzero),rails(p,n)) = rails(fone,fzero) %(rr_matrix_yes)% %implied
    . readSplit(rails(fzero,fone),rails(p,n)) = rails(p,n) %(rr_matrix_no)% %implied
  forall c : VInput; s,a : VWord; k : VNat; l,r : RReceipt
    . readSplit(rails(fone,fzero),rrTag(r)) = rails(fone,fzero) %(rr_matrix_yes_tag)% %implied
    . readSplit(rails(fzero,fone),rrTag(r)) = rrTag(r) %(rr_matrix_no_tag)% %implied
    . rrTag(rrChoose(rrModel(a),r)) = readSplit(rrTag(rrModel(a)),rrTag(r)) %(rr_matrix_left_hit)% %implied
    . rrTag(rrChoose(rrNegative,r)) = readSplit(rrTag(rrNegative),rrTag(r)) %(rr_matrix_left_miss)% %implied
    . rrTag(rrChoose(l,r)) = readSplit(rrTag(l),rrTag(r)) %(rr_matrix_preserves_receipts)% %implied
    . rrTag(rrFold(c,s,vS(k))) =
        readSplit(rrTag(rrFold(c,vZero(s),k)),rrTag(rrFold(c,vOne(s),k)))
          %(rr_matrix_commutes_at_every_split)% %implied
end

%% Original zero-based clause occurrence. A satisfying assignment scans to the
%% end of the clause list; only a failed occurrence can serve as evidence.
spec OriginalClauseCover = NativeRoot then
  op ocScan : VFormula * VWord -> VNat
  preds ocFails, ocEarlierTrue : VFormula * VWord * VNat;
        ocScanOK : VFormula * VWord;
        ocLaw : VFormula
  forall a : VWord; f : VFormula; d : VClause; i : VNat
    . ocScan(vEmptyFormula,a) = vZ %(oc_scan_nil)%
    . not vClauseTrue(d,a) => ocScan(vClauseCons(d,f),a) = vZ %(oc_scan_stop)%
    . vClauseTrue(d,a) => ocScan(vClauseCons(d,f),a) = vS(ocScan(f,a)) %(oc_scan_skip)%
    . not ocFails(vEmptyFormula,a,i) %(oc_no_occ_empty)%
    . ocFails(vClauseCons(d,f),a,vZ) <=> not vClauseTrue(d,a) %(oc_fail_head)%
    . ocFails(vClauseCons(d,f),a,vS(i)) <=> ocFails(f,a,i) %(oc_fail_tail)%
    . ocEarlierTrue(f,a,vZ) %(oc_before_zero)%
    . not ocEarlierTrue(vEmptyFormula,a,vS(i)) %(oc_before_past_end)%
    . ocEarlierTrue(vClauseCons(d,f),a,vS(i)) <=> vClauseTrue(d,a) /\ ocEarlierTrue(f,a,i)
          %(oc_before_succ)%
    . ocScanOK(f,a) <=> ocEarlierTrue(f,a,ocScan(f,a)) /\
          (ocFails(f,a,ocScan(f,a)) <=> not vFormulaTrue(f,a)) %(oc_scan_invariant)%
    . ocLaw(f) <=> (forall w : VWord . ocScanOK(f,w)) %(oc_law_def)%
  %% Instance of structural induction for the free datatype VFormula.
  . (ocLaw(vEmptyFormula) /\
      (forall e : VClause; h : VFormula . ocLaw(h) => ocLaw(vClauseCons(e,h))))
      => (forall h : VFormula . ocLaw(h)) %(oc_free_formula_induction)%

  forall f : VFormula; a : VWord; d : VClause; c : VInput
    . ocScanOK(vEmptyFormula,a) %(oc_scan_base_word)% %implied
    . not vClauseTrue(d,a) => ocScanOK(vClauseCons(d,f),a) %(oc_first_head)% %implied
    . ocFails(vClauseCons(d,f),a,vS(ocScan(f,a))) <=> ocFails(f,a,ocScan(f,a))
          %(oc_instantiate_fail_tail)% %implied
    . ocEarlierTrue(vClauseCons(d,f),a,vS(ocScan(f,a))) <=>
        vClauseTrue(d,a) /\ ocEarlierTrue(f,a,ocScan(f,a))
          %(oc_instantiate_earlier_tail)% %implied
    . vClauseTrue(d,a) =>
        (ocFails(vClauseCons(d,f),a,ocScan(vClauseCons(d,f),a)) <=> ocFails(f,a,ocScan(f,a)))
          %(oc_tail_failure_read)% %implied
    . vClauseTrue(d,a) =>
        (ocEarlierTrue(vClauseCons(d,f),a,ocScan(vClauseCons(d,f),a)) <=> ocEarlierTrue(f,a,ocScan(f,a)))
          %(oc_tail_prefix_read)% %implied
    . vClauseTrue(d,a) => (vFormulaTrue(vClauseCons(d,f),a) <=> vFormulaTrue(f,a))
          %(oc_tail_truth_read)% %implied
    . ocScanOK(vClauseCons(d,f),a) <=>
        ocEarlierTrue(vClauseCons(d,f),a,ocScan(vClauseCons(d,f),a)) /\
        (ocFails(vClauseCons(d,f),a,ocScan(vClauseCons(d,f),a)) <=> not vFormulaTrue(vClauseCons(d,f),a))
          %(oc_cons_invariant_instance)% %implied
    . vClauseTrue(d,a) /\ ocScanOK(f,a) =>
        ocEarlierTrue(vClauseCons(d,f),a,ocScan(vClauseCons(d,f),a))
          %(oc_tail_earlier_from_law)% %implied
    . vClauseTrue(d,a) /\ ocScanOK(f,a) =>
        (ocFails(vClauseCons(d,f),a,ocScan(vClauseCons(d,f),a)) <=> not vFormulaTrue(vClauseCons(d,f),a))
          %(oc_tail_failure_from_law)% %implied
    . vClauseTrue(d,a) /\ ocScanOK(f,a) => ocScanOK(vClauseCons(d,f),a)
          %(oc_first_tail)% %implied
    . ocLaw(vEmptyFormula) %(oc_formula_base)% %implied
    . ocLaw(f) => ocLaw(vClauseCons(d,f)) %(oc_formula_step)% %implied
    . ocLaw(f) %(oc_law_all)% %implied
    . ocFails(f,a,ocScan(f,a)) <=> not vFormulaTrue(f,a)
          %(oc_original_failed_occurrence)% %implied
    . ocEarlierTrue(f,a,ocScan(f,a)) %(oc_every_earlier_occurrence_true)% %implied
    . vRefuted(c) <=> (forall w : VWord . vLen(w) = vWidth(c) =>
           ocFails(vFormula(c),w,ocScan(vFormula(c),w))) %(oc_original_total_cover)% %implied
    . rrOK(c,vNil,vWidth(c),rrNegative) <=> (forall w : VWord . vLen(w) = vWidth(c) =>
           ocFails(vFormula(c),w,ocScan(vFormula(c),w))) %(oc_native_negative_is_original_cover)% %implied
end

%% d is the number of splits above the frontier and k is the unresolved
%% width below it. A positive proof keeps the original assignment a.
%% A negative proof restricts to every frontier cylinder and glues back.
spec OriginalCutExactness = NativeRoot then
  ops bxAdd : VNat * VNat -> VNat
  preds bxPositive : VInput * VWord * VNat * VNat * VWord;
        bxNegative : VInput * VWord * VNat * VNat;
        bxInjection : VWord;
        bxExact : VNat
  forall c : VInput; s,a,b : VWord; d,k : VNat
    . bxAdd(vZ,k) = k %(bx_add_zero)%
    . bxAdd(vS(d),k) = vS(bxAdd(d,k)) %(bx_add_successor)%
    . bxPositive(c,s,vZ,k,a) <=> rrOK(c,s,k,rrModel(a)) %(bx_positive_at_cut)%
    . bxPositive(c,s,vS(d),k,a) <=>
        bxPositive(c,vZero(s),d,k,a) \/ bxPositive(c,vOne(s),d,k,a) %(bx_positive_step)%
    . bxNegative(c,s,vZ,k) <=> rrOK(c,s,k,rrNegative) %(bx_negative_at_cut)%
    . bxNegative(c,s,vS(d),k) <=>
        bxNegative(c,vZero(s),d,k) /\ bxNegative(c,vOne(s),d,k) %(bx_negative_step)%
    . bxInjection(s) <=> (forall x,y : VWord . rrGraft(s,x) = rrGraft(s,y) => x = y)
          %(bx_injection_def)%
    . vZero(a) = vZero(b) => a = b %(bx_zero_injective)%
    . vOne(a) = vOne(b) => a = b %(bx_one_injective)%
    . not vZero(a) = vOne(b) %(bx_disjoint_bits)%
    . rrModel(a) = rrModel(b) => a = b %(bx_model_injective)%
    . not rrModel(a) = rrNegative %(bx_receipts_disjoint)%
  %% Named, concrete instances of induction for free datatypes.
  . (bxInjection(vNil) /\
      (forall s : VWord . bxInjection(s) => bxInjection(vZero(s)) /\ bxInjection(vOne(s))))
      => (forall s : VWord . bxInjection(s)) %(bx_free_word_induction)%
  forall d : VNat
    . bxExact(d) <=>
        (forall c : VInput; s : VWord; k : VNat .
            ((forall a : VWord . bxPositive(c,s,d,k,a) <=> rrOK(c,s,bxAdd(d,k),rrModel(a))) /\
             (bxNegative(c,s,d,k) <=> rrOK(c,s,bxAdd(d,k),rrNegative))))
          %(bx_depth_invariant)%
    . (bxExact(vZ) /\ (forall j : VNat . bxExact(j) => bxExact(vS(j))))
      => (forall j : VNat . bxExact(j)) %(bx_free_depth_induction)%

  forall c : VInput; s,a,b,u,v : VWord; d,k : VNat
    . bxInjection(vNil) %(bx_injection_base)% %implied
    . bxInjection(s) /\ rrGraft(s,u) = rrGraft(s,v) => u = v %(bx_cancel_at_prefix)% %implied
    . bxInjection(s) => bxInjection(vZero(s)) %(bx_injection_zero)% %implied
    . bxInjection(s) => bxInjection(vOne(s)) %(bx_injection_one)% %implied
    . bxInjection(s) => bxInjection(vZero(s)) /\ bxInjection(vOne(s)) %(bx_injection_step)% %implied
    . bxInjection(s) %(bx_injection_all)% %implied
    . not rrGraft(vZero(s),u) = rrGraft(vOne(s),v) %(bx_disjoint_grafts)% %implied
    . not (rrIn(vZero(s),k,a) /\ rrIn(vOne(s),k,a)) %(bx_disjoint_cylinders)% %implied
    . (rrOK(c,s,vS(k),rrModel(a)) <=>
         rrOK(c,vZero(s),k,rrModel(a)) \/ rrOK(c,vOne(s),k,rrModel(a)))
          %(bx_model_split_exact)% %implied

    . bxExact(vZ) %(bx_cut_base)% %implied
    . bxExact(d) => (bxPositive(c,s,d,k,a) <=> rrOK(c,s,bxAdd(d,k),rrModel(a)))
          %(bx_positive_at_mark)% %implied
    . bxExact(d) => (bxNegative(c,s,d,k) <=> rrOK(c,s,bxAdd(d,k),rrNegative))
          %(bx_negative_at_mark)% %implied
    . bxExact(d) =>
        ((bxPositive(c,vZero(s),d,k,a) \/ bxPositive(c,vOne(s),d,k,a)) <=>
         (rrOK(c,vZero(s),bxAdd(d,k),rrModel(a)) \/ rrOK(c,vOne(s),bxAdd(d,k),rrModel(a))))
          %(bx_positive_children)% %implied
    . bxExact(d) =>
        ((bxNegative(c,vZero(s),d,k) /\ bxNegative(c,vOne(s),d,k)) <=>
         (rrOK(c,vZero(s),bxAdd(d,k),rrNegative) /\ rrOK(c,vOne(s),bxAdd(d,k),rrNegative)))
          %(bx_negative_children)% %implied
    . bxExact(d) => (bxPositive(c,s,vS(d),k,a) <=> rrOK(c,s,bxAdd(vS(d),k),rrModel(a)))
          %(bx_positive_successor)% %implied
    . bxExact(d) => (bxNegative(c,s,vS(d),k) <=> rrOK(c,s,bxAdd(vS(d),k),rrNegative))
          %(bx_negative_successor)% %implied
    . bxExact(d) => bxExact(vS(d)) %(bx_cut_step)% %implied
    . bxExact(d) %(bx_cut_all)% %implied
    
    . not (bxPositive(c,vZero(s),d,k,a) /\ bxPositive(c,vOne(s),d,k,a))
          %(bx_positive_cut_unique_branch)% %implied

    . (bxAdd(d,k) = vWidth(c)) =>
        (bxPositive(c,vNil,d,k,a) <=> vModel(c,a)) %(bx_cut_original_model)% %implied
    . (bxAdd(d,k) = vWidth(c)) =>
        (bxNegative(c,vNil,d,k) <=> vRefuted(c)) %(bx_cut_original_refutation)% %implied
  forall c : VInput; a : VWord . vZero(a) = vFallback(c) => false %(bx_model_fallback_disjoint)% %implied
  forall c : VInput; a : VWord . (vShortest(c,vZero(a)) <=> vModel(c,a)) %(bx_shortest_word_decodes)% %implied
  forall c : VInput; d,k : VNat; p,a : VWord
    . bxAdd(d,k) = vWidth(c) =>
        (vShortest(c,vZero(a)) <=> bxPositive(c,vNil,d,k,a))
          %(bx_cut_every_shortest_model)% %implied
    . bxAdd(d,k) = vWidth(c) =>
        (vShortest(c,vFallback(c)) <=> bxNegative(c,vNil,d,k))
          %(bx_cut_shortest_fallback)% %implied
    . bxAdd(d,k) = vWidth(c) =>
        (vShortest(c,p) <=>
          ((exists b : VWord . p = vZero(b) /\ bxPositive(c,vNil,d,k,b)) \/
           (p = vFallback(c) /\ bxNegative(c,vNil,d,k))))
          %(bx_cut_every_shortest_proof)% %implied
end

%% Attaching the two-sided cut proof to the actual sparse matrix read.
spec OriginalCutMatrix = OriginalCutExactness and NativeRootMatrix and OriginalClauseCover then
  op bxRead : VInput * VWord * VNat * VNat -> FRails
  pred bxReadExact : VNat
  forall c : VInput; s : VWord; d,k : VNat
    . bxRead(c,s,vZ,k) = rrTag(rrFold(c,s,k)) %(bx_read_at_cut)%
    . bxRead(c,s,vS(d),k) =
        readSplit(bxRead(c,vZero(s),d,k),bxRead(c,vOne(s),d,k)) %(bx_read_recompose)%
    . bxReadExact(d) <=>
        (forall f : VInput; t : VWord; n : VNat .
          bxRead(f,t,d,n) = rrTag(rrFold(f,t,bxAdd(d,n)))) %(bx_read_invariant)%
  . (bxReadExact(vZ) /\ (forall d : VNat . bxReadExact(d) => bxReadExact(vS(d))))
      => (forall d : VNat . bxReadExact(d)) %(bx_free_matrix_induction)%
  . not fzero = fone %(bx_rail_bits_distinct)%
  forall p,n,q,m : FBit
    . rails(p,n) = rails(q,m) => p = q /\ n = m %(bx_rail_injective)%
  forall c : VInput; s,a : VWord; d,k : VNat; h : RReceipt
    . bxReadExact(vZ) %(bx_read_base)% %implied
    . bxReadExact(d) => bxRead(c,s,d,k) = rrTag(rrFold(c,s,bxAdd(d,k))) %(bx_read_at_mark)% %implied
    . bxReadExact(d) => bxRead(c,s,vS(d),k) = rrTag(rrFold(c,s,bxAdd(vS(d),k)))
          %(bx_read_successor)% %implied
    . bxReadExact(d) => bxReadExact(vS(d)) %(bx_read_step)% %implied
    . bxReadExact(d) %(bx_read_all)% %implied
    . bxRead(c,s,d,k) = rrTag(rrFold(c,s,bxAdd(d,k))) %(bx_read_cut_invariance)% %implied
    . rrOK(c,s,k,rrFold(c,s,k)) %(bx_checked_fold)% %implied
    . not (rrOK(c,s,k,rrModel(a)) /\ rrOK(c,s,k,rrNegative)) %(bx_checked_rails_exclusive)% %implied
    . rrTag(h) = rails(fzero,fone) <=> h = rrNegative %(bx_negative_tag_reflection)% %implied
    . rrTag(h) = rails(fone,fzero) <=> (exists b : VWord . h = rrModel(b))
          %(bx_positive_tag_reflection)% %implied
    . (exists b : VWord . rrOK(c,s,k,rrModel(b))) => not rrOK(c,s,k,rrNegative)
          %(bx_some_model_excludes_negative)% %implied
    . rrOK(c,s,k,rrNegative) <=> rrFold(c,s,k) = rrNegative
          %(bx_checked_negative_fold)% %implied
    . (exists b : VWord . rrOK(c,s,k,rrModel(b))) <=>
        (exists b : VWord . rrFold(c,s,k) = rrModel(b)) %(bx_checked_positive_fold)% %implied
    . (exists b : VWord . bxPositive(c,s,d,k,b)) <=>
        (exists b : VWord . rrOK(c,s,bxAdd(d,k),rrModel(b))) %(bx_positive_existence_on_cut)% %implied
    . bxRead(c,s,d,k) = rails(fone,fzero) <=> (exists b : VWord . bxPositive(c,s,d,k,b))
          %(bx_tesseract_positive_iff_cut_witness)% %implied
    . bxRead(c,s,d,k) = rails(fzero,fone) <=> bxNegative(c,s,d,k)
          %(bx_tesseract_negative_iff_cut_cover)% %implied
    . bxAdd(d,k) = vWidth(c) =>
        (bxNegative(c,vNil,d,k) <=> (forall w : VWord . vLen(w) = vWidth(c) =>
            ocFails(vFormula(c),w,ocScan(vFormula(c),w))))
          %(bx_cut_returns_original_failed_occurrences)% %implied
end


%% Every finite acyclic binary proof graph has a finite unfolding from its root.
%% Repeated occurrences of a shared terminal keep a single key and observation.
%% A checked whole-cylinder shortcut may be a terminal in this unfolding.
spec SharedProofFrontier = NativeTileProof then
  sorts GFKey, GFView
  free type GFExpr ::= gfLeaf(GFKey) | gfSplit(GFExpr; GFExpr)
  op gfObserve : GFView * GFKey -> FRails
  op gfFold : GFView * GFExpr -> FRails
  ops gfPos, gfNeg : FRails -> FBit
  preds gfAt : GFExpr * GFKey;
        gfHasPositive, gfHasNegative, gfUnknown : GFView * GFExpr;
        gfAny, gfAll : GFView * GFExpr;
        gfExact : GFExpr

  forall e : GFExpr; x,y : FBit
    . gfPos(rails(x,y)) = x %(gf_positive_corner)%
    . gfNeg(rails(x,y)) = y %(gf_negative_corner)%
  forall r : FRails . exists p,n : FBit . r = rails(p,n) %(gf_rail_cases)%
  . not fone = fzero %(gf_bit_distinct)%

  forall v : GFView; l,r : GFExpr; k,j : GFKey
    . gfAt(gfLeaf(k),j) <=> k = j %(gf_leaf_key)%
    . gfAt(gfSplit(l,r),k) <=> gfAt(l,k) \/ gfAt(r,k) %(gf_split_union)%
    . gfFold(v,gfLeaf(k)) = gfObserve(v,k) %(gf_fold_leaf)%
    . gfFold(v,gfSplit(l,r)) = readSplit(gfFold(v,l),gfFold(v,r)) %(gf_fold_split)%
    . gfHasPositive(v,l) <=> gfPos(gfFold(v,l)) = fone %(gf_matrix_positive)%
    . gfHasNegative(v,l) <=> gfNeg(gfFold(v,l)) = fone %(gf_matrix_negative)%
    . gfUnknown(v,l) <=> gfFold(v,l) = rails(fzero,fzero) %(gf_matrix_unknown)%
    . gfAny(v,l) <=> (exists j : GFKey . gfAt(l,j) /\ gfPos(gfObserve(v,j)) = fone)
          %(gf_exists_terminal)%
    . gfAll(v,l) <=> (forall j : GFKey . gfAt(l,j) => gfNeg(gfObserve(v,j)) = fone)
          %(gf_forall_terminals)%
  forall e : GFExpr
    . gfExact(e) <=> (forall v : GFView . (gfHasPositive(v,e) <=> gfAny(v,e)) /\
                                         (gfHasNegative(v,e) <=> gfAll(v,e))) %(gf_invariant)%
  %% This guard is the instance of structural induction for the free GFExpr
  %% datatype. The replay proves gf_exact_base and gf_exact_step first.
  . ((forall k : GFKey . gfExact(gfLeaf(k))) /\
     (forall l,r : GFExpr . gfExact(l) /\ gfExact(r) => gfExact(gfSplit(l,r)))) =>
      (forall t : GFExpr . gfExact(t)) %(gf_free_expression_induction)%

  forall u,v : FRails; p,n,q,m : FBit
    . fjoin(p,q) = fone <=> p = fone \/ q = fone %(gf_or_exact)% %implied
    . fmul(n,m) = fone <=> n = fone /\ m = fone %(gf_and_exact)% %implied
    . gfPos(readSplit(rails(p,n),rails(q,m))) = fjoin(p,q) %(gf_corner_or)% %implied
    . gfNeg(readSplit(rails(p,n),rails(q,m))) = fmul(n,m) %(gf_corner_and)% %implied
    . rails(gfPos(u),gfNeg(u)) = u %(gf_rails_roundtrip)% %implied
    . gfPos(readSplit(u,v)) = fjoin(gfPos(u),gfPos(v)) %(gf_any_corner_or)% %implied
    . gfNeg(readSplit(u,v)) = fmul(gfNeg(u),gfNeg(v)) %(gf_any_corner_and)% %implied

  forall v : GFView; e,l,r : GFExpr; k : GFKey
    . gfAny(v,gfLeaf(k)) <=> gfPos(gfObserve(v,k)) = fone %(gf_positive_support_leaf)% %implied
    . gfAll(v,gfLeaf(k)) <=> gfNeg(gfObserve(v,k)) = fone %(gf_negative_support_leaf)% %implied
    . gfAny(v,gfSplit(l,r)) <=> gfAny(v,l) \/ gfAny(v,r) %(gf_positive_support_split)% %implied
    . gfAll(v,gfSplit(l,r)) <=> gfAll(v,l) /\ gfAll(v,r) %(gf_negative_support_split)% %implied
    . gfHasPositive(v,gfSplit(l,r)) <=> gfHasPositive(v,l) \/ gfHasPositive(v,r)
          %(gf_positive_matrix_split)% %implied
    . gfHasNegative(v,gfSplit(l,r)) <=> gfHasNegative(v,l) /\ gfHasNegative(v,r)
          %(gf_negative_matrix_split)% %implied
    . gfHasPositive(v,gfLeaf(k)) <=> gfAny(v,gfLeaf(k)) %(gf_positive_base_at_view)% %implied
    . gfHasNegative(v,gfLeaf(k)) <=> gfAll(v,gfLeaf(k)) %(gf_negative_base_at_view)% %implied
    . gfExact(gfLeaf(k)) %(gf_exact_base)% %implied
    . gfExact(e) => (gfHasPositive(v,e) <=> gfAny(v,e)) %(gf_positive_at_view)% %implied
    . gfExact(e) => (gfHasNegative(v,e) <=> gfAll(v,e)) %(gf_negative_at_view)% %implied
    . gfExact(l) /\ gfExact(r) => (gfHasPositive(v,gfSplit(l,r)) <=> gfAny(v,gfSplit(l,r)))
          %(gf_positive_step_at_view)% %implied
    . gfExact(l) /\ gfExact(r) => (gfHasNegative(v,gfSplit(l,r)) <=> gfAll(v,gfSplit(l,r)))
          %(gf_negative_step_at_view)% %implied
    . gfExact(l) /\ gfExact(r) => gfExact(gfSplit(l,r)) %(gf_exact_step)% %implied
    . gfExact(e) %(gf_exact_all)% %implied
    . gfHasPositive(v,e) <=> (exists j : GFKey . gfAt(e,j) /\ gfPos(gfObserve(v,j)) = fone)
          %(gf_positive_iff_checked_terminal)% %implied
    . gfHasNegative(v,e) <=> (forall j : GFKey . gfAt(e,j) => gfNeg(gfObserve(v,j)) = fone)
          %(gf_negative_iff_all_checked_terminals)% %implied
    . gfUnknown(v,e) <=> not gfHasPositive(v,e) /\ not gfHasNegative(v,e)
          %(gf_unknown_iff_missing_rails)% %implied
    . gfUnknown(v,e) <=> (not gfAny(v,e)) /\
         (exists j : GFKey . gfAt(e,j) /\ not gfNeg(gfObserve(v,j)) = fone)
          %(gf_unknown_iff_frontier_evidence)% %implied
    . gfAt(gfSplit(l,l),k) <=> gfAt(l,k) %(gf_shared_branch_same_keys)% %implied
  forall p,n : FBit
    . fjoin(p,p) = p /\ fmul(n,n) = n %(gf_join_meet_idempotent)% %implied
  forall v : GFView; l : GFExpr
    . gfFold(v,gfSplit(l,l)) = gfFold(v,l) %(gf_shared_branch_same_read)% %implied
end

%% A mask records queried addresses. The labels at those addresses are the
%% outputs of the original CNF's own model check. A world here is a Boolean
%% labelling of addresses: a completion is any such labelling that agrees with
%% the mask. Interpret BCWorld as sets of words, and bcValue as membership.
%% The two completions below construct the observed winner set and the complement
%% of the observed failure set. The bounds concern information in these labels.
spec ObservationCut = NativeRoot then
  sorts BCWorld, BMask
  ops bcLower, bcUpper : VInput * BMask -> BCWorld;
      bcSource : VInput -> BCWorld;
      bcEmpty, bcAll : BMask;
      bcOnly : VWord -> BMask
  preds bcSeen : BMask * VWord;
        bcValue : BCWorld * VWord;
        bcCompatible : VInput * BMask * BCWorld;
        bcSome : BCWorld * VWord * VNat;
        bcHit, bcCovered, bcSureSat, bcSureUnsat : VInput * BMask * VWord * VNat

  forall c : VInput; m : BMask; w : BCWorld; s,a,b : VWord; k : VNat
    . bcValue(bcLower(c,m),a) <=> bcSeen(m,a) /\ vModel(c,a) %(bc_lower_def)%
    . bcValue(bcUpper(c,m),a) <=> (bcSeen(m,a) => vModel(c,a)) %(bc_upper_def)%
    . bcValue(bcSource(c),a) <=> vModel(c,a) %(bc_source_def)%
    . not bcSeen(bcEmpty,a) %(bc_empty_mask)%
    . bcSeen(bcAll,a) %(bc_all_mask)%
    . bcSeen(bcOnly(b),a) <=> a = b %(bc_singleton_mask)%
    . bcCompatible(c,m,w) <=> (forall x : VWord . bcSeen(m,x) =>
                                       (bcValue(w,x) <=> vModel(c,x))) %(bc_compatible_def)%
    . bcSome(w,s,k) <=> (exists x : VWord . rrIn(s,k,x) /\ bcValue(w,x)) %(bc_some_def)%
    . bcHit(c,m,s,k) <=> (exists x : VWord . rrIn(s,k,x) /\ bcSeen(m,x) /\
                                                                vModel(c,x)) %(bc_hit_def)%
    . bcCovered(c,m,s,k) <=> (forall x : VWord . rrIn(s,k,x) =>
                                           bcSeen(m,x) /\ not vModel(c,x)) %(bc_covered_def)%
    . bcSureSat(c,m,s,k) <=> (forall u : BCWorld . bcCompatible(c,m,u) =>
                                                                 bcSome(u,s,k)) %(bc_satsure_def)%
    . bcSureUnsat(c,m,s,k) <=> (forall u : BCWorld . bcCompatible(c,m,u) =>
                                                             not bcSome(u,s,k)) %(bc_unsatsure_def)%

    . bcCompatible(c,m,bcSource(c)) %(bc_original_compatible)% %implied
    . bcCompatible(c,m,bcLower(c,m)) %(bc_lower_compatible)% %implied
    . bcCompatible(c,m,bcUpper(c,m)) %(bc_upper_compatible)% %implied

    . bcCompatible(c,m,w) /\ bcSeen(m,a) =>
                              (bcValue(w,a) <=> vModel(c,a)) %(bc_observed_value)% %implied
    . bcCompatible(c,m,w) /\ bcValue(bcLower(c,m),a) => bcValue(w,a)
          %(bc_lower_pointwise)% %implied
    . bcCompatible(c,m,w) /\ bcValue(w,a) => bcValue(bcUpper(c,m),a)
          %(bc_upper_pointwise)% %implied
    . bcCompatible(c,m,w) /\ bcSome(bcLower(c,m),s,k) => bcSome(w,s,k)
          %(bc_lower_fibre)% %implied
    . bcCompatible(c,m,w) /\ bcSome(w,s,k) => bcSome(bcUpper(c,m),s,k)
          %(bc_upper_fibre)% %implied
    . bcSome(bcLower(c,m),s,k) <=> bcHit(c,m,s,k) %(bc_hit_exact)% %implied
    . not bcSome(bcUpper(c,m),s,k) <=> bcCovered(c,m,s,k) %(bc_cover_exact)% %implied

    . bcSureSat(c,m,s,k) => bcSome(bcLower(c,m),s,k) %(bc_sat_requires_lower)% %implied
    . bcSome(bcLower(c,m),s,k) => bcSureSat(c,m,s,k) %(bc_sat_from_lower)% %implied
    . bcSureUnsat(c,m,s,k) => not bcSome(bcUpper(c,m),s,k)
          %(bc_unsat_requires_upper)% %implied
    . not bcSome(bcUpper(c,m),s,k) => bcSureUnsat(c,m,s,k)
          %(bc_unsat_from_upper)% %implied
    . bcSureSat(c,m,s,k) <=> bcHit(c,m,s,k) %(bc_sat_iff_hit)% %implied
    . bcSureUnsat(c,m,s,k) <=> bcCovered(c,m,s,k) %(bc_unsat_iff_cover)% %implied

    %% One queried model is sufficient, and zero queries yield no positive.
    . not bcSureSat(c,bcEmpty,s,k) %(bc_zero_cannot_prove_sat)% %implied
    . rrIn(s,k,a) /\ vModel(c,a) => bcSureSat(c,bcOnly(a),s,k)
          %(bc_one_proves_sat)% %implied
    %% Missing a single address is already a certificate of observational doubt.
    . rrIn(s,k,a) /\ not bcSeen(m,a) => bcSome(bcUpper(c,m),s,k)
          %(bc_unobserved_admits_sat)% %implied
    . not bcHit(c,m,s,k) /\ rrIn(s,k,a) /\ not bcSeen(m,a) =>
          not bcSome(bcLower(c,m),s,k) /\ bcSome(bcUpper(c,m),s,k)
          %(bc_both_completions_when_unresolved)% %implied
    . bcSureUnsat(c,m,s,k) /\ rrIn(s,k,a) => bcSeen(m,a) /\ not vModel(c,a)
          %(bc_every_failure_needed)% %implied
    . (forall x : VWord . rrIn(s,k,x) => not vModel(c,x)) =>
          bcSureUnsat(c,bcAll,s,k) %(bc_all_failures_suffice)% %implied
    . bcHit(c,m,s,vZ) <=>
        bcSeen(m,rrGraft(s,vNil)) /\ vModel(c,rrGraft(s,vNil)) %(bc_hit_leaf_exact)% %implied
    . bcCovered(c,m,s,vZ) <=>
        bcSeen(m,rrGraft(s,vNil)) /\ not vModel(c,rrGraft(s,vNil)) %(bc_cover_leaf_exact)% %implied

    %% The two polarities have opposite split constructors.
    . bcHit(c,m,vZero(s),k) => bcHit(c,m,s,vS(k)) %(bc_hit_lift_zero)% %implied
    . bcHit(c,m,vOne(s),k) => bcHit(c,m,s,vS(k)) %(bc_hit_lift_one)% %implied
    . bcHit(c,m,s,vS(k)) => bcHit(c,m,vZero(s),k) \/ bcHit(c,m,vOne(s),k)
          %(bc_hit_restrict)% %implied
    . bcHit(c,m,s,vS(k)) <=> bcHit(c,m,vZero(s),k) \/ bcHit(c,m,vOne(s),k)
          %(bc_hit_split_exact)% %implied
    . bcCovered(c,m,s,vS(k)) <=> bcCovered(c,m,vZero(s),k) /\ bcCovered(c,m,vOne(s),k)
          %(bc_cover_split_exact)% %implied
end

%% Exact counts for the displayed split constructors. Depth d ends at a
%% frontier whose receipts are supplied. These counts are in units of one
%% terminal receipt, one edge lift or one binary join.
spec ExplicitCutWork = OriginalCutExactness then
  ops bxPowTwo, bxPositiveReads, bxPositiveLifts, bxNegativeReads, bxNegativeJoins : VNat -> VNat
  preds bxArithmetic : VNat; bxWorkLaw : VNat
  forall d,k : VNat
    . bxPowTwo(vZ) = vS(vZ) %(bw_pow_zero)%
    . bxPowTwo(vS(d)) = bxAdd(bxPowTwo(d),bxPowTwo(d)) %(bw_pow_step)%
    . bxPositiveReads(vZ) = vS(vZ) %(bw_positive_reads_zero)%
    . bxPositiveReads(vS(d)) = bxPositiveReads(d) %(bw_positive_reads_step)%
    . bxPositiveLifts(vZ) = vZ %(bw_positive_lifts_zero)%
    . bxPositiveLifts(vS(d)) = vS(bxPositiveLifts(d)) %(bw_positive_lifts_step)%
    . bxNegativeReads(vZ) = vS(vZ) %(bw_negative_reads_zero)%
    . bxNegativeReads(vS(d)) = bxAdd(bxNegativeReads(d),bxNegativeReads(d)) %(bw_negative_reads_step)%
    . bxNegativeJoins(vZ) = vZ %(bw_negative_joins_zero)%
    . bxNegativeJoins(vS(d)) = vS(bxAdd(bxNegativeJoins(d),bxNegativeJoins(d))) %(bw_negative_joins_step)%
    . bxArithmetic(d) <=> (forall j : VNat . bxAdd(d,vS(j)) = vS(bxAdd(d,j))) %(bw_arith_def)%
    . bxWorkLaw(d) <=> bxPositiveReads(d) = vS(vZ) /\ bxPositiveLifts(d) = d /\
          bxNegativeReads(d) = bxPowTwo(d) /\ vS(bxNegativeJoins(d)) = bxNegativeReads(d)
          %(bw_work_def)%
  . (bxArithmetic(vZ) /\ (forall j : VNat . bxArithmetic(j) => bxArithmetic(vS(j))))
        => (forall j : VNat . bxArithmetic(j)) %(bw_free_arith_induction)%
  . (bxWorkLaw(vZ) /\ (forall j : VNat . bxWorkLaw(j) => bxWorkLaw(vS(j))))
        => (forall j : VNat . bxWorkLaw(j)) %(bw_free_work_induction)%
  forall d,k : VNat
    . bxArithmetic(vZ) %(bw_arith_base)% %implied
    . bxArithmetic(d) => bxAdd(d,vS(k)) = vS(bxAdd(d,k)) %(bw_arith_at)% %implied
    . bxArithmetic(d) => bxAdd(vS(d),vS(k)) = vS(bxAdd(vS(d),k)) %(bw_arith_succ_at)% %implied
    . bxArithmetic(d) => bxArithmetic(vS(d)) %(bw_arith_step)% %implied
    . bxArithmetic(d) %(bw_arith_all)% %implied
    . bxAdd(vS(d),vS(k)) = vS(vS(bxAdd(d,k))) %(bw_two_successors)% %implied
    . bxWorkLaw(vZ) %(bw_work_base)% %implied
    . bxWorkLaw(d) => bxPositiveReads(vS(d)) = vS(vZ) %(bw_positive_read_step)% %implied
    . bxWorkLaw(d) => bxPositiveLifts(vS(d)) = vS(d) %(bw_positive_lift_step)% %implied
    . bxWorkLaw(d) => bxNegativeReads(vS(d)) = bxPowTwo(vS(d)) %(bw_negative_read_step)% %implied
    . bxWorkLaw(d) => vS(bxNegativeJoins(vS(d))) = bxNegativeReads(vS(d))
          %(bw_negative_join_step)% %implied
    . bxWorkLaw(d) => bxWorkLaw(vS(d)) %(bw_work_step)% %implied
    . bxWorkLaw(d) %(bw_work_all)% %implied
    . bxPositiveReads(d) = vS(vZ) /\ bxPositiveLifts(d) = d %(bw_one_terminal_and_d_lifts)% %implied
    . bxNegativeReads(d) = bxPowTwo(d) /\ vS(bxNegativeJoins(d)) = bxPowTwo(d)
          %(bw_full_cover_has_2_pow_d_terminals_and_one_less_join)% %implied
end

%% Partial observations evaluate by the same native 4-by-4 matrix product.
%% A sleeping leaf records no evidence. The selected assignment is tested
%% against the original formula, so the two rails cannot conflict.
spec ObservedCutMatrix = ObservationCut and NativeTileProof then
  ops bmPos, bmNeg : FRails -> FBit;
      bmLeaf : VInput * BMask * VWord -> FRails;
      bmRead : VInput * BMask * VWord * VNat -> FRails
  preds bmSatCompletion, bmUnsatCompletion : VInput * BMask * VWord * VNat;
        bmDepthLaw : VNat

  . not fzero = fone %(bm_bits_distinct)%
  forall r : FRails . exists p,n : FBit . r = rails(p,n) %(bm_rails_cases)%
  forall p,n : FBit
    . bmPos(rails(p,n)) = p %(bm_pos_def)%
    . bmNeg(rails(p,n)) = n %(bm_neg_def)%
  forall c : VInput; m : BMask; s : VWord; k : VNat
    . bcSeen(m,rrGraft(s,vNil)) /\ vModel(c,rrGraft(s,vNil)) =>
          bmLeaf(c,m,s) = rails(fone,fzero) %(bm_hit_leaf_def)%
    . bcSeen(m,rrGraft(s,vNil)) /\ not vModel(c,rrGraft(s,vNil)) =>
          bmLeaf(c,m,s) = rails(fzero,fone) %(bm_miss_leaf_def)%
    . not bcSeen(m,rrGraft(s,vNil)) =>
          bmLeaf(c,m,s) = rails(fzero,fzero) %(bm_sleep_leaf_def)%
    . bmRead(c,m,s,vZ) = bmLeaf(c,m,s) %(bm_read_leaf_def)%
    . bmRead(c,m,s,vS(k)) = readSplit(bmRead(c,m,vZero(s),k),bmRead(c,m,vOne(s),k))
          %(bm_read_split_def)%
    . bmSatCompletion(c,m,s,k) <=> (exists u : BCWorld . bcCompatible(c,m,u) /\ bcSome(u,s,k))
          %(bm_sat_completion_def)%
    . bmUnsatCompletion(c,m,s,k) <=> (exists u : BCWorld . bcCompatible(c,m,u) /\ not bcSome(u,s,k))
          %(bm_unsat_completion_def)%
  forall k : VNat
    . bmDepthLaw(k) <=> (forall c : VInput; m : BMask; s : VWord .
         (bmPos(bmRead(c,m,s,k)) = fone <=> bcHit(c,m,s,k)) /\
         (bmNeg(bmRead(c,m,s,k)) = fone <=> bcCovered(c,m,s,k))) %(bm_depth_law_def)%
  %% This is the indicated instance of structural induction for VNat.
  . (bmDepthLaw(vZ) /\ (forall k : VNat . bmDepthLaw(k) => bmDepthLaw(vS(k))))
       => (forall k : VNat . bmDepthLaw(k)) %(bm_free_depth_induction)%

  forall p,q : FBit; l,r : FRails
    . l = rails(bmPos(l),bmNeg(l)) %(bm_rails_reconstruct)% %implied
    . bmPos(readSplit(l,r)) = fjoin(bmPos(l),bmPos(r)) %(bm_pos_split)% %implied
    . bmNeg(readSplit(l,r)) = fmul(bmNeg(l),bmNeg(r)) %(bm_neg_split)% %implied
    . fjoin(p,q) = fone <=> p = fone \/ q = fone %(bm_join_exact)% %implied
    . fmul(p,q) = fone <=> p = fone /\ q = fone %(bm_meet_exact)% %implied
    . p = fzero <=> not p = fone %(bm_zero_exact)% %implied
    . l = rails(fzero,fzero) <=> bmPos(l) = fzero /\ bmNeg(l) = fzero
          %(bm_zero_rails_exact)% %implied

  forall c : VInput; m : BMask; s : VWord; k : VNat
    . bmPos(bmLeaf(c,m,s)) = fone <=> bcHit(c,m,s,vZ) %(bm_leaf_pos_exact)% %implied
    . bmNeg(bmLeaf(c,m,s)) = fone <=> bcCovered(c,m,s,vZ) %(bm_leaf_neg_exact)% %implied
    . bmPos(bmRead(c,m,s,vZ)) = fone <=> bcHit(c,m,s,vZ) %(bm_read_base_pos)% %implied
    . bmNeg(bmRead(c,m,s,vZ)) = fone <=> bcCovered(c,m,s,vZ) %(bm_read_base_neg)% %implied
    . bmDepthLaw(vZ) %(bm_induction_base)% %implied

    . bmDepthLaw(k) => (bmPos(bmRead(c,m,s,k)) = fone <=> bcHit(c,m,s,k))
          %(bm_pos_at_depth)% %implied
    . bmDepthLaw(k) => (bmNeg(bmRead(c,m,s,k)) = fone <=> bcCovered(c,m,s,k))
          %(bm_neg_at_depth)% %implied
    . (bmPos(bmRead(c,m,s,vS(k))) = fone) <=>
          (bmPos(bmRead(c,m,vZero(s),k)) = fone \/ bmPos(bmRead(c,m,vOne(s),k)) = fone)
          %(bm_read_split_pos_bits)% %implied
    . (bmNeg(bmRead(c,m,s,vS(k))) = fone) <=>
          (bmNeg(bmRead(c,m,vZero(s),k)) = fone /\ bmNeg(bmRead(c,m,vOne(s),k)) = fone)
          %(bm_read_split_neg_bits)% %implied
    . bmDepthLaw(k) => (bmPos(bmRead(c,m,s,vS(k))) = fone <=> bcHit(c,m,s,vS(k)))
          %(bm_successor_pos_exact)% %implied
    . bmDepthLaw(k) => (bmNeg(bmRead(c,m,s,vS(k))) = fone <=> bcCovered(c,m,s,vS(k)))
          %(bm_successor_neg_exact)% %implied
    . bmDepthLaw(k) => bmDepthLaw(vS(k)) %(bm_induction_step)% %implied
    . bmDepthLaw(k) %(bm_all_depths)% %implied
    . bmPos(bmRead(c,m,s,k)) = fone <=> bcSureSat(c,m,s,k) %(bm_pos_iff_sure_sat)% %implied
    . bmNeg(bmRead(c,m,s,k)) = fone <=> bcSureUnsat(c,m,s,k) %(bm_neg_iff_sure_unsat)% %implied
    . not (bcSureSat(c,m,s,k) /\ bcSureUnsat(c,m,s,k)) %(bm_exclude_conflicting_proofs)% %implied
    . not bmRead(c,m,s,k) = rails(fone,fone) %(bm_both_impossible)% %implied
    . bmPos(bmRead(c,m,s,k)) = fzero <=> not bcSureSat(c,m,s,k) %(bm_pos_zero_exact)% %implied
    . bmNeg(bmRead(c,m,s,k)) = fzero <=> not bcSureUnsat(c,m,s,k) %(bm_neg_zero_exact)% %implied
    . bmRead(c,m,s,k) = rails(fzero,fzero) <=>
          (not bcSureSat(c,m,s,k) /\ not bcSureUnsat(c,m,s,k)) %(bm_unknown_exact)% %implied
    . bcSome(bcUpper(c,m),s,k) => bmSatCompletion(c,m,s,k) %(bm_upper_makes_sat)% %implied
    . not bcSome(bcLower(c,m),s,k) => bmUnsatCompletion(c,m,s,k) %(bm_lower_makes_unsat)% %implied
    . bmSatCompletion(c,m,s,k) <=> not bcSureUnsat(c,m,s,k)
          %(bm_possible_sat_exact)% %implied
    . bmUnsatCompletion(c,m,s,k) <=> not bcSureSat(c,m,s,k)
          %(bm_possible_unsat_exact)% %implied
    . bmRead(c,m,s,k) = rails(fzero,fzero) <=>
          bmSatCompletion(c,m,s,k) /\ bmUnsatCompletion(c,m,s,k)
          %(bm_neither_iff_distinguishing_completions)% %implied
end


%% At a point (address,higher), a q-simplex is a list of q+1 failed original
%% clause occurrences. The empty list is the augmented degree -1 simplex.
%% Deletion and duplication beyond a list's length leave the list unchanged;
%% simplicial operators use only the indices in their domain.
spec OriginalCechFibre = OriginalClauseCover then
  sorts CEAddress, CEHigher
  free type CEPoint ::= cePoint(ceAddress : CEAddress; ceHigher : CEHigher)
  free type CEList ::= ceEmpty | ceCons(VNat; CEList)
  ops cePrefix : CEAddress * VNat -> VWord;
      ceExtend : VWord -> CEAddress;
      ceHigherBase : CEHigher;
      ceWord : VInput * CEPoint -> VWord;
      ceLeast : VInput * CEPoint -> VNat;
      ceLength : CEList -> VNat;
      ceDelete, ceDuplicate : VNat * CEList -> CEList;
      ceExtra : VInput * CEPoint * CEList -> CEList
  preds ceFails : VInput * CEPoint * VNat;
        ceValid : VInput * CEPoint * CEList;
        ceTotal : VInput;
        ceIndexLaw : VNat;
        ceFailureLaw : VFormula

  %% These two coordinate laws hold on the full address space, with ceExtend
  %% defined by appending zeroes. No horizon is part of the choice of CEAddress.
  forall b : CEAddress; n : VNat; w : VWord
    . vLen(cePrefix(b,n)) = n %(ce_prefix_width)%
    . cePrefix(ceExtend(w),vLen(w)) = w %(ce_zero_extension)%
  forall b : CEAddress; h : CEHigher
    . ceAddress(cePoint(b,h)) = b %(ce_address_projection)%
  forall c : VInput; x : CEPoint; j : VNat
    . ceWord(c,x) = cePrefix(ceAddress(x),vWidth(c)) %(ce_word_def)%
    . ceLeast(c,x) = ocScan(vFormula(c),ceWord(c,x)) %(ce_least_def)%
    . ceFails(c,x,j) <=> ocFails(vFormula(c),ceWord(c,x),j) %(ce_fails_def)%
    . ceTotal(c) <=> (forall y : CEPoint . ceValid(c,y,ceExtra(c,y,ceEmpty)))
        %(ce_total_def)%
  forall c : VInput; x : CEPoint; j,i : VNat; l : CEList
    . ceLength(ceEmpty) = vZ %(ce_empty_length)%
    . ceLength(ceCons(j,l)) = vS(ceLength(l)) %(ce_cons_length)%
    . ceDelete(i,ceEmpty) = ceEmpty %(ce_delete_empty)%
    . ceDelete(vZ,ceCons(j,l)) = l %(ce_delete_head)%
    . ceDelete(vS(i),ceCons(j,l)) = ceCons(j,ceDelete(i,l)) %(ce_delete_tail)%
    . ceDuplicate(i,ceEmpty) = ceEmpty %(ce_duplicate_empty)%
    . ceDuplicate(vZ,ceCons(j,l)) = ceCons(j,ceCons(j,l)) %(ce_duplicate_head)%
    . ceDuplicate(vS(i),ceCons(j,l)) = ceCons(j,ceDuplicate(i,l)) %(ce_duplicate_tail)%
    . ceExtra(c,x,l) = ceCons(ceLeast(c,x),l) %(ce_extra_def)%
    . ceValid(c,x,ceEmpty) %(ce_empty_valid)%
    . ceValid(c,x,ceCons(j,l)) <=> ceFails(c,x,j) /\ ceValid(c,x,l) %(ce_cons_valid)%
  forall l : CEList
    . l = ceEmpty \/ (exists j : VNat; k : CEList . l = ceCons(j,k)) %(ce_list_cases)%
  forall i : VNat
    . ceIndexLaw(i) <=> (forall c : VInput; x : CEPoint; l : CEList .
          ceValid(c,x,l) => ceValid(c,x,ceDelete(i,l)) /\ ceValid(c,x,ceDuplicate(i,l)))
        %(ce_index_invariant)%
  %% This instance of induction holds in the free Peano datatype VNat.
  . (ceIndexLaw(vZ) /\ (forall i : VNat . ceIndexLaw(i) => ceIndexLaw(vS(i))))
        => (forall i : VNat . ceIndexLaw(i)) %(ce_free_index_induction)%

  forall f : VFormula
    . ceFailureLaw(f) <=>
        (forall a : VWord; j : VNat . ocFails(f,a,j) => not vFormulaTrue(f,a))
        %(ce_failure_invariant)%
  forall j : VNat . j = vZ \/ (exists i : VNat . j = vS(i)) %(ce_nat_cases)%
  . (ceFailureLaw(vEmptyFormula) /\
      (forall f : VFormula; d : VClause . ceFailureLaw(f) => ceFailureLaw(vClauseCons(d,f))))
      => (forall f : VFormula . ceFailureLaw(f)) %(ce_free_formula_induction)%

  forall f : VFormula; d : VClause; a : VWord; j : VNat
    . ceFailureLaw(vEmptyFormula) %(ce_failure_base)% %implied
    . ceFailureLaw(f) /\ ocFails(f,a,j) => not vFormulaTrue(f,a)
        %(ce_failure_law_at_index)% %implied
    . ocFails(vClauseCons(d,f),a,vZ) => not vFormulaTrue(vClauseCons(d,f),a)
        %(ce_failure_head)% %implied
    . ceFailureLaw(f) /\ ocFails(vClauseCons(d,f),a,vS(j)) =>
        not vFormulaTrue(vClauseCons(d,f),a) %(ce_failure_tail)% %implied
    . ceFailureLaw(f) /\ ocFails(vClauseCons(d,f),a,j) => not vFormulaTrue(vClauseCons(d,f),a)
        %(ce_failure_step_at_index)% %implied
    . ceFailureLaw(f) => ceFailureLaw(vClauseCons(d,f)) %(ce_failure_step)% %implied
    . ocFails(f,a,j) => not vFormulaTrue(f,a) %(ce_any_original_failure_refutes_word)% %implied

  forall c : VInput; x : CEPoint; j,i : VNat; l : CEList
    . ceLength(ceExtra(c,x,l)) = vS(ceLength(l)) %(ce_extra_degree)% %implied
    . ceDelete(vZ,ceExtra(c,x,l)) = l %(ce_extra_first_face)% %implied
    . ceDelete(vS(i),ceExtra(c,x,l)) = ceExtra(c,x,ceDelete(i,l))
        %(ce_extra_shifted_face)% %implied
    . ceDuplicate(vS(i),ceExtra(c,x,l)) = ceExtra(c,x,ceDuplicate(i,l))
        %(ce_extra_shifted_degeneracy)% %implied
    . ceDuplicate(vZ,ceExtra(c,x,l)) = ceExtra(c,x,ceExtra(c,x,l))
        %(ce_extra_first_degeneracy)% %implied

    . ceValid(c,x,ceCons(j,l)) => ceValid(c,x,ceDelete(vZ,ceCons(j,l))) /\
        ceValid(c,x,ceDuplicate(vZ,ceCons(j,l))) %(ce_face_degeneracy_base_cons)% %implied
    . ceValid(c,x,l) => ceValid(c,x,ceDelete(vZ,l)) /\ ceValid(c,x,ceDuplicate(vZ,l))
        %(ce_face_degeneracy_base_point)% %implied
    . ceIndexLaw(vZ) %(ce_face_degeneracy_base)% %implied
    . ceIndexLaw(i) /\ ceValid(c,x,l) => ceValid(c,x,ceDelete(i,l)) /\
        ceValid(c,x,ceDuplicate(i,l)) %(ce_face_degeneracy_at_index)% %implied
    . ceIndexLaw(i) /\ ceValid(c,x,ceCons(j,l)) =>
        ceValid(c,x,ceDelete(vS(i),ceCons(j,l))) /\ ceValid(c,x,ceDuplicate(vS(i),ceCons(j,l)))
        %(ce_face_degeneracy_step_cons)% %implied
    . ceIndexLaw(i) /\ ceValid(c,x,l) =>
        ceValid(c,x,ceDelete(vS(i),l)) /\ ceValid(c,x,ceDuplicate(vS(i),l))
        %(ce_face_degeneracy_step_point)% %implied
    . ceIndexLaw(i) => ceIndexLaw(vS(i)) %(ce_face_degeneracy_step)% %implied
    . ceIndexLaw(i) %(ce_face_degeneracy_all_indices)% %implied

    . vLen(ceWord(c,x)) = vWidth(c) %(ce_word_has_width)% %implied
    . ceFails(c,x,ceLeast(c,x)) <=> not vModel(c,ceWord(c,x))
        %(ce_least_fails_iff_original_word_fails)% %implied
    . ocEarlierTrue(vFormula(c),ceWord(c,x),ceLeast(c,x)) %(ce_earlier_occurrences_pass)% %implied
    . ceValid(c,x,ceExtra(c,x,l)) <=> ceFails(c,x,ceLeast(c,x)) /\ ceValid(c,x,l)
        %(ce_extra_preserves_validity_exactly)% %implied
    . ceValid(c,x,ceExtra(c,x,ceEmpty)) <=> not vModel(c,ceWord(c,x))
        %(ce_augmented_return_iff_original_word_fails)% %implied
    . vModel(c,ceWord(c,x)) => not ceFails(c,x,j) %(ce_model_rules_out_every_clause)% %implied
    . (exists i : VNat . ceFails(c,x,i)) <=> not vModel(c,ceWord(c,x))
        %(ce_nonempty_iff_original_word_fails)% %implied
    . vModel(c,ceWord(c,x)) => not ceValid(c,x,ceCons(j,l))
        %(ce_model_fibre_has_no_nonempty_simplices)% %implied

  forall c : VInput; a : VWord; b : CEAddress; h,k : CEHigher; j : VNat; l : CEList
    . vLen(a) = vWidth(c) =>
        ceWord(c,cePoint(ceExtend(a),ceHigherBase)) = a %(ce_extend_preserves_assignment)% %implied
    . ceWord(c,cePoint(b,h)) = ceWord(c,cePoint(b,k)) %(ce_word_invariant_over_higher_factor)% %implied
    . ceFails(c,cePoint(b,h),j) <=> ceFails(c,cePoint(b,k),j)
        %(ce_failed_occurrence_invariant_over_higher_factor)% %implied
    . ceExtra(c,cePoint(b,h),l) = ceExtra(c,cePoint(b,k),l)
        %(ce_extra_invariant_over_higher_factor)% %implied
    . vRefuted(c) => ceTotal(c) %(ce_refutation_makes_selected_total)% %implied
    . ceTotal(c) => not vModel(c,a) %(ce_selected_total_rules_out_assignment)% %implied
    . ceTotal(c) => vRefuted(c) %(ce_selected_total_refutes)% %implied
    . ceTotal(c) <=> vRefuted(c) %(ce_selected_total_iff_original_unsat)% %implied
end

%% Each output carries its actual original clause occurrence, or the model tag.
%% A view specifies allowed completions of the same address variables. Repeated
%% occurrences always evaluate against the very same completion a.
spec OriginalSelectorSlack = OriginalClauseCover then
  sort SLView
  free type SLResult ::= slModel | slFailed(VNat)
  op slResult : VInput * VWord -> SLResult
  preds slAllows : SLView * VWord;
        slPossible : VInput * SLView * SLResult;
        slTotal, slVariableRead : VInput * SLView;
        slForce : VInput * SLView * SLResult;
        slLeast : VFormula;
        slNonempty : VInput * SLView;
        slEveryEarlier, slEveryFail : VInput * SLView * VNat;
        slEveryTrue : VInput * SLView
  forall a : VWord; f : VFormula
    . slLeast(f) <=> (forall b : VWord; i : VNat .
           ocFails(f,b,i) /\ ocEarlierTrue(f,b,i) => ocScan(f,b) = i) %(sl_least_def)%
  . (slLeast(vEmptyFormula) /\
      (forall f : VFormula; e : VClause . slLeast(f) => slLeast(vClauseCons(e,f))))
     => (forall f : VFormula . slLeast(f)) %(sl_free_formula_induction)%
  forall j : VNat
    . j = vZ \/ (exists i : VNat . j = vS(i)) %(sl_index_cases)%
    . not slFailed(j) = slModel %(sl_output_disjoint)%
  forall i,j : VNat . slFailed(i) = slFailed(j) => i = j %(sl_failed_injective)%
  forall c : VInput; a : VWord; m : SLView; r : SLResult
    . vFormulaTrue(vFormula(c),a) => slResult(c,a) = slModel %(sl_emit_model)%
    . not vFormulaTrue(vFormula(c),a) =>
       slResult(c,a) = slFailed(ocScan(vFormula(c),a)) %(sl_emit_clause)%
    . slPossible(c,m,r) <=> (exists a : VWord .
         slAllows(m,a) /\ vLen(a) = vWidth(c) /\ slResult(c,a) = r) %(sl_possible_def)%
    . slTotal(c,m) <=> (forall a : VWord .
         slAllows(m,a) /\ vLen(a) = vWidth(c) => not vModel(c,a)) %(sl_total_def)%
    . slForce(c,m,r) <=> (slPossible(c,m,r) /\
          (forall q : SLResult . slPossible(c,m,q) => q = r)) %(sl_force_def)%
    . slVariableRead(c,m) <=> (exists r,q : SLResult .
            slPossible(c,m,r) /\ slPossible(c,m,q) /\ not r = q) %(sl_ambiguity_def)%

  forall c : VInput; m : SLView; j : VNat
    . slNonempty(c,m) <=> (exists a : VWord . slAllows(m,a) /\ vLen(a) = vWidth(c))
          %(sl_nonempty_def)%
    . slEveryEarlier(c,m,j) <=> (forall a : VWord . slAllows(m,a) /\ vLen(a) = vWidth(c) =>
                                        ocEarlierTrue(vFormula(c),a,j)) %(sl_earlier_def)%
    . slEveryFail(c,m,j) <=> (forall a : VWord . slAllows(m,a) /\ vLen(a) = vWidth(c) =>
                                        ocFails(vFormula(c),a,j)) %(sl_every_fail_def)%
    . slEveryTrue(c,m) <=> (forall a : VWord . slAllows(m,a) /\ vLen(a) = vWidth(c) =>
                                        vFormulaTrue(vFormula(c),a)) %(sl_every_true_def)%

  forall f : VFormula; e : VClause; a : VWord; i,j : VNat
    . slLeast(vEmptyFormula) %(sl_least_base)% %implied
    . slLeast(f) /\ ocFails(f,a,i) /\ ocEarlierTrue(f,a,i) => ocScan(f,a) = i
          %(sl_least_at)% %implied
    . ocFails(vClauseCons(e,f),a,vZ) => ocScan(vClauseCons(e,f),a) = vZ
          %(sl_step_at_zero)% %implied
    . slLeast(f) /\ ocFails(vClauseCons(e,f),a,vS(i)) /\ ocEarlierTrue(vClauseCons(e,f),a,vS(i))
         => ocScan(f,a) = i %(sl_step_tail_unique)% %implied
    . slLeast(f) /\ ocFails(vClauseCons(e,f),a,vS(i)) /\ ocEarlierTrue(vClauseCons(e,f),a,vS(i))
         => ocScan(vClauseCons(e,f),a) = vS(i) %(sl_step_at_successor)% %implied
    . slLeast(f) /\ ocFails(vClauseCons(e,f),a,j) /\ ocEarlierTrue(vClauseCons(e,f),a,j)
         => ocScan(vClauseCons(e,f),a) = j %(sl_step_at_index)% %implied
    . slLeast(f) => slLeast(vClauseCons(e,f)) %(sl_least_step)% %implied
    . slLeast(f) %(sl_least_all)% %implied
    . ocFails(f,a,j) /\ ocEarlierTrue(f,a,j) => ocScan(f,a) = j
          %(sl_least_unique)% %implied
    . not vFormulaTrue(f,a) /\ ocScan(f,a) = j =>
        ocFails(f,a,j) /\ ocEarlierTrue(f,a,j) %(sl_least_reads_original)% %implied
    . ocFails(f,a,j) /\ ocEarlierTrue(f,a,j) => not vFormulaTrue(f,a)
          %(sl_least_is_failure)% %implied
    . (not vFormulaTrue(f,a) /\ ocScan(f,a) = j) <=>
        (ocFails(f,a,j) /\ ocEarlierTrue(f,a,j)) %(sl_source_index_exact)% %implied

  forall c : VInput; m : SLView; a : VWord; j : VNat
    . slResult(c,a) = slModel <=> vFormulaTrue(vFormula(c),a) %(sl_result_model_exact)% %implied
    . slResult(c,a) = slFailed(j) <=> (not vFormulaTrue(vFormula(c),a) /\ ocScan(vFormula(c),a) = j)
          %(sl_result_code_exact)% %implied
    . slResult(c,a) = slFailed(j) <=>
         ocFails(vFormula(c),a,j) /\ ocEarlierTrue(vFormula(c),a,j) %(sl_result_clause_exact)% %implied
    . slPossible(c,m,slModel) <=> (exists b : VWord . slAllows(m,b) /\ vModel(c,b))
          %(sl_model_possible_exact)% %implied
    . slPossible(c,m,slFailed(j)) <=> (exists b : VWord .
         vLen(b) = vWidth(c) /\ slAllows(m,b) /\ ocFails(vFormula(c),b,j) /\
         ocEarlierTrue(vFormula(c),b,j)) %(sl_clause_possible_exact)% %implied
    . (exists b : VWord . slAllows(m,b) /\ vModel(c,b)) =>
          (exists b : VWord . slAllows(m,b) /\ vLen(b) = vWidth(c) /\ vModel(c,b))
          %(sl_compatible_sized_model)% %implied
    . slTotal(c,m) <=> (not (exists b : VWord .
          slAllows(m,b) /\ vLen(b) = vWidth(c) /\ vModel(c,b)))
          %(sl_total_iff_no_sized_model)% %implied
    . slTotal(c,m) <=> not slPossible(c,m,slModel) %(sl_total_cover_exact)% %implied
    . slPossible(c,m,slFailed(j)) /\ slPossible(c,m,slModel) => slVariableRead(c,m)
          %(sl_empty_and_inhabited_fibres)% %implied
  forall c : VInput; m : SLView; r : SLResult
    . slPossible(c,m,r) => (slForce(c,m,r) <=> not slVariableRead(c,m))
          %(sl_slack_exact)% %implied
    . slForce(c,m,r) <=> ((exists a : VWord .
          slAllows(m,a) /\ vLen(a) = vWidth(c)) /\
          (forall b : VWord . slAllows(m,b) /\ vLen(b) = vWidth(c) => slResult(c,b) = r))
          %(sl_force_every_completion)% %implied
  forall c : VInput; m : SLView; j : VNat
    . slForce(c,m,slModel) <=> slNonempty(c,m) /\ slEveryTrue(c,m)
          %(sl_forced_model_comparison)% %implied
    . slForce(c,m,slFailed(j)) <=>
        slNonempty(c,m) /\ slEveryEarlier(c,m,j) /\ slEveryFail(c,m,j)
          %(sl_forced_index_comparison)% %implied
end


%% Reversible gate wiring. Every displayed source bit is retained, including
%% the Fredkin output wire complementary to the selected wire.
spec CechReversibleGates = NativeTileProof then
  free type RGTriple ::= rgTriple(FBit; FBit; FBit)
  ops rgFredkin, rgToffoli : RGTriple -> RGTriple;
      rgRead : RGTriple -> FBit;
      rgAnd, rgOr, rgNand : FBit * FBit -> FBit;
      rgNot : FBit -> FBit;
      rgMux : FBit * FBit * FBit -> FBit
  forall c,a,b,t : FBit
    . rgFredkin(rgTriple(fzero,a,b)) = rgTriple(fzero,a,b) %(rg_fredkin_zero)%
    . rgFredkin(rgTriple(fone,a,b)) = rgTriple(fone,b,a) %(rg_fredkin_one)%
    . rgToffoli(rgTriple(c,a,t)) = rgTriple(c,a,fadd(fmul(c,a),t)) %(rg_toffoli_def)%
    . rgRead(rgTriple(c,a,b)) = b %(rg_read_def)%
    . rgAnd(a,b) = rgRead(rgToffoli(rgTriple(a,b,fzero))) %(rg_and_def)%
    . rgNand(a,b) = rgRead(rgToffoli(rgTriple(a,b,fone))) %(rg_nand_def)%
    . rgOr(a,b) = rgRead(rgFredkin(rgTriple(a,fone,b))) %(rg_or_def)%
    . rgNot(a) = rgRead(rgToffoli(rgTriple(a,fone,fone))) %(rg_not_def)%
    . rgMux(c,a,b) = rgRead(rgFredkin(rgTriple(c,a,b))) %(rg_mux_def)%
  forall u : RGTriple . exists c,a,b : FBit . u = rgTriple(c,a,b) %(rg_triple_cases)%
  . fzero = fone => false %(rg_bit_distinct)%
  forall a,b,t,c : FBit
    . fnot(fnot(a)) = a %(rg_not_twice)% %implied
    . fadd(a,fadd(a,t)) = t %(rg_xor_cancels)% %implied
    . fadd(a,fzero) = a %(rg_add_zero_right)% %implied
    . fadd(a,fone) = fnot(a) %(rg_add_one_right)% %implied
    . rgFredkin(rgFredkin(rgTriple(c,a,b))) = rgTriple(c,a,b) %(rg_fredkin_marked_inverse)% %implied
    . rgToffoli(rgToffoli(rgTriple(c,a,t))) = rgTriple(c,a,t) %(rg_toffoli_marked_inverse)% %implied
  forall u : RGTriple
    . rgFredkin(rgFredkin(u)) = u %(rg_fredkin_inverse)% %implied
    . rgToffoli(rgToffoli(u)) = u %(rg_toffoli_inverse)% %implied
  forall a,b : FBit
    . rgAnd(a,b) = fmul(a,b) %(rg_toffoli_and)% %implied
    . rgNand(a,b) = fnot(fmul(a,b)) %(rg_toffoli_nand)% %implied
    . rgNot(a) = fnot(a) %(rg_toffoli_not)% %implied
    . rgOr(fzero,b) = b %(rg_fredkin_or_zero)% %implied
    . rgOr(fone,b) = fone %(rg_fredkin_or_one)% %implied
    . rgOr(a,b) = fjoin(a,b) %(rg_fredkin_or)% %implied
    . rgMux(fzero,a,b) = b %(rg_fredkin_mux_zero)% %implied
    . rgMux(fone,a,b) = a %(rg_fredkin_mux_one)% %implied
    . rgMux(a,b,b) = b %(rg_fredkin_irrelevant_control)% %implied
    . rgAnd(a,b) = fone <=> a = fone /\ b = fone %(rg_and_bit_exact)% %implied
    . rgOr(a,b) = fone <=> a = fone \/ b = fone %(rg_or_bit_exact)% %implied
    . rgNot(a) = fone <=> not a = fone %(rg_not_bit_exact)% %implied
end

%% Evaluation at an actual address and one original clause index. A failure
%% beyond the end of the original clause list always reads zero.
spec FredkinToffoliClauseSelector = CechReversibleGates and OriginalClauseCover then
  ops rgWire : VWord * VNat -> FBit;
      rgLiteral : VLiteral * VWord -> FBit;
      rgClause : VClause * VWord -> FBit;
      rgFailure, rgPrefix, rgOneHot : VFormula * VWord * VNat -> FBit
  preds rgClauseLaw : VClause;
        rgSelectorLaw : VFormula;
        rgWireLaw : VClause;
        rgIndexCases : VNat;
        rgUses : VClause * VNat;
        rgAgree : VClause * VWord * VWord

  forall x,y : FBit; a : VWord; i,j : VNat; q : VClause; l : VLiteral; f : VFormula
    . rgWire(a,i) = fone <=> vBitAt(a,i) %(rg_wire_read)%
    . rgLiteral(vPos(i),a) = rgWire(a,i) %(rg_pos_lit_def)%
    . rgLiteral(vNeg(i),a) = rgNot(rgWire(a,i)) %(rg_neg_lit_def)%
    . rgClause(vEmptyClause,a) = fzero %(rg_clause_empty)%
    . rgClause(vLitCons(l,q),a) = rgOr(rgLiteral(l,a),rgClause(q,a)) %(rg_clause_cons)%
    . rgFailure(vEmptyFormula,a,i) = fzero %(rg_failure_empty)%
    . rgFailure(vClauseCons(q,f),a,vZ) = rgNot(rgClause(q,a)) %(rg_failure_head)%
    . rgFailure(vClauseCons(q,f),a,vS(i)) = rgFailure(f,a,i) %(rg_failure_tail)%
    . rgPrefix(f,a,vZ) = fone %(rg_prefix_zero)%
    . rgPrefix(vEmptyFormula,a,vS(i)) = fzero %(rg_prefix_empty_successor)%
    . rgPrefix(vClauseCons(q,f),a,vS(i)) =
         rgAnd(rgClause(q,a),rgPrefix(f,a,i)) %(rg_prefix_step)%
    . rgOneHot(f,a,i) = rgAnd(rgPrefix(f,a,i),rgFailure(f,a,i)) %(rg_hot_def)%
    . rgIndexCases(i) <=> i = vZ \/ (exists h : VNat . i = vS(h)) %(rg_index_case_pred)%
    . rgIndexCases(i) %(rg_index_case)%
    . rgUses(vEmptyClause,i) <=> false %(rg_uses_empty)%
    . rgUses(vLitCons(vPos(j),q),i) <=> i = j \/ rgUses(q,i) %(rg_uses_pos)%
    . rgUses(vLitCons(vNeg(j),q),i) <=> i = j \/ rgUses(q,i) %(rg_uses_neg)%
  forall l : VLiteral . (exists i : VNat . l = vPos(i)) \/ (exists i : VNat . l = vNeg(i))
    %(rg_literal_cases)%
  forall q : VClause; f : VFormula; a,b : VWord
    . rgClauseLaw(q) <=> (forall z : VWord . rgClause(q,z) = fone <=> vClauseTrue(q,z))
          %(rg_clause_invariant)%
    . rgWireLaw(q) <=> (forall x,y : VWord . rgAgree(q,x,y) => rgClause(q,x) = rgClause(q,y))
          %(rg_wire_law_def)%
    . rgAgree(q,a,b) <=> (forall i : VNat . rgUses(q,i) => (vBitAt(a,i) <=> vBitAt(b,i)))
          %(rg_agree_def)%
    . rgSelectorLaw(f) <=> (forall z : VWord; i : VNat .
        (rgFailure(f,z,i) = fone <=> ocFails(f,z,i)) /\
        (rgPrefix(f,z,i) = fone <=> ocEarlierTrue(f,z,i)))
          %(rg_selector_invariant)%
    %% The three formulas instantiate structural induction for the free sorts.
    . (rgClauseLaw(vEmptyClause) /\
        (forall l : VLiteral; p : VClause . rgClauseLaw(p) => rgClauseLaw(vLitCons(l,p))))
         => (forall p : VClause . rgClauseLaw(p)) %(rg_clause_induction)%
    . (rgWireLaw(vEmptyClause) /\
        (forall l : VLiteral; p : VClause . rgWireLaw(p) => rgWireLaw(vLitCons(l,p))))
         => (forall p : VClause . rgWireLaw(p)) %(rg_wire_induction)%
    . (rgSelectorLaw(vEmptyFormula) /\
        (forall q : VClause; h : VFormula . rgSelectorLaw(h) => rgSelectorLaw(vClauseCons(q,h))))
          => (forall h : VFormula . rgSelectorLaw(h)) %(rg_formula_induction)%

  forall l : VLiteral; i,j : VNat; q : VClause; a,b : VWord; f : VFormula; x,y : FBit
    . (x = fone <=> y = fone) => x = y %(rg_equal_from_bit)% %implied
    . rgLiteral(vPos(i),a) = fone <=> vLitTrue(vPos(i),a) %(rg_lit_pos_exact)% %implied
    . rgLiteral(vNeg(i),a) = fone <=> vLitTrue(vNeg(i),a) %(rg_lit_neg_exact)% %implied
    . rgLiteral(l,a) = fone <=> vLitTrue(l,a) %(rg_literal_exact)% %implied
    . rgClause(vEmptyClause,a) = fone <=> vClauseTrue(vEmptyClause,a) %(rg_empty_exact)% %implied
    . rgClauseLaw(vEmptyClause) %(rg_clause_base)% %implied
    . rgClauseLaw(q) => (rgClause(q,a) = fone <=> vClauseTrue(q,a)) %(rg_clause_at_word)% %implied
    . rgClauseLaw(q) => (rgClause(vLitCons(l,q),a) = fone <=> vClauseTrue(vLitCons(l,q),a))
          %(rg_cons_exact)% %implied
    . rgClauseLaw(q) => rgClauseLaw(vLitCons(l,q)) %(rg_clause_step)% %implied
    . rgClauseLaw(q) %(rg_clause_all)% %implied
    . rgClause(q,a) = fone <=> vClauseTrue(q,a) %(rg_clause_bit_exact)% %implied

    . rgFailure(vEmptyFormula,a,i) = fone <=> ocFails(vEmptyFormula,a,i)
          %(rg_empty_failure_exact)% %implied
    . rgPrefix(f,a,vZ) = fone <=> ocEarlierTrue(f,a,vZ) %(rg_prefix_zero_exact)% %implied
    . rgPrefix(vEmptyFormula,a,vS(i)) = fone <=> ocEarlierTrue(vEmptyFormula,a,vS(i))
          %(rg_prefix_empty_succ_exact)% %implied
    . rgPrefix(vEmptyFormula,a,i) = fone <=> ocEarlierTrue(vEmptyFormula,a,i)
          %(rg_prefix_empty_exact)% %implied
    . rgSelectorLaw(vEmptyFormula) %(rg_selector_base)% %implied
    . rgSelectorLaw(f) => (rgFailure(f,a,i) = fone <=> ocFails(f,a,i))
          %(rg_selector_failure_at)% %implied
    . rgSelectorLaw(f) => (rgPrefix(f,a,i) = fone <=> ocEarlierTrue(f,a,i))
          %(rg_selector_prefix_at)% %implied
    . rgFailure(vClauseCons(q,f),a,vZ) = fone <=> ocFails(vClauseCons(q,f),a,vZ)
          %(rg_failure_zero_exact)% %implied
    . rgSelectorLaw(f) => (rgFailure(vClauseCons(q,f),a,vS(i)) = fone <=> ocFails(vClauseCons(q,f),a,vS(i)))
          %(rg_failure_succ_exact)% %implied
    . rgSelectorLaw(f) => (rgPrefix(vClauseCons(q,f),a,vS(i)) = fone <=> ocEarlierTrue(vClauseCons(q,f),a,vS(i)))
          %(rg_prefix_succ_exact)% %implied
    . rgSelectorLaw(f) => (rgFailure(vClauseCons(q,f),a,i) = fone <=> ocFails(vClauseCons(q,f),a,i))
          %(rg_failure_cons_exact)% %implied
    . rgSelectorLaw(f) => (rgPrefix(vClauseCons(q,f),a,i) = fone <=> ocEarlierTrue(vClauseCons(q,f),a,i))
          %(rg_prefix_cons_exact)% %implied
    . rgSelectorLaw(f) => rgSelectorLaw(vClauseCons(q,f)) %(rg_selector_step)% %implied
    . rgSelectorLaw(f) %(rg_selector_all)% %implied
    . rgFailure(f,a,i) = fone <=> ocFails(f,a,i) %(rg_failure_exact)% %implied
    . rgPrefix(f,a,i) = fone <=> ocEarlierTrue(f,a,i) %(rg_prefix_exact)% %implied
    . rgOneHot(f,a,i) = fone <=> ocFails(f,a,i) /\ ocEarlierTrue(f,a,i)
          %(rg_one_hot_original_mark)% %implied
    . rgOneHot(f,a,ocScan(f,a)) = fone <=> not vFormulaTrue(f,a) %(rg_one_hot_scan)% %implied

    %% The clause read factors through the indexed original input wires in the
    %% gate's backward cone. This is true on all addresses, including extensions.
    . rgAgree(q,a,b) /\ rgUses(q,i) => (vBitAt(a,i) <=> vBitAt(b,i)) %(rg_agree_at_wire)% %implied
    . rgUses(vLitCons(vPos(j),q),j) %(rg_head_pos_in_cone)% %implied
    . rgUses(vLitCons(vNeg(j),q),j) %(rg_head_neg_in_cone)% %implied
    . rgAgree(vLitCons(vPos(j),q),a,b) => rgWire(a,j) = rgWire(b,j) %(rg_agree_pos_wire)% %implied
    . rgAgree(vLitCons(vNeg(j),q),a,b) => rgWire(a,j) = rgWire(b,j) %(rg_agree_neg_wire)% %implied
    . rgAgree(vLitCons(vPos(j),q),a,b) => rgLiteral(vPos(j),a) = rgLiteral(vPos(j),b)
          %(rg_agree_pos_literal)% %implied
    . rgAgree(vLitCons(vNeg(j),q),a,b) => rgLiteral(vNeg(j),a) = rgLiteral(vNeg(j),b)
          %(rg_agree_neg_literal)% %implied
    . rgAgree(vLitCons(l,q),a,b) => rgLiteral(l,a) = rgLiteral(l,b) %(rg_agree_any_literal)% %implied
    . rgAgree(vLitCons(vPos(j),q),a,b) => rgAgree(q,a,b) %(rg_agree_pos_tail)% %implied
    . rgAgree(vLitCons(vNeg(j),q),a,b) => rgAgree(q,a,b) %(rg_agree_neg_tail)% %implied
    . rgAgree(vLitCons(l,q),a,b) => rgAgree(q,a,b) %(rg_agree_any_tail)% %implied
    . rgWireLaw(vEmptyClause) %(rg_wire_base)% %implied
    . rgWireLaw(q) /\ rgAgree(q,a,b) => rgClause(q,a) = rgClause(q,b) %(rg_cone_at_clause)% %implied
    . rgWireLaw(q) /\ rgAgree(vLitCons(l,q),a,b) =>
        rgClause(vLitCons(l,q),a) = rgClause(vLitCons(l,q),b) %(rg_cone_at_cons)% %implied
    . rgWireLaw(q) => rgWireLaw(vLitCons(l,q)) %(rg_wire_step)% %implied
    . rgWireLaw(q) %(rg_wire_all)% %implied
    . rgAgree(q,a,b) => rgClause(q,a) = rgClause(q,b) %(rg_clause_light_cone)% %implied
end


%% Backward cone of one output h_j for the least original failed occurrence.
%% Its wires belong to the original clauses through index j.
spec IndexedSelectorLightCone = FredkinToffoliClauseSelector then
  preds riCone : VFormula * VNat * VNat;
        riAgree : VFormula * VNat * VWord * VWord;
        riInvariant : VFormula;
        riFirst : VFormula * VWord * VNat;
        riUnique : VFormula
  forall f : VFormula; i,j : VNat; q : VClause; a,b : VWord
    . not riCone(vEmptyFormula,i,j) %(ri_empty_cone)%
    . riCone(vClauseCons(q,f),vZ,j) <=> rgUses(q,j) %(ri_zero_cone)%
    . riCone(vClauseCons(q,f),vS(i),j) <=> rgUses(q,j) \/ riCone(f,i,j) %(ri_successor_cone)%
    . riAgree(f,i,a,b) <=> (forall k : VNat . riCone(f,i,k) => (vBitAt(a,k) <=> vBitAt(b,k)))
          %(ri_agree_def)%
    . riInvariant(f) <=> (forall k : VNat; x,y : VWord . riAgree(f,k,x,y) =>
        rgFailure(f,x,k) = rgFailure(f,y,k) /\ rgPrefix(f,x,k) = rgPrefix(f,y,k))
          %(ri_invariant_def)%
    . riFirst(f,a,i) <=> ocFails(f,a,i) /\ ocEarlierTrue(f,a,i) %(ri_first_def)%
    . riUnique(f) <=> (forall x : VWord; k : VNat . riFirst(f,x,k) => k = ocScan(f,x))
          %(ri_unique_def)%
    %% Structural induction for the two displayed predicates on the free list.
    . (riInvariant(vEmptyFormula) /\
       (forall q : VClause; t : VFormula . riInvariant(t) => riInvariant(vClauseCons(q,t))))
         => (forall t : VFormula . riInvariant(t)) %(ri_cone_induction)%
    . (riUnique(vEmptyFormula) /\
       (forall q : VClause; t : VFormula . riUnique(t) => riUnique(vClauseCons(q,t))))
         => (forall t : VFormula . riUnique(t)) %(ri_unique_induction)%
  forall f : VFormula; i,j : VNat; q : VClause; a,b : VWord
    . riAgree(f,i,a,b) /\ riCone(f,i,j) => (vBitAt(a,j) <=> vBitAt(b,j))
          %(ri_observed_wire)% %implied
    . riAgree(vClauseCons(q,f),vZ,a,b) => rgAgree(q,a,b) %(ri_zero_head)% %implied
    . riAgree(vClauseCons(q,f),vS(i),a,b) => rgAgree(q,a,b) %(ri_successor_head)% %implied
    . riAgree(vClauseCons(q,f),vS(i),a,b) => riAgree(f,i,a,b) %(ri_successor_tail)% %implied
    . rgPrefix(vEmptyFormula,a,i) = rgPrefix(vEmptyFormula,b,i) %(ri_empty_prefix)% %implied
    . riInvariant(vEmptyFormula) %(ri_cone_base)% %implied
    . riInvariant(f) /\ riAgree(f,i,a,b) => rgFailure(f,a,i) = rgFailure(f,b,i)
          %(ri_failure_under_invariant)% %implied
    . riInvariant(f) /\ riAgree(f,i,a,b) => rgPrefix(f,a,i) = rgPrefix(f,b,i)
          %(ri_prefix_under_invariant)% %implied
    . riAgree(vClauseCons(q,f),vZ,a,b) =>
          rgFailure(vClauseCons(q,f),a,vZ) = rgFailure(vClauseCons(q,f),b,vZ)
          %(ri_failure_zero)% %implied
    . riInvariant(f) /\ riAgree(vClauseCons(q,f),vS(i),a,b) =>
          rgFailure(vClauseCons(q,f),a,vS(i)) = rgFailure(vClauseCons(q,f),b,vS(i))
          %(ri_failure_successor)% %implied
    . riInvariant(f) /\ riAgree(vClauseCons(q,f),vS(i),a,b) =>
          rgPrefix(vClauseCons(q,f),a,vS(i)) = rgPrefix(vClauseCons(q,f),b,vS(i))
          %(ri_prefix_successor)% %implied
    . riInvariant(f) /\ riAgree(vClauseCons(q,f),i,a,b) =>
          rgPrefix(vClauseCons(q,f),a,i) = rgPrefix(vClauseCons(q,f),b,i)
          %(ri_prefix_cons)% %implied
    . riInvariant(f) /\ riAgree(vClauseCons(q,f),i,a,b) =>
          rgFailure(vClauseCons(q,f),a,i) = rgFailure(vClauseCons(q,f),b,i)
          %(ri_failure_cons)% %implied
    . riInvariant(f) => riInvariant(vClauseCons(q,f)) %(ri_cone_step)% %implied
    . riInvariant(f) %(ri_cone_all)% %implied
    . riAgree(f,i,a,b) => rgOneHot(f,a,i) = rgOneHot(f,b,i)
          %(ri_indexed_light_cone)% %implied

    . not riFirst(vEmptyFormula,a,i) %(ri_no_empty_index)% %implied
    . riFirst(vClauseCons(q,f),a,vZ) <=> not vClauseTrue(q,a) %(ri_first_head)% %implied
    . riFirst(vClauseCons(q,f),a,vS(i)) <=> vClauseTrue(q,a) /\ riFirst(f,a,i)
          %(ri_first_tail)% %implied
    . riUnique(vEmptyFormula) %(ri_unique_base)% %implied
    . riUnique(f) /\ riFirst(f,a,i) => i = ocScan(f,a) %(ri_first_is_scan_at_formula)% %implied
    . riFirst(vClauseCons(q,f),a,vZ) => vZ = ocScan(vClauseCons(q,f),a) %(ri_head_is_scan)% %implied
    . riUnique(f) /\ riFirst(vClauseCons(q,f),a,vS(i)) =>
          vS(i) = ocScan(vClauseCons(q,f),a) %(ri_tail_is_scan)% %implied
    . riUnique(f) /\ riFirst(vClauseCons(q,f),a,i) => i = ocScan(vClauseCons(q,f),a)
          %(ri_cons_is_scan)% %implied
    . riUnique(f) => riUnique(vClauseCons(q,f)) %(ri_unique_step)% %implied
    . riUnique(f) %(ri_unique_all)% %implied
    . rgOneHot(f,a,i) = fone <=> i = ocScan(f,a) /\ not vFormulaTrue(f,a)
          %(ri_one_hot_iff_least_original_failure)% %implied
end


%% Finite gate sequences acting on bit-valued states of a set of wires.
%% lcNext(g,c) runs g before c. Each dependency is propagated back through
%% g to an actual input wire. Legal reversible gates use distinct wires.
spec TemporalGateLightCone = NativeTileProof then
  sorts LCWire, LCState, LCMask
  free types
    LCGate ::= lcFred(LCWire;LCWire;LCWire) | lcTof(LCWire;LCWire;LCWire)
    LCCircuit ::= lcSkip | lcNext(LCGate;LCCircuit)
  ops
    lcRead : LCState * LCWire -> FBit;
    lcMux : FBit * FBit * FBit -> FBit;
    lcStep : LCGate * LCState -> LCState;
    lcRun : LCCircuit * LCState -> LCState;
    lcOverlay : LCCircuit * LCWire * LCState * LCState -> LCState
  preds
    lcUses : LCGate * LCWire * LCWire;
    lcDepends : LCCircuit * LCWire * LCWire;
    lcStepAgreement : LCGate * LCWire * LCState * LCState;
    lcConeAgreement : LCCircuit * LCWire * LCState * LCState;
    lcConeLaw : LCCircuit;
    lcObserved : LCMask * LCWire;
    lcCompatible : LCMask * LCState * LCState;
    lcInside : LCCircuit * LCWire * LCMask * LCState * LCState;
    lcPossible : LCCircuit * LCWire * LCMask * LCState * FBit;
    lcInsidePossible : LCCircuit * LCWire * LCMask * LCState * FBit;
    lcUnderdetermined : LCCircuit * LCWire * LCMask * LCState;
    lcForces : LCCircuit * LCWire * LCMask * LCState * FBit

  forall x,y : FBit
    . lcMux(fzero,x,y) = x %(lc_mux_zero)%
    . lcMux(fone,x,y) = y %(lc_mux_one)%
  . not fone = fzero %(lc_distinct)%
  forall g : LCGate
    . (exists a,b,d : LCWire . g = lcFred(a,b,d)) \/
      (exists a,b,d : LCWire . g = lcTof(a,b,d)) %(lc_gate_cases)%
  forall a,b,d,q,w : LCWire; s : LCState
    . lcRead(lcStep(lcFred(a,b,d),s),b) =
        lcMux(lcRead(s,a),lcRead(s,b),lcRead(s,d)) %(lc_fred_b)%
    . lcRead(lcStep(lcFred(a,b,d),s),d) =
        lcMux(lcRead(s,a),lcRead(s,d),lcRead(s,b)) %(lc_fred_d)%
    . not q = b /\ not q = d => lcRead(lcStep(lcFred(a,b,d),s),q) = lcRead(s,q)
        %(lc_fred_other)%
    . lcRead(lcStep(lcTof(a,b,d),s),d) =
        fadd(fmul(lcRead(s,a),lcRead(s,b)),lcRead(s,d)) %(lc_tof_d)%
    . not q = d => lcRead(lcStep(lcTof(a,b,d),s),q) = lcRead(s,q) %(lc_tof_other)%
    . lcUses(lcFred(a,b,d),q,w) <=>
        (((q = b \/ q = d) /\ (w = a \/ w = b \/ w = d)) \/
         (not q = b /\ not q = d /\ w = q)) %(lc_fred_support)%
    . lcUses(lcTof(a,b,d),q,w) <=>
        ((q = d /\ (w = a \/ w = b \/ w = d)) \/
         (not q = d /\ w = q)) %(lc_tof_support)%
  forall g : LCGate; c : LCCircuit; q,w : LCWire; s,t : LCState
    . lcRun(lcSkip,s) = s %(lc_run_base)%
    . lcRun(lcNext(g,c),s) = lcRun(c,lcStep(g,s)) %(lc_run_step)%
    . lcDepends(lcSkip,q,w) <=> q = w %(lc_dep_base)%
    . lcDepends(lcNext(g,c),q,w) <=>
        (exists u : LCWire . lcDepends(c,q,u) /\ lcUses(g,u,w)) %(lc_dep_step)%
    . lcStepAgreement(g,q,s,t) <=>
        (forall u : LCWire . lcUses(g,q,u) => lcRead(s,u) = lcRead(t,u)) %(lc_sagree_def)%
    . lcConeAgreement(c,q,s,t) <=>
        (forall u : LCWire . lcDepends(c,q,u) => lcRead(s,u) = lcRead(t,u)) %(lc_cagree_def)%
    . lcConeLaw(c) <=> (forall r : LCWire; m,n : LCState .
        lcConeAgreement(c,r,m,n) => lcRead(lcRun(c,m),r) = lcRead(lcRun(c,n),r))
        %(lc_invariant)%
  %% This induction schema is justified by initiality of the free LCCircuit
  %% datatype. Its concrete base and step are separately replayed below.
  . (lcConeLaw(lcSkip) /\ (forall g : LCGate; c : LCCircuit .
        lcConeLaw(c) => lcConeLaw(lcNext(g,c)))) => (forall c : LCCircuit . lcConeLaw(c))
        %(lc_free_circuit_induction)%

  forall a,b,d,q,w : LCWire; s,t : LCState
    . lcUses(lcFred(a,b,d),b,a) /\ lcUses(lcFred(a,b,d),b,b) /\ lcUses(lcFred(a,b,d),b,d)
        %(lc_fred_b_uses)% %implied
    . lcUses(lcFred(a,b,d),d,a) /\ lcUses(lcFred(a,b,d),d,b) /\ lcUses(lcFred(a,b,d),d,d)
        %(lc_fred_d_uses)% %implied
    . not q = b /\ not q = d => lcUses(lcFred(a,b,d),q,q) %(lc_fred_other_uses)% %implied
    . lcUses(lcTof(a,b,d),d,a) /\ lcUses(lcTof(a,b,d),d,b) /\ lcUses(lcTof(a,b,d),d,d)
        %(lc_tof_d_uses)% %implied
    . not q = d => lcUses(lcTof(a,b,d),q,q) %(lc_tof_other_uses)% %implied
    . lcStepAgreement(lcFred(a,b,d),b,s,t) =>
         lcRead(s,a) = lcRead(t,a) /\ lcRead(s,b) = lcRead(t,b) /\ lcRead(s,d) = lcRead(t,d)
         %(lc_fred_b_reads_agree)% %implied
    . lcStepAgreement(lcFred(a,b,d),b,s,t) =>
         lcRead(lcStep(lcFred(a,b,d),s),b) = lcRead(lcStep(lcFred(a,b,d),t),b)
         %(lc_fred_b_inverse_cone)% %implied
    . lcStepAgreement(lcFred(a,b,d),d,s,t) =>
         lcRead(lcStep(lcFred(a,b,d),s),d) = lcRead(lcStep(lcFred(a,b,d),t),d)
         %(lc_fred_d_inverse_cone)% %implied
    . not q = b /\ not q = d /\ lcStepAgreement(lcFred(a,b,d),q,s,t) =>
         lcRead(lcStep(lcFred(a,b,d),s),q) = lcRead(lcStep(lcFred(a,b,d),t),q)
         %(lc_fred_other_inverse_cone)% %implied
    . lcStepAgreement(lcFred(a,b,d),q,s,t) =>
         lcRead(lcStep(lcFred(a,b,d),s),q) = lcRead(lcStep(lcFred(a,b,d),t),q)
         %(lc_fred_inverse_cone)% %implied
    . lcStepAgreement(lcTof(a,b,d),d,s,t) =>
         lcRead(lcStep(lcTof(a,b,d),s),d) = lcRead(lcStep(lcTof(a,b,d),t),d)
         %(lc_tof_d_inverse_cone)% %implied
    . not q = d /\ lcStepAgreement(lcTof(a,b,d),q,s,t) =>
         lcRead(lcStep(lcTof(a,b,d),s),q) = lcRead(lcStep(lcTof(a,b,d),t),q)
         %(lc_tof_other_inverse_cone)% %implied
    . lcStepAgreement(lcTof(a,b,d),q,s,t) =>
         lcRead(lcStep(lcTof(a,b,d),s),q) = lcRead(lcStep(lcTof(a,b,d),t),q)
         %(lc_tof_inverse_cone)% %implied
  forall g : LCGate; c : LCCircuit; q,u,w : LCWire; s,t : LCState
    . lcStepAgreement(g,q,s,t) => lcRead(lcStep(g,s),q) = lcRead(lcStep(g,t),q)
        %(lc_step_sound)% %implied
    . lcConeAgreement(lcSkip,q,s,t) => lcRead(s,q) = lcRead(t,q) %(lc_base_agree_at_read)% %implied
    . lcConeLaw(lcSkip) %(lc_cone_base)% %implied
    . lcDepends(c,q,u) /\ lcUses(g,u,w) => lcDepends(lcNext(g,c),q,w)
        %(lc_dep_witness)% %implied
    . lcConeAgreement(lcNext(g,c),q,s,t) /\ lcDepends(c,q,u) =>
        lcStepAgreement(g,u,s,t) %(lc_agree_through_dependency)% %implied
    . lcConeAgreement(lcNext(g,c),q,s,t) /\ lcDepends(c,q,u) =>
        lcRead(lcStep(g,s),u) = lcRead(lcStep(g,t),u) %(lc_equal_intermediate_read)% %implied
    . lcConeAgreement(lcNext(g,c),q,s,t) =>
        lcConeAgreement(c,q,lcStep(g,s),lcStep(g,t)) %(lc_cone_pullback)% %implied
    . lcConeLaw(c) /\ lcConeAgreement(c,q,s,t) =>
        lcRead(lcRun(c,s),q) = lcRead(lcRun(c,t),q) %(lc_cone_law_at_point)% %implied
    . lcConeLaw(c) /\ lcConeAgreement(lcNext(g,c),q,s,t) =>
        lcRead(lcRun(lcNext(g,c),s),q) = lcRead(lcRun(lcNext(g,c),t),q)
        %(lc_cone_step_at_point)% %implied
    . lcConeLaw(c) => lcConeLaw(lcNext(g,c)) %(lc_cone_step)% %implied
    . lcConeLaw(c) %(lc_cone_all)% %implied
    . lcConeAgreement(c,q,s,t) => lcRead(lcRun(c,s),q) = lcRead(lcRun(c,t),q)
        %(lc_cone_sound)% %implied

  %% The completion space is the full bit cube. Prescribed initial work bits
  %% are included in the observation mask. Overlay splices independent input
  %% coordinates, with the reference state supplying everything off the cone.
  forall c : LCCircuit; q,w : LCWire; m : LCMask; s,t : LCState; b : FBit
    . lcDepends(c,q,w) => lcRead(lcOverlay(c,q,s,t),w) = lcRead(s,w)
        %(lc_overlay_inside)%
    . not lcDepends(c,q,w) => lcRead(lcOverlay(c,q,s,t),w) = lcRead(t,w)
        %(lc_overlay_outside)%
    . lcCompatible(m,s,t) <=>
        (forall u : LCWire . lcObserved(m,u) => lcRead(s,u) = lcRead(t,u))
        %(lc_compatible_def)%
    . lcInside(c,q,m,s,t) <=>
        (forall u : LCWire . lcObserved(m,u) /\ lcDepends(c,q,u) => lcRead(s,u) = lcRead(t,u))
        %(lc_inside_def)%
    . lcPossible(c,q,m,t,b) <=>
        (exists h : LCState . lcCompatible(m,h,t) /\ lcRead(lcRun(c,h),q) = b)
        %(lc_possible_def)%
    . lcInsidePossible(c,q,m,t,b) <=>
        (exists h : LCState . lcInside(c,q,m,h,t) /\ lcRead(lcRun(c,h),q) = b)
        %(lc_inside_possible_def)%
    . lcUnderdetermined(c,q,m,t) <=>
        lcPossible(c,q,m,t,fzero) /\ lcPossible(c,q,m,t,fone) %(lc_underdetermined_def)%
    . lcForces(c,q,m,t,b) <=>
        (forall h : LCState . lcCompatible(m,h,t) => lcRead(lcRun(c,h),q) = b)
        %(lc_forces_def)%
    . lcCompatible(m,s,t) => lcInside(c,q,m,s,t) %(lc_full_implies_inside)% %implied
    . lcConeAgreement(c,q,lcOverlay(c,q,s,t),s) %(lc_overlay_agrees)% %implied
    . lcRead(lcRun(c,lcOverlay(c,q,s,t)),q) = lcRead(lcRun(c,s),q)
        %(lc_overlay_preserves_output)% %implied
    . lcInside(c,q,m,s,t) /\ lcObserved(m,w) =>
        lcRead(lcOverlay(c,q,s,t),w) = lcRead(t,w)
        %(lc_overlay_respects_observed_wire)% %implied
    . lcInside(c,q,m,s,t) => lcCompatible(m,lcOverlay(c,q,s,t),t)
        %(lc_overlay_satisfies_full_mask)% %implied
    . lcInside(c,q,m,s,t) /\ lcRead(lcRun(c,s),q) = b => lcPossible(c,q,m,t,b)
        %(lc_overlay_witness)% %implied
    . lcInsidePossible(c,q,m,t,b) => lcPossible(c,q,m,t,b)
        %(lc_inside_possibility_lifts)% %implied
    . lcCompatible(m,s,t) /\ lcRead(lcRun(c,s),q) = b => lcInsidePossible(c,q,m,t,b)
        %(lc_restriction_witness)% %implied
    . lcPossible(c,q,m,t,b) => lcInsidePossible(c,q,m,t,b)
        %(lc_full_possibility_restricts)% %implied
    . lcPossible(c,q,m,t,b) <=> lcInsidePossible(c,q,m,t,b)
        %(lc_possible_iff_inside_observation)% %implied
    . lcUnderdetermined(c,q,m,t) <=>
        lcInsidePossible(c,q,m,t,fzero) /\ lcInsidePossible(c,q,m,t,fone)
        %(lc_underdetermined_iff_inside_both)% %implied
    . lcCompatible(m,t,t) %(lc_reference_compatible)% %implied
    . lcPossible(c,q,m,t,lcRead(lcRun(c,t),q)) %(lc_reference_possible)% %implied
    . lcForces(c,q,m,t,fzero) <=> not lcPossible(c,q,m,t,fone) %(lc_forced_zero_exact)% %implied
    . lcForces(c,q,m,t,fone) <=> not lcPossible(c,q,m,t,fzero) %(lc_forced_one_exact)% %implied
    . lcUnderdetermined(c,q,m,t) <=> not lcForces(c,q,m,t,fzero) /\ not lcForces(c,q,m,t,fone)
        %(lc_underdetermined_iff_no_forced_bit)% %implied

  %% Structural reachability can overestimate semantic support even for one
  %% legal gate. These two guarded equations certify additional slack.
  forall a,b,d : LCWire; s : LCState
    . lcRead(s,a) = fzero => lcRead(lcStep(lcTof(a,b,d),s),d) = lcRead(s,d)
        %(lc_tof_known_zero_guard)% %implied
    . lcRead(s,b) = lcRead(s,d) =>
        lcRead(lcStep(lcFred(a,b,d),s),b) = lcRead(s,b)
        %(lc_fred_equal_branches_guard)% %implied
end


%% The original encoding is fixed once.  cdInput3 identifies the legal original
%% 3-CNFs under it, and cdEncode returns their original bit strings.
%% The machine observation is its actual trace of bit steps.  The stop wrapper
%% reads the trace at the one clock a(L+1)^d.  Its own bookkeeping can have
%% polynomial overhead.  No correctness or time bound on any machine is an axiom.
spec FixedMonitorClock = FixedVerifierMinimum then
  sort CDMachine
  ops cdEncode : VInput -> VWord;
      cdAdd, cdMul, cdPow : VNat * VNat -> VNat;
      cdBudget : VInput * VNat * VNat -> VNat
  preds cdInput3 : VInput;
        cdEmit : CDMachine * VInput * VNat;
        cdLatch : CDMachine * VInput * VNat;
        cdStopYes, cdStopNo : CDMachine * VInput * VNat * VNat;
        cdSound : CDMachine;
        cdTimely, cdPass, cdStopsCorrectly : CDMachine * VNat * VNat;
        cdSegmentLaw, cdLatchLaw : VNat

  forall a,b : VNat; c : VInput
    . cdAdd(a,vZ) = a %(cd_add_z)%
    . cdAdd(a,vS(b)) = vS(cdAdd(a,b)) %(cd_add_s)%
    . cdMul(a,vZ) = vZ %(cd_mul_z)%
    . cdMul(a,vS(b)) = cdAdd(cdMul(a,b),a) %(cd_mul_s)%
    . cdPow(a,vZ) = vS(vZ) %(cd_pow_z)%
    . cdPow(a,vS(b)) = cdMul(cdPow(a,b),a) %(cd_pow_s)%
    . cdBudget(c,a,b) = cdMul(a,cdPow(vS(vLen(cdEncode(c))),b))
          %(cd_budget_definition)%

  forall j,k : VNat
    . j=vZ \/ (exists i : VNat . j=vS(i)) %(cd_nat_cases)%
    . not vZ=vS(j) %(cd_nat_disjoint)%
    . vS(j)=vS(k) => j=k %(cd_nat_injective)%
    . cdSegmentLaw(k) <=>
         (forall t : VNat . vLe(t,vS(k)) <=> vLe(t,k) \/ t=vS(k))
          %(cd_segment_law_def)%
  . (cdSegmentLaw(vZ) /\
        (forall k : VNat . cdSegmentLaw(k) => cdSegmentLaw(vS(k)))) =>
          (forall k : VNat . cdSegmentLaw(k)) %(cd_segment_induction)%
  forall m : CDMachine; c : VInput; t : VNat
    . cdLatch(m,c,vZ) <=> cdEmit(m,c,vZ) %(cd_latch_zero_def)%
    . cdLatch(m,c,vS(t)) <=> cdLatch(m,c,t) \/ cdEmit(m,c,vS(t))
          %(cd_latch_s_def)%
    . cdLatchLaw(t) <=>
         (forall x : CDMachine; f : VInput . cdLatch(x,f,t) <=>
            (exists q : VNat . vLe(q,t) /\ cdEmit(x,f,q))) %(cd_latch_law_def)%
  . (cdLatchLaw(vZ) /\ (forall t : VNat . cdLatchLaw(t) => cdLatchLaw(vS(t)))) =>
        (forall t : VNat . cdLatchLaw(t)) %(cd_latch_induction)%

  forall m : CDMachine; c : VInput; a,d : VNat
    . cdStopYes(m,c,a,d) <=> cdLatch(m,c,cdBudget(c,a,d)) %(cd_stop_yes_def)%
    . cdStopNo(m,c,a,d) <=> not cdStopYes(m,c,a,d) %(cd_stop_no_def)%
    . cdSound(m) <=>
        (forall f : VInput; t : VNat . cdInput3(f) /\ cdEmit(m,f,t) => vRefuted(f))
          %(cd_sound_def)%
    . cdTimely(m,a,d) <=>
        (forall f : VInput . cdInput3(f) /\ vRefuted(f) => cdStopYes(m,f,a,d))
          %(cd_timely_def)%
    . cdPass(m,a,d) <=> cdSound(m) /\ cdTimely(m,a,d) %(cd_pass_def)%
    . cdStopsCorrectly(m,a,d) <=>
         (forall f : VInput . cdInput3(f) => (cdStopYes(m,f,a,d) <=> vRefuted(f)))
          %(cd_correct_def)%

  forall j,k : VNat
    . vLe(j,vZ) <=> j=vZ %(cd_zero_segment)% %implied
    . vLe(j,vS(vZ)) <=> vLe(j,vZ) \/ j=vS(vZ)
          %(cd_next_base_at)% %implied
    . cdSegmentLaw(vZ) %(cd_segment_base)% %implied
    . cdSegmentLaw(k) =>
        (vLe(vS(j),vS(vS(k))) <=> vLe(vS(j),vS(k)) \/ vS(j)=vS(vS(k)))
          %(cd_next_s_at)% %implied
    . cdSegmentLaw(k) =>
        (vLe(j,vS(vS(k))) <=> vLe(j,vS(k)) \/ j=vS(vS(k)))
          %(cd_next_at)% %implied
    . cdSegmentLaw(k) => cdSegmentLaw(vS(k)) %(cd_segment_step)% %implied
    . cdSegmentLaw(k) %(cd_segments_all)% %implied
    . vLe(j,vS(k)) <=> vLe(j,k) \/ j=vS(k) %(cd_next_segment)% %implied

  forall m : CDMachine; c : VInput; t : VNat
    . cdLatch(m,c,vZ) <=> (exists q : VNat . vLe(q,vZ) /\ cdEmit(m,c,q))
          %(cd_zero_emit_exact)% %implied
    . cdLatchLaw(vZ) %(cd_latch_base)% %implied
    . cdLatchLaw(t) =>
        (cdLatch(m,c,vS(t)) <=> (exists q : VNat . vLe(q,vS(t)) /\ cdEmit(m,c,q)))
          %(cd_latch_step_at)% %implied
    . cdLatchLaw(t) => cdLatchLaw(vS(t)) %(cd_latch_step)% %implied
    . cdLatchLaw(t) %(cd_latch_all)% %implied
    . cdLatch(m,c,t) <=> (exists q : VNat . vLe(q,t) /\ cdEmit(m,c,q))
          %(cd_latch_exact)% %implied

  forall m : CDMachine; c : VInput; a,d : VNat
    . cdStopYes(m,c,a,d) <=>
        (exists q : VNat . vLe(q,cdBudget(c,a,d)) /\ cdEmit(m,c,q))
          %(cd_affirmative_by_exact_clock)% %implied
    . cdSound(m) /\ cdInput3(c) /\ cdStopYes(m,c,a,d) => vRefuted(c)
          %(cd_sound_latched_report)% %implied
    . cdPass(m,a,d) /\ cdInput3(c) /\ vRefuted(c) => cdStopYes(m,c,a,d)
          %(cd_complete_by_frozen_clock)% %implied
    . cdPass(m,a,d) /\ cdInput3(c) => (cdStopYes(m,c,a,d) <=> vRefuted(c))
          %(cd_pass_decides_at_one_clock)% %implied
    . cdPass(m,a,d) => cdStopsCorrectly(m,a,d)
          %(cd_monitor_to_stopped_decider)% %implied
    . cdSound(m) /\ cdStopsCorrectly(m,a,d) => cdPass(m,a,d)
          %(cd_sound_decider_to_monitor)% %implied
    . cdSound(m) => (cdPass(m,a,d) <=> cdStopsCorrectly(m,a,d))
          %(cd_fixed_machine_equivalence)% %implied
    . cdPass(m,a,d) /\ cdInput3(c) => (cdStopNo(m,c,a,d) <=>
        (exists w : VWord . vModel(c,w))) %(cd_deadline_silence_decodes_sat)% %implied
  . (exists m : CDMachine; a,d : VNat . cdPass(m,a,d)) <=>
        (exists m : CDMachine; a,d : VNat . cdSound(m) /\ cdStopsCorrectly(m,a,d))
          %(cd_uniform_exists_equivalence)% %implied
end

%% ceTotal is the fibrewise totality of the selected original failed occurrence
%% and its all-degree contraction.  The geometric proof identifies this totality
%% with equivalence over the fixed X.  The deadline does not inspect sample fibres.
spec FixedCechClock = FixedMonitorClock and OriginalCechFibre then
  preds cdCechSound : CDMachine;
        cdCechTimely, cdCechPass : CDMachine * VNat * VNat
  forall m : CDMachine; c : VInput; a,d : VNat
    . cdCechSound(m) <=>
        (forall f : VInput; t : VNat . cdInput3(f) /\ cdEmit(m,f,t) => ceTotal(f))
          %(cd_cech_sound_def)%
    . cdCechTimely(m,a,d) <=>
        (forall f : VInput . cdInput3(f) /\ ceTotal(f) => cdStopYes(m,f,a,d))
          %(cd_cech_timely_def)%
    . cdCechPass(m,a,d) <=> cdCechSound(m) /\ cdCechTimely(m,a,d)
          %(cd_cech_pass_def)%
    . cdCechSound(m) <=> cdSound(m) %(cd_cech_sound_exact)% %implied
    . cdCechTimely(m,a,d) <=> cdTimely(m,a,d) %(cd_cech_timely_exact)% %implied
    . cdCechPass(m,a,d) <=> cdPass(m,a,d) %(cd_cech_pass_exact)% %implied
    . cdCechPass(m,a,d) /\ cdInput3(c) =>
        (cdStopYes(m,c,a,d) <=> ceTotal(c)) %(cd_cech_acceptance_exact)% %implied
    . cdCechPass(m,a,d) /\ cdInput3(c) =>
        (cdStopNo(m,c,a,d) <=> (exists w : VWord . vModel(c,w)))
          %(cd_cech_no_is_sat)% %implied
  . (exists m : CDMachine; a,d : VNat . cdCechPass(m,a,d)) <=>
        (exists m : CDMachine; a,d : VNat . cdSound(m) /\ cdStopsCorrectly(m,a,d))
          %(cd_frozen_cech_clock_equivalence)% %implied
end

%% An ordinary terminating decider has two answer states.  The monitor
%% projection retains only its UNSAT answer.  For actual programs it can be
%% implemented by relabeling terminal states and retaining the same input.
%% Printing a contractible-fibre selector adds bounded polynomial overhead.
spec OrdinaryDecisionProjection = FixedCechClock then
  sort CDDecision
  free type CDAnswer ::= cdPending | cdUnsat | cdSat
  ops cdAnswer : CDDecision * VInput * VNat -> CDAnswer;
      cdAsMonitor : CDDecision -> CDMachine
  preds cdAnswersSoundly : CDDecision;
        cdAnswersInTime, cdOrdinaryDecides : CDDecision * VNat * VNat

  forall h : CDDecision; c : VInput; t,a,d : VNat
    . cdEmit(cdAsMonitor(h),c,t) <=> cdAnswer(h,c,t)=cdUnsat
          %(cd_projection_trace)%
    . cdAnswersSoundly(h) <=>
        (forall f : VInput; s : VNat . cdInput3(f) =>
          ((cdAnswer(h,f,s)=cdUnsat => vRefuted(f)) /\
           (cdAnswer(h,f,s)=cdSat => not vRefuted(f))))
          %(cd_decider_sound_def)%
    . cdAnswersInTime(h,a,d) <=>
        (forall f : VInput . cdInput3(f) =>
          (exists s : VNat . vLe(s,cdBudget(f,a,d)) /\
             (cdAnswer(h,f,s)=cdUnsat \/ cdAnswer(h,f,s)=cdSat)))
          %(cd_decider_time_def)%
    . cdOrdinaryDecides(h,a,d) <=> cdAnswersSoundly(h) /\ cdAnswersInTime(h,a,d)
          %(cd_ordinary_decider_def)%

  forall h : CDDecision; c : VInput; t,a,d : VNat
    . cdAnswersSoundly(h) /\ cdInput3(c) /\ cdAnswer(h,c,t)=cdUnsat => vRefuted(c)
          %(cd_unsat_answer_sound)% %implied
    . cdAnswersSoundly(h) /\ cdInput3(c) /\ vRefuted(c) => not cdAnswer(h,c,t)=cdSat
          %(cd_sat_answer_impossible_on_unsat)% %implied
    . cdAnswersSoundly(h) => cdSound(cdAsMonitor(h))
          %(cd_projection_sound)% %implied
    . cdOrdinaryDecides(h,a,d) /\ cdInput3(c) /\ vRefuted(c) =>
        (exists s : VNat . vLe(s,cdBudget(c,a,d)) /\ cdAnswer(h,c,s)=cdUnsat)
          %(cd_ordinary_unsat_answer_by_clock)% %implied
    . cdOrdinaryDecides(h,a,d) /\ cdInput3(c) /\ vRefuted(c) =>
        cdStopYes(cdAsMonitor(h),c,a,d) %(cd_projected_answer_by_clock)% %implied
    . cdOrdinaryDecides(h,a,d) => cdTimely(cdAsMonitor(h),a,d)
          %(cd_projection_timely)% %implied
    . cdOrdinaryDecides(h,a,d) => cdCechPass(cdAsMonitor(h),a,d)
          %(cd_ordinary_decider_to_cech_monitor)% %implied
  . (exists h : CDDecision; a,d : VNat . cdOrdinaryDecides(h,a,d)) =>
      (exists m : CDMachine; a,d : VNat . cdCechPass(m,a,d))
          %(cd_exists_decider_to_exists_cech_monitor)% %implied
end

%% The wire used as the extra-degeneracy selector is the original clause
%% occurrence. No relabeling of the covered object is used by this bridge.
spec CechGateReturn = OriginalCechFibre and OriginalSelectorSlack and FredkinToffoliClauseSelector then
  forall c : VInput; x : CEPoint; j : VNat; l : CEList
    . rgOneHot(vFormula(c),ceWord(c,x),j) = fone <=> slResult(c,ceWord(c,x)) = slFailed(j)
          %(cr_gate_iff_original_selector)% %implied
    . rgOneHot(vFormula(c),ceWord(c,x),j) = fone =>
         ceFails(c,x,j) /\ ceLeast(c,x) = j %(cr_gate_returns_original_least_failure)% %implied
    . rgOneHot(vFormula(c),ceWord(c,x),ceLeast(c,x)) = fone <=> not vModel(c,ceWord(c,x))
          %(cr_gate_armed_at_point_iff_nonmodel)% %implied
    . rgOneHot(vFormula(c),ceWord(c,x),j) = fone => ceExtra(c,x,l) = ceCons(j,l)
          %(cr_gate_is_exact_extra_degeneracy)% %implied
    . (exists j : VNat . rgOneHot(vFormula(c),ceWord(c,x),j) = fone) <=>
          ceValid(c,x,ceExtra(c,x,ceEmpty)) %(cr_fibre_return_equivalent_at_point)% %implied
  forall c : VInput
    . (forall x : CEPoint . exists j : VNat . rgOneHot(vFormula(c),ceWord(c,x),j) = fone)
          <=> vRefuted(c) %(cr_global_gate_total_iff_original_unsat)% %implied
  forall c : VInput; x : CEPoint; z : SLView; j : VNat
    . slPossible(c,z,slFailed(j)) <=>
        (exists a : VWord . slAllows(z,a) /\ vLen(a) = vWidth(c) /\
            rgOneHot(vFormula(c),a,j) = fone) %(cr_possible_gate_indices_exact)% %implied
end

%% ITZ is interpreted as ordinary Z. The finite cuts and arithmetic also make
%% sense in Z_2; the global lift must have its base point in Z for this test.
%% A sequence is indexed by the free naturals VNat. itLift means that the
%% coherent system of finite prefix residues has a single integer lift.
spec IntegerTelescopeGluing = FixedVerifierMinimum then
  sorts ITZ, ITStream
  free type ITCut ::= itLast(ITZ) | itCons(ITZ; ITCut)
  ops it0, it1 : ITZ;
      itAdd : ITZ * ITZ -> ITZ;
      itDouble, itQuad : ITZ -> ITZ;
      itPush : ITZ * ITZ -> ITZ;
      itAt : ITStream * VNat -> ITZ;
      itAfter : VNat * VNat -> VNat;
      itSum : ITStream * VNat * VNat -> ITZ;
      itScale : VNat * ITZ -> ITZ;
      itBack : ITStream * VNat * VNat * ITZ -> ITZ;
      itFirst : ITCut -> ITZ;
      itSolve : ITStream * VNat * VNat * ITZ -> ITCut;
      itCochain : ITStream * ITZ -> ITStream;
      itZeroStream : ITStream
  preds itStep, itPair : ITZ * ITZ * ITZ;
        itRun : ITStream * ITStream * VNat * VNat;
        itCutOK : ITStream * VNat * VNat * ITZ * ITCut;
        itResidue : ITStream * VNat * VNat * ITZ;
        itLift : ITStream * ITZ;
        itEvery : ITStream * ITStream;
        itIntegerGluing : ITStream;
        itAfterLaw, itAfterZeroLaw, itDecomposeLaw, itUniquenessLaw,
        itOverlapLaw, itFiniteLaw, itRunLaw, itZeroScaleLaw : VNat

  forall x,y,z : ITZ
    . itAdd(it0,x) = x %(it_zero_left)%
    . itAdd(x,it0) = x %(it_zero_right)%
    . itAdd(itAdd(x,y),z) = itAdd(x,itAdd(y,z)) %(it_add_assoc)%
    . itAdd(x,y) = itAdd(y,x) %(it_add_comm)%
    . itAdd(x,y) = itAdd(x,z) => y = z %(it_cancel_left)%
    . itDouble(x) = itAdd(x,x) %(it_double_def)%
    . itDouble(itAdd(x,y)) = itAdd(itDouble(x),itDouble(y)) %(it_double_distributes)%
    . itDouble(x) = itDouble(y) => x = y %(it_double_injective)%
    . itQuad(x) = itDouble(itDouble(x)) %(it_quad_def)%
    . itPush(x,y) = itAdd(x,itDouble(y)) %(it_push_def)%
    . itStep(x,y,z) <=> y = itPush(x,z) %(it_step_def)%
    . itPair(x,y,z) <=> y = itAdd(x,itQuad(z)) %(it_pair_def)%

  forall a,b : ITStream; i,k : VNat; x,z : ITZ; l : ITCut
    . itAfter(i,vZ) = i %(it_after_base)%
    . itAfter(i,vS(k)) = itAfter(vS(i),k) %(it_after_head_step)%
    . itSum(a,i,vZ) = it0 %(it_sum_base)%
    . itSum(a,i,vS(k)) = itPush(itAt(a,i),itSum(a,vS(i),k)) %(it_sum_step)%
    . itScale(vZ,x) = x %(it_scale_base)%
    . itScale(vS(k),x) = itDouble(itScale(k,x)) %(it_scale_step)%
    . itBack(a,i,vZ,x) = x %(it_back_base)%
    . itBack(a,i,vS(k),x) = itPush(itAt(a,i),itBack(a,vS(i),k,x))
        %(it_back_step)%
    . itRun(a,b,i,vZ) %(it_run_base)%
    . itRun(a,b,i,vS(k)) <=>
        (itStep(itAt(a,i),itAt(b,i),itAt(b,vS(i))) /\ itRun(a,b,vS(i),k))
        %(it_run_step)%
    . itFirst(itLast(x)) = x %(it_first_last)%
    . itFirst(itCons(x,l)) = x %(it_first_cons)%
    . itSolve(a,i,vZ,z) = itLast(z) %(it_solve_base)%
    . itSolve(a,i,vS(k),z) =
        itCons(itPush(itAt(a,i),itFirst(itSolve(a,vS(i),k,z))),itSolve(a,vS(i),k,z))
        %(it_solve_step)%
    . itCutOK(a,i,vZ,z,itLast(z)) %(it_cut_ok_last)%
  forall a : ITStream; i,k : VNat; x,z : ITZ; l : ITCut
    . itCutOK(a,i,vS(k),z,itCons(x,l)) <=>
        (itStep(itAt(a,i),x,itFirst(l)) /\ itCutOK(a,vS(i),k,z,l))
        %(it_cut_ok_cons)%
    . itResidue(a,i,k,x) <=> (exists t : ITZ . x = itBack(a,i,k,t))
        %(it_residue_def)%
    . itLift(a,x) <=> (forall d : VNat . itResidue(a,vZ,d,x)) %(it_lift_def)%
    %% The residual integer is unique (derived below). In the standard
    %% interpretation itCochain(a,x)[d] is that residual when it exists,
    %% and zero when x has no lift of that one finite cut.
    . itResidue(a,vZ,k,x) => x = itBack(a,vZ,k,itAt(itCochain(a,x),k))
        %(it_quotient_section)%
  forall k : VNat
    . itAt(itZeroStream,k) = it0 %(it_zero_stream_def)%
  forall a,b : ITStream
    . itEvery(a,b) <=> (forall k : VNat . itStep(itAt(a,k),itAt(b,k),itAt(b,vS(k))))
        %(it_every_def)%
    . itIntegerGluing(a) <=> (exists c : ITStream . itEvery(a,c))
        %(it_gluing_def)%

  %% Scheme instances of structural induction on the free naturals.
  forall k : VNat
    . itZeroScaleLaw(k) <=> itScale(k,it0) = it0 %(it_zero_scale_invariant)%
    . itAfterLaw(k) <=> (forall i : VNat . itAfter(i,vS(k)) = vS(itAfter(i,k)))
        %(it_after_invariant)%
    . itAfterZeroLaw(k) <=> itAfter(vZ,k) = k %(it_after_zero_invariant)%
    . itDecomposeLaw(k) <=> (forall a : ITStream; i : VNat; z : ITZ .
        itBack(a,i,k,z) = itAdd(itSum(a,i,k),itScale(k,z)))
        %(it_decompose_invariant)%
    . itUniquenessLaw(k) <=> (forall a : ITStream; i : VNat; x,z : ITZ .
        itBack(a,i,k,x) = itBack(a,i,k,z) => x = z) %(it_uniqueness_invariant)%
    . itOverlapLaw(k) <=> (forall a : ITStream; i : VNat; z : ITZ .
        itBack(a,i,vS(k),z) = itBack(a,i,k,itPush(itAt(a,itAfter(i,k)),z)))
        %(it_overlap_invariant)%
    . itFiniteLaw(k) <=> (forall a : ITStream; i : VNat; z : ITZ .
        itCutOK(a,i,k,z,itSolve(a,i,k,z)) /\ itFirst(itSolve(a,i,k,z)) = itBack(a,i,k,z))
        %(it_finite_invariant)%
    . itRunLaw(k) <=> (forall a,b : ITStream; i : VNat .
        (itEvery(a,b) => itRun(a,b,i,k)) /\
        (itRun(a,b,i,k) => itAt(b,i) = itBack(a,i,k,itAt(b,itAfter(i,k)))))
        %(it_run_invariant)%
  . (itZeroScaleLaw(vZ) /\ (forall k : VNat . itZeroScaleLaw(k) => itZeroScaleLaw(vS(k))))
        => (forall k : VNat . itZeroScaleLaw(k)) %(it_induct_zero_scale)%
  . (itAfterLaw(vZ) /\ (forall k : VNat . itAfterLaw(k) => itAfterLaw(vS(k))))
        => (forall k : VNat . itAfterLaw(k)) %(it_induct_after)%
  . (itAfterZeroLaw(vZ) /\ (forall k : VNat . itAfterZeroLaw(k) => itAfterZeroLaw(vS(k))))
        => (forall k : VNat . itAfterZeroLaw(k)) %(it_induct_after_zero)%
  . (itDecomposeLaw(vZ) /\ (forall k : VNat . itDecomposeLaw(k) => itDecomposeLaw(vS(k))))
        => (forall k : VNat . itDecomposeLaw(k)) %(it_induct_decompose)%
  . (itUniquenessLaw(vZ) /\ (forall k : VNat . itUniquenessLaw(k) => itUniquenessLaw(vS(k))))
        => (forall k : VNat . itUniquenessLaw(k)) %(it_induct_unique)%
  . (itOverlapLaw(vZ) /\ (forall k : VNat . itOverlapLaw(k) => itOverlapLaw(vS(k))))
        => (forall k : VNat . itOverlapLaw(k)) %(it_induct_overlap)%
  . (itFiniteLaw(vZ) /\ (forall k : VNat . itFiniteLaw(k) => itFiniteLaw(vS(k))))
        => (forall k : VNat . itFiniteLaw(k)) %(it_induct_finite)%
  . (itRunLaw(vZ) /\ (forall k : VNat . itRunLaw(k) => itRunLaw(vS(k))))
        => (forall k : VNat . itRunLaw(k)) %(it_induct_run)%

  forall x,y,z,w : ITZ
    . itAdd(it0,it0) = it0 %(it_zero_sum)% %implied
    . itPush(x,it0) = x %(it_push_zero)% %implied
    . itPush(it0,x) = itDouble(x) %(it_push_zero_mark)% %implied
    . itPush(x,y) = itPush(x,z) => y = z %(it_push_cancels)% %implied
    . itPush(x,itAdd(y,z)) = itAdd(itPush(x,y),itDouble(z))
        %(it_push_distributes_scale)% %implied
    . itStep(it0,x,y) <=> x = itDouble(y) %(it_odd_zero_equation)% %implied
    . itStep(x,y,z) /\ itStep(it0,z,w) => itPair(x,y,w) %(it_two_steps_to_pair)% %implied
    . itPair(x,y,w) => itStep(x,y,itDouble(w)) %(it_pair_reconstructs_even)% %implied
    . itStep(it0,itDouble(w),w) %(it_pair_reconstructs_odd)% %implied
    . itPair(x,y,w) <=> (exists t : ITZ . itStep(x,y,t) /\ itStep(it0,t,w))
        %(it_two_steps_iff_pair)% %implied
    . itStep(it0,z,w) => z = itDouble(w) %(it_unique_odd_reconstruction)% %implied

  forall a,b : ITStream; i,k : VNat; x,z : ITZ
    . itAfterLaw(vZ) %(it_after_invariant_base)% %implied
    . itAfterLaw(k) => itAfterLaw(vS(k)) %(it_after_invariant_step)% %implied
    . itAfter(i,vS(k)) = vS(itAfter(i,k)) %(it_after_tail_step)% %implied
    . itAfterZeroLaw(vZ) %(it_after_zero_base)% %implied
    . itAfterZeroLaw(k) => itAfterZeroLaw(vS(k)) %(it_after_zero_step)% %implied
    . itAfter(vZ,k) = k %(it_after_zero)% %implied
    . itDecomposeLaw(vZ) %(it_decompose_base)% %implied
    . itDecomposeLaw(k) => itDecomposeLaw(vS(k)) %(it_decompose_step)% %implied
    . itBack(a,i,k,z) = itAdd(itSum(a,i,k),itScale(k,z)) %(it_back_decomposes)% %implied
    . itUniquenessLaw(vZ) %(it_unique_base)% %implied
    . itUniquenessLaw(k) => itUniquenessLaw(vS(k)) %(it_unique_step)% %implied
    . itBack(a,i,k,x) = itBack(a,i,k,z) => x = z %(it_back_terminal_unique)% %implied
    . itOverlapLaw(vZ) %(it_overlap_base)% %implied
    . itOverlapLaw(k) => itOverlapLaw(vS(k)) %(it_overlap_step)% %implied
    . itBack(a,i,vS(k),z) = itBack(a,i,k,itPush(itAt(a,itAfter(i,k)),z))
        %(it_back_overlap)% %implied
    . itBack(a,vZ,vS(k),z) = itBack(a,vZ,k,itPush(itAt(a,k),z))
        %(it_back_overlap_zero)% %implied
    . itBack(a,i,vS(k),it0) =
        itAdd(itSum(a,i,k),itScale(k,itAt(a,itAfter(i,k))))
        %(it_zero_terminal_extension_adds_next_mark)% %implied
    . itBack(a,i,vS(k),it0) = itBack(a,i,k,it0) <=> itAt(a,itAfter(i,k)) = it0
        %(it_zero_terminal_cuts_agree_iff_next_mark_zero)% %implied
    . itAt(a,vS(i)) = it0 => itBack(a,i,vS(vS(k)),z) =
        itAdd(itAt(a,i),itQuad(itBack(a,vS(vS(i)),k,z))) %(it_pair_back_step)% %implied
    . itFiniteLaw(vZ) %(it_finite_base)% %implied
    . itFiniteLaw(k) => itFiniteLaw(vS(k)) %(it_finite_step)% %implied
    . itCutOK(a,i,k,z,itSolve(a,i,k,z)) %(it_finite_cut_always_solvable)% %implied
    . itZeroScaleLaw(vZ) %(it_zero_scale_base)% %implied
    . itZeroScaleLaw(k) => itZeroScaleLaw(vS(k)) %(it_zero_scale_step)% %implied
    . itScale(k,it0) = it0 %(it_zero_scale)% %implied
    . itFirst(itSolve(a,i,k,it0)) = itSum(a,i,k)
        %(it_zero_terminal_returns_prefix)% %implied
    . itRunLaw(vZ) %(it_run_invariant_base)% %implied
    . itRunLaw(k) => itRunLaw(vS(k)) %(it_run_invariant_step)% %implied
    . itEvery(a,b) => itRun(a,b,i,k) %(it_global_restricts_to_every_cut)% %implied
    . itRun(a,b,i,k) => itAt(b,i) = itBack(a,i,k,itAt(b,itAfter(i,k)))
        %(it_cut_telescope)% %implied
    . itRun(a,b,i,k) =>
       itAt(b,i) = itAdd(itSum(a,i,k),itScale(k,itAt(b,itAfter(i,k))))
        %(it_telescoping_prefix_equation)% %implied
    . itResidue(a,i,k,x) <=> (exists t : ITZ . x = itAdd(itSum(a,i,k),itScale(k,t)))
        %(it_residue_is_prefix_congruence)% %implied

    . itResidue(a,i,vS(k),x) => itResidue(a,i,k,x) %(it_residue_restricts)% %implied
    . itEvery(a,b) => itResidue(a,vZ,k,itAt(b,vZ)) %(it_global_pointwise_residue)% %implied
    . itEvery(a,b) => itLift(a,itAt(b,vZ)) %(it_global_yields_integer_lift)% %implied
    . itLift(a,x) => x = itBack(a,vZ,k,itAt(itCochain(a,x),k))
        %(it_integer_lift_residual_at_cut)% %implied
    . itLift(a,x) => itAt(itCochain(a,x),k) =
        itPush(itAt(a,k),itAt(itCochain(a,x),vS(k))) %(it_cochain_equation_from_quotients)% %implied
    . itLift(a,x) =>
        itStep(itAt(a,k),itAt(itCochain(a,x),k),itAt(itCochain(a,x),vS(k)))
        %(it_cochain_pointwise_step)% %implied
    . itLift(a,x) => itEvery(a,itCochain(a,x)) %(it_integer_lift_constructs_cochain)% %implied
    . itLift(a,x) => itAt(itCochain(a,x),vZ) = x %(it_cochain_has_original_integer_lift)% %implied
    . itEvery(a,b) /\ itAt(b,vZ) = x =>
        itAt(b,k) = itAt(itCochain(a,x),k) %(it_global_pointwise_quotient_unique)% %implied
    . itIntegerGluing(a) <=> (exists t : ITZ . itLift(a,t)) %(it_integer_lift_iff_gluing)% %implied
    . itAt(a,k) = it0 => itStep(itAt(a,k),itAt(itZeroStream,k),itAt(itZeroStream,vS(k)))
        %(it_zero_step)% %implied
    . (forall d : VNat . itAt(a,d) = it0) => itEvery(a,itZeroStream)
        %(it_zero_stream_solves)% %implied
    . (forall d : VNat . itAt(a,d) = it0) => itIntegerGluing(a)
        %(it_zero_marks_glue)% %implied
end


%% Least significant bit first. tdIndex(w,h) is the value of w plus
%% 2^(length(w))*h, so h indexes complete periods without a materialized
%% truth table. tdMark(c,n) is the signed integer cochain's binary mark.
spec PaddedTelescopeDigits = NativeRoot and NativeTileProof then
  ops tdDouble, tdHalf : VNat -> VNat;
      tdIndex : VWord * VNat -> VNat;
      tdLow : VNat * VNat -> VWord;
      tdEval, tdMark : VInput * VNat -> FBit
  preds tdEven : VNat;
        tdHalfLaw, tdOrderLaw, tdWeakLaw, tdWidthLaw : VNat;
        tdWordLaw : VWord;
        tdZeroMarks, tdEventuallyConstant : VInput;
        tdHasLaterBit : VInput * VNat * FBit

  . tdDouble(vZ) = vZ %(td_double_zero)%
  . tdHalf(vZ) = vZ %(td_half_zero)%
  . tdHalf(vS(vZ)) = vZ %(td_half_one)%
  . tdEven(vZ) %(td_even_zero)%
  . not tdEven(vS(vZ)) %(td_even_one)%
  . not (exists b : FBit . fzero = b /\ b = fone) %(td_distinct_bits)%
  forall n : VNat
    . n = vZ \/ (exists i : VNat . n = vS(i)) %(td_nat_cases)%
    . tdDouble(vS(n)) = vS(vS(tdDouble(n))) %(td_double_succ)%
    . tdHalf(vS(vS(n))) = vS(tdHalf(n)) %(td_half_two)%
    . tdEven(vS(vS(n))) <=> tdEven(n) %(td_even_two)%
    . tdHalfLaw(n) <=>
          tdHalf(tdDouble(n)) = n /\ tdHalf(vS(tdDouble(n))) = n /\
          tdEven(tdDouble(n)) /\ not tdEven(vS(tdDouble(n))) %(td_half_invariant)%
    . tdWeakLaw(n) <=> (forall j : VNat . vLe(n,j) => vLe(n,vS(j))) %(td_weak_invariant)%
    . tdOrderLaw(n) <=> (forall j : VNat . vLe(n,j) =>
          vLe(n,tdDouble(j)) /\ vLe(n,vS(tdDouble(j)))) %(td_order_invariant)%
    . tdWidthLaw(n) <=> (forall j : VNat . vLen(tdLow(n,j)) = n)
          %(td_width_invariant)%
  forall n,j : VNat
    . tdLow(vZ,j) = vNil %(td_low_empty)%
    . tdEven(j) => tdLow(vS(n),j) = vZero(tdLow(n,tdHalf(j))) %(td_low_zero)%
    . not tdEven(j) => tdLow(vS(n),j) = vOne(tdLow(n,tdHalf(j))) %(td_low_one)%
  forall w : VWord; j : VNat
    . tdIndex(vNil,j) = j %(td_index_empty)%
    . tdIndex(vZero(w),j) = tdDouble(tdIndex(w,j)) %(td_index_zero)%
    . tdIndex(vOne(w),j) = vS(tdDouble(tdIndex(w,j))) %(td_index_one)%
    . tdWordLaw(w) <=> (forall h : VNat .
          tdLow(vLen(w),tdIndex(w,h)) = w /\ vLe(h,tdIndex(w,h)))
          %(td_word_invariant)%
  forall c : VInput; j,k : VNat; d : FBit
    . tdEval(c,j) = fone <=> vModel(c,tdLow(vWidth(c),j)) %(td_eval_one)%
    . tdEval(c,j) = fzero <=> not vModel(c,tdLow(vWidth(c),j)) %(td_eval_zero)%
    . tdEven(j) => tdMark(c,j) = tdEval(c,tdHalf(j)) %(td_mark_even)%
    . not tdEven(j) => tdMark(c,j) = fzero %(td_mark_odd)%
    . tdHasLaterBit(c,k,d) <=>
          (exists i : VNat . vLe(k,i) /\ tdMark(c,i) = d) %(td_later_def)%
    . tdZeroMarks(c) <=> (forall i : VNat . tdMark(c,i) = fzero) %(td_zero_def)%
    . tdEventuallyConstant(c) <=>
          (exists h : VNat; b : FBit .
              forall i : VNat . vLe(h,i) => tdMark(c,i) = b) %(td_eventual_def)%

  %% Instances of induction for the free VNat and VWord datatypes.
  . (tdHalfLaw(vZ) /\ (forall i : VNat . tdHalfLaw(i) => tdHalfLaw(vS(i))))
     => (forall i : VNat . tdHalfLaw(i)) %(td_half_induction)%
  . (tdWeakLaw(vZ) /\ (forall i : VNat . tdWeakLaw(i) => tdWeakLaw(vS(i))))
     => (forall i : VNat . tdWeakLaw(i)) %(td_weak_induction)%
  . (tdOrderLaw(vZ) /\ (forall i : VNat . tdOrderLaw(i) => tdOrderLaw(vS(i))))
     => (forall i : VNat . tdOrderLaw(i)) %(td_order_induction)%
  . (tdWidthLaw(vZ) /\ (forall i : VNat . tdWidthLaw(i) => tdWidthLaw(vS(i))))
     => (forall i : VNat . tdWidthLaw(i)) %(td_width_induction)%
  . (tdWordLaw(vNil) /\ (forall w : VWord .
         tdWordLaw(w) => tdWordLaw(vZero(w)) /\ tdWordLaw(vOne(w))))
     => (forall w : VWord . tdWordLaw(w)) %(td_word_induction)%

  forall n,j : VNat
    . tdHalfLaw(vZ) %(td_half_base)% %implied
    . tdHalf(tdDouble(vS(n))) = vS(tdHalf(tdDouble(n))) %(td_half_even_shift)% %implied
    . tdHalf(vS(tdDouble(vS(n)))) = vS(tdHalf(vS(tdDouble(n)))) %(td_half_odd_shift)% %implied
    . tdHalfLaw(n) => tdHalf(tdDouble(vS(n))) = vS(n) %(td_half_step_even_value)% %implied
    . tdHalfLaw(n) => tdHalf(vS(tdDouble(vS(n)))) = vS(n) %(td_half_step_odd_value)% %implied
    . tdHalfLaw(n) => tdEven(tdDouble(vS(n))) %(td_half_step_even_parity)% %implied
    . tdHalfLaw(n) => not tdEven(vS(tdDouble(vS(n)))) %(td_half_step_odd_parity)% %implied
    . tdHalfLaw(n) => tdHalfLaw(vS(n)) %(td_half_step)% %implied
    . tdHalfLaw(n) %(td_half_all)% %implied
    . tdHalf(tdDouble(n)) = n %(td_even_half)% %implied
    . tdHalf(vS(tdDouble(n))) = n %(td_odd_half)% %implied
    . tdEven(tdDouble(n)) %(td_even_at_double)% %implied
    . not tdEven(vS(tdDouble(n))) %(td_odd_at_double_plus_one)% %implied

    . tdWeakLaw(vZ) %(td_weak_base)% %implied
    . tdWeakLaw(n) /\ vLe(n,j) => vLe(n,vS(j)) %(td_weak_at)% %implied
    . tdWeakLaw(n) /\ vLe(vS(n),vS(j)) => vLe(vS(n),vS(vS(j)))
          %(td_weak_succ)% %implied
    . tdWeakLaw(n) => tdWeakLaw(vS(n)) %(td_weak_step)% %implied
    . tdWeakLaw(n) %(td_weak_all)% %implied
    . vLe(n,j) => vLe(n,vS(j)) %(td_weak_grows)% %implied

    . tdOrderLaw(vZ) %(td_order_base)% %implied
    . tdOrderLaw(n) /\ vLe(n,j) =>
          vLe(n,tdDouble(j)) /\ vLe(n,vS(tdDouble(j))) %(td_order_at)% %implied
    . tdOrderLaw(n) /\ vLe(vS(n),vS(j)) =>
          vLe(vS(n),tdDouble(vS(j))) /\ vLe(vS(n),vS(tdDouble(vS(j))))
          %(td_order_step_succ)% %implied
    . tdOrderLaw(n) => tdOrderLaw(vS(n)) %(td_order_step)% %implied
    . tdOrderLaw(n) %(td_order_all)% %implied
    . vLe(n,j) => vLe(n,tdDouble(j)) /\ vLe(n,vS(tdDouble(j))) %(td_double_weakly_grows)% %implied
    . vLe(n,n) %(td_refl)% %implied

    . tdWidthLaw(vZ) %(td_width_base)% %implied
    . tdWidthLaw(n) => vLen(tdLow(n,j)) = n %(td_width_at)% %implied
    . tdWidthLaw(n) => vLen(tdLow(vS(n),j)) = vS(n) %(td_width_step_at)% %implied
    . tdWidthLaw(n) => tdWidthLaw(vS(n)) %(td_width_step)% %implied
    . tdWidthLaw(n) %(td_width_all)% %implied
    . vLen(tdLow(n,j)) = n %(td_low_exact_width)% %implied

  forall w : VWord; h : VNat
    . tdWordLaw(vNil) %(td_word_base)% %implied
    . tdWordLaw(w) => tdLow(vLen(w),tdIndex(w,h)) = w %(td_word_recover_at)% %implied
    . tdWordLaw(w) => vLe(h,tdIndex(w,h)) %(td_word_order_at)% %implied
    . tdWordLaw(w) =>
          tdLow(vLen(vZero(w)),tdIndex(vZero(w),h)) = vZero(w)
          %(td_word_recover_zero)% %implied
    . tdWordLaw(w) =>
          tdLow(vLen(vOne(w)),tdIndex(vOne(w),h)) = vOne(w)
          %(td_word_recover_one)% %implied
    . tdWordLaw(w) => vLe(h,tdIndex(vZero(w),h)) %(td_word_order_zero)% %implied
    . tdWordLaw(w) => vLe(h,tdIndex(vOne(w),h)) %(td_word_order_one)% %implied
    . tdWordLaw(w) => tdWordLaw(vZero(w)) %(td_word_zero_step)% %implied
    . tdWordLaw(w) => tdWordLaw(vOne(w)) %(td_word_one_step)% %implied
    . tdWordLaw(w) => tdWordLaw(vZero(w)) /\ tdWordLaw(vOne(w)) %(td_word_step)% %implied
    . tdWordLaw(w) %(td_word_all)% %implied
    . tdLow(vLen(w),tdIndex(w,h)) = w %(td_recovers_original_address)% %implied
    . vLe(h,tdIndex(w,h)) %(td_quotient_below_index)% %implied

  forall c : VInput; w : VWord; h,j : VNat
    . tdMark(c,tdDouble(j)) = tdEval(c,j) %(td_even_cell)% %implied
    . tdMark(c,vS(tdDouble(j))) = fzero %(td_odd_cell)% %implied
    . vModel(c,w) => tdEval(c,tdIndex(w,h)) = fone %(td_encode_retains_original_model)% %implied
    . vModel(c,w) => tdMark(c,tdDouble(tdIndex(w,h))) = fone
          %(td_original_model_repeats_at_every_quotient)% %implied
    . vLe(h,tdDouble(tdIndex(w,h))) %(td_model_positions_are_cofinal)% %implied
    . vLe(h,vS(tdDouble(h))) %(td_padding_positions_are_cofinal)% %implied
    . tdHasLaterBit(c,h,fzero) %(td_later_zero)% %implied
    . vModel(c,w) => tdHasLaterBit(c,h,fone) %(td_original_model_supplies_later_one)% %implied
    . vRefuted(c) => not vModel(c,w) %(td_refuted_pointwise)% %implied
    . vRefuted(c) => tdEval(c,j) = fzero %(td_refuted_eval)% %implied
    . vRefuted(c) => tdMark(c,j) = fzero %(td_refuted_cell)% %implied
    . vRefuted(c) => tdZeroMarks(c) %(td_refuted_zero_marks)% %implied
    . tdZeroMarks(c) => tdEventuallyConstant(c) %(td_zero_is_eventual)% %implied
    . tdEventuallyConstant(c) => not vModel(c,w) %(td_eventual_rules_out_model)% %implied
    . tdEventuallyConstant(c) => vRefuted(c) %(td_eventual_refutes)% %implied
    . tdEventuallyConstant(c) <=> vRefuted(c) %(td_eventual_iff_refuted)% %implied
    . tdZeroMarks(c) <=> vRefuted(c) %(td_zero_marks_iff_refuted)% %implied
end


%% A natural index has a unique marked low word and a high quotient.
%% Moving the high quotient by one gives the next complete address period.
spec TelescopeAddressPeriod = PaddedTelescopeDigits then
  ops tdQuot, tdShiftPeriod : VNat * VNat -> VNat
  preds tdReassemble, tdSplitLaw : VNat

  forall j : VNat
    . tdReassemble(j) <=>
         ((tdEven(j) /\ j = tdDouble(tdHalf(j))) \/
          (not tdEven(j) /\ j = vS(tdDouble(tdHalf(j))))) %(tp_reassembly_def)%
    . tdSplitLaw(j) <=> (forall k : VNat .
         tdIndex(tdLow(j,k),tdQuot(j,k)) = k) %(tp_split_def)%
  forall n,j : VNat
    . tdQuot(vZ,j) = j %(tp_quot_empty)%
    . tdQuot(vS(n),j) = tdQuot(n,tdHalf(j)) %(tp_quot_step)%
    . tdShiftPeriod(n,j) = tdIndex(tdLow(n,j),vS(tdQuot(n,j))) %(tp_shift_def)%
  . (tdReassemble(vZ) /\ (forall j : VNat . tdReassemble(j) => tdReassemble(vS(j))))
     => (forall j : VNat . tdReassemble(j)) %(tp_reassembly_induction)%
  . (tdSplitLaw(vZ) /\ (forall j : VNat . tdSplitLaw(j) => tdSplitLaw(vS(j))))
     => (forall j : VNat . tdSplitLaw(j)) %(tp_split_induction)%

  forall j : VNat
    . tdReassemble(vZ) %(tp_reassembly_base)% %implied
    . tdReassemble(tdDouble(j)) %(tp_even_reassembly)% %implied
    . tdReassemble(vS(tdDouble(j))) %(tp_odd_reassembly)% %implied
    . tdReassemble(j) /\ tdEven(j) => tdReassemble(vS(j)) %(tp_even_to_odd)% %implied
    . tdReassemble(j) /\ not tdEven(j) => tdReassemble(vS(j)) %(tp_odd_to_even)% %implied
    . tdReassemble(j) => tdReassemble(vS(j)) %(tp_reassembly_step)% %implied
    . tdReassemble(j) %(tp_reassembly_all)% %implied
    . tdEven(j) => tdDouble(tdHalf(j)) = j %(tp_reassembly_even_at)% %implied
    . not tdEven(j) => vS(tdDouble(tdHalf(j))) = j %(tp_reassembly_odd_at)% %implied

  forall n,j,h : VNat; w : VWord
    . tdSplitLaw(vZ) %(tp_split_base)% %implied
    . tdSplitLaw(n) => tdIndex(tdLow(n,j),tdQuot(n,j)) = j %(tp_split_at)% %implied
    . tdSplitLaw(n) /\ tdEven(j) => tdIndex(tdLow(vS(n),j),tdQuot(vS(n),j)) = j
         %(tp_split_succ_even)% %implied
    . tdSplitLaw(n) /\ not tdEven(j) => tdIndex(tdLow(vS(n),j),tdQuot(vS(n),j)) = j
         %(tp_split_succ_odd)% %implied
    . tdSplitLaw(n) => tdIndex(tdLow(vS(n),j),tdQuot(vS(n),j)) = j %(tp_split_succ_at)% %implied
    . tdSplitLaw(n) => tdSplitLaw(vS(n)) %(tp_split_step)% %implied
    . tdSplitLaw(n) %(tp_split_all)% %implied
    . tdIndex(tdLow(n,j),tdQuot(n,j)) = j %(tp_original_index_roundtrip)% %implied
    . tdLow(n,tdShiftPeriod(n,j)) = tdLow(n,j) %(tp_shift_keeps_low_word)% %implied
  forall c : VInput; j : VNat
    . tdEval(c,tdShiftPeriod(vWidth(c),j)) = tdEval(c,j) %(tp_source_periodicity)% %implied
    . tdMark(c,tdDouble(tdShiftPeriod(vWidth(c),j))) = tdMark(c,tdDouble(j))
         %(tp_padded_periodicity)% %implied
end

%% The integer model uses tgBlock(p,r) for x |-> r + p*x, with the
%% multiplication order below. Words hold low digits first.
spec TelescopeAffineBlocks = IntegerTelescopeGluing and OriginalCutMatrix then
  free type TGBlock ::= tgBlock(ITZ; ITZ)
  ops tgMultiply : ITZ * ITZ -> ITZ;
      tgCompose : TGBlock * TGBlock -> TGBlock;
      tgApply : TGBlock * ITZ -> ITZ;
      tgDigit : FBit -> ITZ;
      tgBinary : FBit -> TGBlock;
      tgValue : VWord -> ITZ;
      tgNonzero : VWord -> FBit
  pred tgDigitLaw : VWord
  forall x,y,z : ITZ
    . tgMultiply(x,it0) = it0 %(tg_mul_rzero)%
    . tgMultiply(x,itAdd(y,z)) = itAdd(tgMultiply(x,y),tgMultiply(x,z))
          %(tg_distributivity)%
    . tgMultiply(tgMultiply(x,y),z) = tgMultiply(x,tgMultiply(y,z)) %(tg_mul_assoc)%
    . tgMultiply(itDouble(it1),x) = itDouble(x) %(tg_mul_two)%
    . (itQuad(x) = it0 <=> x = it0) %(tg_four_integral_injective_at_zero)%
    . not itAdd(it1,itQuad(x)) = it0 %(tg_one_mod_four)%
  forall b : FBit; x,y,p,q,r : ITZ; w : VWord
    . tgDigit(fzero) = it0 %(tg_digit_zero)%
    . tgDigit(fone) = it1 %(tg_digit_one)%
    . tgBinary(b) = tgBlock(itDouble(it1),tgDigit(b)) %(tg_binary_def)%
    . tgApply(tgBlock(p,x),r) = itAdd(x,tgMultiply(p,r)) %(tg_apply_def)%
    . tgCompose(tgBlock(p,x),tgBlock(q,y)) =
          tgBlock(tgMultiply(p,q),itAdd(x,tgMultiply(p,y))) %(tg_compose_def)%
    . tgValue(vNil) = it0 %(tg_value_empty)%
    . tgValue(vZero(w)) = itQuad(tgValue(w)) %(tg_value_zero)%
    . tgValue(vOne(w)) = itAdd(it1,itQuad(tgValue(w))) %(tg_value_one)%
    . tgNonzero(vNil) = fzero %(tg_nonzero_empty)%
    . tgNonzero(vZero(w)) = tgNonzero(w) %(tg_nonzero_zero)%
    . tgNonzero(vOne(w)) = fone %(tg_nonzero_one)%
    . tgDigitLaw(w) <=> (tgValue(w) = it0 <=> tgNonzero(w) = fzero)
          %(tg_digit_law_def)%
  . (tgDigitLaw(vNil) /\
      (forall w : VWord . tgDigitLaw(w) => tgDigitLaw(vZero(w)) /\ tgDigitLaw(vOne(w))))
      => (forall w : VWord . tgDigitLaw(w)) %(tg_free_digit_induction)%

  forall x,y,p,q,z : ITZ; b : FBit
    . itAdd(itAdd(x,tgMultiply(p,y)),tgMultiply(tgMultiply(p,q),z)) =
         itAdd(x,tgMultiply(p,itAdd(y,tgMultiply(q,z)))) %(tg_scalar_compose)% %implied
    . tgApply(tgCompose(tgBlock(p,x),tgBlock(q,y)),z) =
         tgApply(tgBlock(p,x),tgApply(tgBlock(q,y),z)) %(tg_apply_compose)% %implied
    . tgCompose(tgBinary(b),tgBinary(fzero)) = tgBlock(itDouble(itDouble(it1)),tgDigit(b))
          %(tg_two_cells_to_one_affine_digit)% %implied
  forall w : VWord
    . tgDigitLaw(vNil) %(tg_digit_base)% %implied
    . tgDigitLaw(w) => tgDigitLaw(vZero(w)) %(tg_zero_extension_step)% %implied
    . tgDigitLaw(vOne(w)) %(tg_one_extension_step)% %implied
    . tgDigitLaw(w) => tgDigitLaw(vZero(w)) /\ tgDigitLaw(vOne(w))
          %(tg_digit_step)% %implied
    . tgDigitLaw(w) %(tg_digit_all)% %implied
    . tgValue(w) = it0 <=> tgNonzero(w) = fzero %(tg_base_four_zero_exact)% %implied
    . readSplit(rails(fzero,fone),rails(tgNonzero(w),fnot(tgNonzero(w)))) =
        rails(tgNonzero(vZero(w)),fnot(tgNonzero(vZero(w))))
         %(tg_zero_digit_native_read)% %implied
    . readSplit(rails(fone,fzero),rails(tgNonzero(w),fnot(tgNonzero(w)))) =
        rails(tgNonzero(vOne(w)),fnot(tgNonzero(vOne(w))))
         %(tg_one_digit_native_read)% %implied
end


%% Both tests retain the original input C. The arithmetic module proves the
%% verdict using ordinary integer gluing. The Cech module uses the original
%% failed clauses on the separately fixed infinite base.
spec PhantomCechTransport = PaddedTelescopeDigits and OrdinaryDecisionProjection then
  ops tpModelPoint : VWord -> CEPoint;
      tpCellWord : VInput * VNat -> VWord
  preds tpSound : CDMachine;
        tpTimely, tpPass : CDMachine * VNat * VNat

  forall w : VWord
    . tpModelPoint(w) = cePoint(ceExtend(w),ceHigherBase) %(tp_model_point_def)%
  forall c : VInput; n : VNat
    . tpCellWord(c,n) = tdLow(vWidth(c),tdHalf(n)) %(tp_cell_word_def)%
  forall m : CDMachine; a,d : VNat
    . tpSound(m) <=>
        (forall c : VInput; t : VNat . cdInput3(c) /\ cdEmit(m,c,t) => tdEventuallyConstant(c))
          %(tp_sound_def)%
    . tpTimely(m,a,d) <=>
        (forall c : VInput . cdInput3(c) /\ tdEventuallyConstant(c) => cdStopYes(m,c,a,d))
          %(tp_timely_def)%
    . tpPass(m,a,d) <=> tpSound(m) /\ tpTimely(m,a,d) %(tp_pass_def)%

  forall c : VInput; w : VWord; j : VNat; s : CEList
    . tdEventuallyConstant(c) <=> ceTotal(c) %(tp_same_original_verdict)% %implied
    . vModel(c,w) => ceWord(c,tpModelPoint(w)) = w %(tp_witness_address_keeps_word)% %implied
    . vModel(c,w) => vModel(c,ceWord(c,tpModelPoint(w))) %(tp_challenge_satisfies_c)% %implied
    . vModel(c,w) => not ceValid(c,tpModelPoint(w),ceCons(j,s))
          %(tp_original_model_empty_cech_fibre)% %implied
    . vModel(c,w) => not tdEventuallyConstant(c) %(tp_original_model_obstructs_integer_digits)% %implied
    . vModel(c,w) =>
        (not tdEventuallyConstant(c) /\ not ceValid(c,tpModelPoint(w),ceCons(j,s)))
          %(tp_one_original_model_obstructs_both)% %implied

  forall c : VInput; w : VWord; n,h,j : VNat; s : CEList
    . tdMark(c,n) = fone => tdEven(n) %(tp_unit_mark_requires_even_cell)% %implied
    . tdMark(c,n) = fone => vModel(c,tpCellWord(c,n))
          %(tp_unit_mark_supplies_original_model)% %implied
    . tdMark(c,n) = fone => not ceValid(c,tpModelPoint(tpCellWord(c,n)),ceCons(j,s))
          %(tp_cell_gives_empty_cech_fibre)% %implied
    . vModel(c,w) => tpCellWord(c,tdDouble(tdIndex(w,h))) = w
          %(tp_original_word_roundtrip_at_every_period)% %implied
    . vModel(c,w) =>
        tdMark(c,tdDouble(tdIndex(w,h))) = fone /\
        ceWord(c,tpModelPoint(tpCellWord(c,tdDouble(tdIndex(w,h))))) = w
          %(tp_original_model_gives_cell_and_cech_point)% %implied

  forall m : CDMachine; c : VInput; a,d : VNat
    . tpSound(m) <=> cdCechSound(m) %(tp_same_monitor_soundness)% %implied
    . tpTimely(m,a,d) <=> cdCechTimely(m,a,d) %(tp_same_machine_same_deadline)% %implied
    . tpPass(m,a,d) <=> cdCechPass(m,a,d) %(tp_one_clock_either_verdict)% %implied
    . tpPass(m,a,d) /\ cdInput3(c) =>
        (cdStopYes(m,c,a,d) <=> tdEventuallyConstant(c)) %(tp_frozen_clock_exact)% %implied
    . tpPass(m,a,d) /\ cdInput3(c) =>
        (cdStopNo(m,c,a,d) <=> (exists w : VWord . vModel(c,w)))
          %(tp_rejection_iff_model_under_full_promise)% %implied

  forall h : CDDecision; a,d : VNat
    . cdOrdinaryDecides(h,a,d) => tpPass(cdAsMonitor(h),a,d)
          %(tp_ordinary_decider_to_phantom_monitor)% %implied

  . (exists m : CDMachine; a,d : VNat . tpPass(m,a,d)) <=>
        (exists m : CDMachine; a,d : VNat . cdSound(m) /\ cdStopsCorrectly(m,a,d))
          %(tp_frozen_phantom_clock_equivalence)% %implied
end

%% Concrete source stream. Every output stays in the ordinary integers.
%% The two signed-bit laws are the arithmetic interface. Their standard
%% interpretation uses the unique binary expansion in Z_2 of an element of Z.
%% Nonnegative inputs eventually give 0, and negative inputs eventually give 1.
%% Agreement of prefix residues forces all binary digits to agree.
spec IntegralPhantomTransport = PhantomCechTransport and IntegerTelescopeGluing then
  ops tpCellStream : VInput -> ITStream;
      tpDigitAsInteger : FBit -> ITZ;
      tpSignedBit : ITZ * VNat -> FBit

  . tpDigitAsInteger(fzero) = it0 %(tp_read_integer_zero)%
  . tpDigitAsInteger(fone) = it1 %(tp_read_integer_one)%
  forall c : VInput; n : VNat
    . itAt(tpCellStream(c),n) = tpDigitAsInteger(tdMark(c,n))
          %(tp_cell_stream_original_mark)%
  forall z : ITZ
    . (exists h : VNat; b : FBit .
        forall i : VNat . vLe(h,i) => tpSignedBit(z,i) = b)
          %(tp_ordinary_integer_sign_extension)%
  forall c : VInput; z : ITZ; n : VNat
    . itResidue(tpCellStream(c),vZ,vS(n),z) => tpSignedBit(z,n) = tdMark(c,n)
          %(tp_prefix_residue_reads_signed_bit)%

  forall c : VInput; h : VNat; b : FBit; z : ITZ
    . tdZeroMarks(c) => itAt(tpCellStream(c),h) = it0
          %(tp_zero_bit_gives_zero_integer_cell)% %implied
    . tdZeroMarks(c) => itIntegerGluing(tpCellStream(c))
          %(tp_zero_stream_glues_over_integers)% %implied
    . itLift(tpCellStream(c),z) => tpSignedBit(z,h) = tdMark(c,h)
          %(tp_integer_lift_reads_signed_bit)% %implied
    . itLift(tpCellStream(c),z) /\
        (forall i : VNat . vLe(h,i) => tpSignedBit(z,i) = b) =>
        (forall i : VNat . vLe(h,i) => tdMark(c,i) = b)
          %(tp_sign_tail_transfers_pointwise)% %implied
    . itLift(tpCellStream(c),z) => tdEventuallyConstant(c)
          %(tp_integer_initial_value_requires_sign_tail)% %implied
    . itIntegerGluing(tpCellStream(c)) => tdEventuallyConstant(c)
          %(tp_integer_glue_requires_eventual_digits)% %implied
    . itIntegerGluing(tpCellStream(c)) <=> vRefuted(c)
          %(tp_integer_glue_iff_original_unsat)% %implied
    . itIntegerGluing(tpCellStream(c)) <=> ceTotal(c)
          %(tp_integer_glue_iff_cech_totality)% %implied

  forall c : VInput; w : VWord; j : VNat; s : CEList
    . vModel(c,w) => (not itIntegerGluing(tpCellStream(c)) /\
                    not ceValid(c,tpModelPoint(w),ceCons(j,s)))
          %(tp_same_model_obstructs_integral_gluing_and_cech_fibre)% %implied

  forall c : VInput; w : VWord; z : ITZ; h : VNat
    . vModel(c,w) /\
        (forall i : VNat . vLe(h,i) => tpSignedBit(z,i) = fzero) =>
          not itResidue(tpCellStream(c),vZ,vS(tdDouble(tdIndex(w,h))),z)
          %(tp_model_rejects_zero_tail_candidate)% %implied
    . (forall i : VNat . vLe(h,i) => tpSignedBit(z,i) = fone) =>
          not itResidue(tpCellStream(c),vZ,vS(vS(tdDouble(h))),z)
          %(tp_odd_padding_rejects_one_tail_candidate)% %implied
    . vModel(c,w) =>
        (exists k : VNat . not itResidue(tpCellStream(c),vZ,k,z))
          %(tp_each_fixed_integer_candidate_has_a_finite_obstruction)% %implied
    . itCutOK(tpCellStream(c),vZ,h,it0,itSolve(tpCellStream(c),vZ,h,it0))
          %(tp_every_original_finite_cut_is_null)% %implied
    . vModel(c,w) =>
        (itCutOK(tpCellStream(c),vZ,h,it0,itSolve(tpCellStream(c),vZ,h,it0)) /\
         not itIntegerGluing(tpCellStream(c)))
          %(tp_sat_finite_null_but_nonnull_globally)% %implied

  forall m : CDMachine; c : VInput; a,d : VNat
    . tpSound(m) <=> (forall f : VInput; t : VNat .
        cdInput3(f) /\ cdEmit(m,f,t) => itIntegerGluing(tpCellStream(f)))
          %(tp_integral_monitor_soundness_exact)% %implied
    . tpTimely(m,a,d) <=> (forall f : VInput .
        cdInput3(f) /\ itIntegerGluing(tpCellStream(f)) => cdStopYes(m,f,a,d))
          %(tp_integral_monitor_timely_exact)% %implied
    . tpPass(m,a,d) /\ cdInput3(c) =>
        (cdStopYes(m,c,a,d) <=> itIntegerGluing(tpCellStream(c)))
          %(tp_integral_gluing_at_the_fixed_clock)% %implied
end

%% Scalar laws describe the complex field and its vector space. The arithmetic
%% companion identifies the actual curve, the rotation, and the mode product.
%% q is the scalar 16 = 4 * 4 and sfCentral is q^{-1}.
spec TelescopeFrobeniusSpectrum =
  sorts SFScalar, SFVector
  ops sfOne, sfZero, sfFour, sfQ, sfCentral : SFScalar;
      sfMul, sfSub : SFScalar * SFScalar -> SFScalar;
      sfSq, sfFourth, sfDifference : SFScalar -> SFScalar;
      sfShift, sfFrobenius, sfPaired, sfFixedDifference : SFVector -> SFVector;
      sfScale : SFScalar * SFVector -> SFVector;
      sfVectorSub : SFVector * SFVector -> SFVector;
      sfBaseZetaNumerator, sfBaseZetaDenominator : SFScalar -> SFScalar;
      sfModeNumerator, sfModeDenominator : SFScalar * SFScalar -> SFScalar
  preds sfEigen : SFScalar * SFVector;
        sfCharacter : SFScalar

  forall a,b,c : SFScalar; x : SFVector
    . sfMul(sfOne,a) = a %(sf_mul_one)%
    . sfMul(a,b) = sfMul(b,a) %(sf_mul_comm)%
    . sfMul(sfMul(a,b),c) = sfMul(a,sfMul(b,c)) %(sf_mul_assoc)%
    . sfMul(sfQ,sfCentral) = sfOne %(sf_q_times_central)%
    . sfMul(sfFour,sfFour) = sfQ %(sf_square_four)%
    . sfMul(sfFour,a)=sfMul(sfFour,b) => a=b %(sf_four_cancellation)%
    . sfSub(sfOne,a) = sfZero <=> a = sfOne %(sf_one_minus_zero_exact)%
    . sfSq(a) = sfZero <=> a = sfZero %(sf_square_zero_exact)%
    . sfMul(a,b) = sfZero <=> a = sfZero \/ b = sfZero %(sf_product_zero_exact)%
    . sfSq(a) = sfMul(a,a) %(sf_square_def)%
    . sfFourth(a) = sfSq(sfSq(a)) %(sf_fourth_def)%
    . sfDifference(a) = sfSub(sfOne,a) %(sf_difference_def)%
    . sfScale(a,sfScale(b,x)) = sfScale(sfMul(a,b),x) %(sf_scale_assoc)%
    . sfScale(sfOne,x) = x %(sf_scale_one)%
    . sfVectorSub(sfScale(a,x),sfScale(b,x)) = sfScale(sfSub(a,b),x)
        %(sf_scale_subtraction)%

  forall w : SFScalar; x : SFVector
    . sfEigen(w,x) <=> sfShift(x)=sfScale(w,x) %(sf_character_read)%
    . sfFrobenius(x)=sfScale(sfFour,sfShift(x)) %(sf_frobenius_def)%
    . sfPaired(x)=sfVectorSub(x,sfFrobenius(x)) %(sf_paired_def)%
    . sfFixedDifference(x)=sfVectorSub(x,sfShift(x)) %(sf_fixed_difference_def)%
    %% These two exclusions follow from |w|=1 for a cyclic character.
    . sfCharacter(w) => not w=sfFour %(sf_character_excludes_four)%
    . sfCharacter(w) => not sfMul(sfFour,w)=sfOne %(sf_character_excludes_quarter)%

  %% Symbolic constant-elliptic function-field factors. On E/F_16,
  %% Z_E(u)=(1-4u)^2/((1-u)(1-16u)) and H^1 has two Frobenius axes.
  forall u,w,t : SFScalar
    . sfBaseZetaNumerator(u) = sfSq(sfDifference(sfMul(sfFour,u)))
        %(sf_base_zeta_numerator_def)%
    . sfBaseZetaDenominator(u) = sfMul(sfDifference(u),sfDifference(sfMul(sfQ,u)))
        %(sf_base_zeta_denominator_def)%
    . sfModeNumerator(w,t) = sfSq(sfBaseZetaNumerator(sfMul(sfMul(sfFour,w),t)))
        %(sf_mode_numerator_def)%
    . sfModeDenominator(w,t) = sfSq(sfBaseZetaDenominator(sfMul(sfMul(sfFour,w),t)))
        %(sf_mode_denominator_def)%

  forall w,u,t : SFScalar; x : SFVector
    . sfEigen(w,x) => sfFrobenius(x)=sfScale(sfMul(sfFour,w),x)
        %(sf_frobenius_mode)% %implied
    . sfEigen(w,x) => sfPaired(x)=sfScale(sfDifference(sfMul(sfFour,w)),x)
        %(sf_paired_mode)% %implied
    . sfEigen(w,x) => sfFixedDifference(x)=sfScale(sfDifference(w),x)
        %(sf_central_fixed_mode)% %implied
    . sfCharacter(w) => not sfDifference(sfMul(sfFour,w))=sfZero
        %(sf_paired_characters_nonzero)% %implied
    . sfMul(sfFour,sfMul(sfMul(sfFour,w),t))=sfMul(sfMul(sfQ,w),t)
        %(sf_numerator_weight)% %implied
    . sfMul(sfMul(sfQ,w),sfCentral)=w
        %(sf_weight_two_central_read)% %implied
    . sfModeNumerator(w,t)=sfFourth(sfDifference(sfMul(sfMul(sfQ,w),t)))
        %(sf_zeta_pull_numerator)% %implied
    . sfModeNumerator(w,sfCentral)=sfFourth(sfDifference(w))
        %(sf_central_numerator_is_fourth_fixed_difference)% %implied
    . sfFourth(u)=sfZero <=> u=sfZero
        %(sf_fourth_zero_exact)% %implied
    . sfModeNumerator(w,sfCentral)=sfZero <=> w=sfOne
        %(sf_central_only_trivial_character)% %implied
    . sfMul(sfQ,sfMul(sfMul(sfFour,w),sfCentral))=sfMul(sfFour,w)
        %(sf_weight_three_central_read)% %implied
    . sfMul(sfMul(sfFour,w),sfCentral)=sfOne => w=sfFour
        %(sf_weight_one_central_exclusion)% %implied
    . sfCharacter(w) => not sfDifference(sfMul(sfMul(sfFour,w),sfCentral))=sfZero
        %(sf_weight_one_no_pole)% %implied
    . sfModeDenominator(w,sfCentral) =
        sfSq(sfMul(sfDifference(sfMul(sfMul(sfFour,w),sfCentral)),
                  sfDifference(sfMul(sfFour,w))))
        %(sf_central_denominator_split)% %implied
    . sfCharacter(w) => not sfModeDenominator(w,sfCentral)=sfZero
        %(sf_central_denominator_no_poles)% %implied
end


%% Scalar identities for the operator-valued Haar trace on a common physical
%% transfer. In the application x=z^M T^M, with spectrum in [0,z^M].
%% The written proof constructs the cycle trace and marks the original Hilbert
%% space; the arithmetic here checks its signed split and normalized return.
spec YangDyadicHeatTrace =
  sort YSScalar
  ops ysOne, ysTwo : YSScalar;
      ysAdd, ysSub, ysMul : YSScalar * YSScalar -> YSScalar;
      ysInv, ysSq, ysPlus, ysMinus, ysQuadratic : YSScalar -> YSScalar;
      ysPositiveCycle, ysSignedCycle, ysDyadicCycle : YSScalar -> YSScalar;
      ysHalfAverage, ysHalfDifference : YSScalar -> YSScalar
  pred ysAdmissible : YSScalar
  forall x,y,z : YSScalar
    . ysMul(ysOne,x) = x %(ys_unit)%
    . ysMul(x,y) = ysMul(y,x) %(ys_comm)%
    . ysMul(ysMul(x,y),z) = ysMul(x,ysMul(y,z)) %(ys_assoc)%
    . ysMul(x,ysAdd(y,z)) = ysAdd(ysMul(x,y),ysMul(x,z)) %(ys_dist_add)%
    . ysMul(x,ysSub(y,z)) = ysSub(ysMul(x,y),ysMul(x,z)) %(ys_dist_sub)%
    . ysMul(ysTwo,ysInv(ysTwo)) = ysOne %(ys_two_inv)%
    . ysSq(x) = ysMul(x,x) %(ys_sq_def)%
    . ysPlus(x) = ysAdd(ysOne,x) %(ys_plus_def)%
    . ysMinus(x) = ysSub(ysOne,x) %(ys_minus_def)%
    . ysQuadratic(x) = ysSub(ysOne,ysSq(x)) %(ys_quad_def)%
    . ysQuadratic(x) = ysMul(ysMinus(x),ysPlus(x)) %(ys_difference_squares)%
    . ysAdd(ysPlus(x),ysMinus(x)) = ysTwo %(ys_linear_sum)%
    . ysSub(ysPlus(x),ysMinus(x)) = ysMul(ysTwo,x) %(ys_linear_difference)%
    . ysPositiveCycle(x) = ysInv(ysMinus(x)) %(ys_positive_cycle)%
    . ysSignedCycle(x) = ysInv(ysPlus(x)) %(ys_signed_cycle)%
    . ysDyadicCycle(x) = ysInv(ysQuadratic(x)) %(ys_doubled_cycle)%
    . ysAdmissible(x) => ysMul(ysMinus(x),ysPositiveCycle(x)) = ysOne %(ys_positive_inverse)%
    . ysAdmissible(x) => ysMul(ysPlus(x),ysSignedCycle(x)) = ysOne %(ys_signed_inverse)%
    . ysAdmissible(x) => ysMul(ysQuadratic(x),ysDyadicCycle(x)) = ysOne %(ys_doubled_inverse)%
    . ysHalfAverage(x) = ysMul(ysInv(ysTwo),ysAdd(ysPositiveCycle(x),ysSignedCycle(x)))
        %(ys_average_def)%
    . ysHalfDifference(x) = ysMul(ysInv(ysTwo),ysSub(ysPositiveCycle(x),ysSignedCycle(x)))
        %(ys_difference_def)%
  forall x,y,z : YSScalar
    . ysMul(x,ysMul(y,z)) = ysMul(y,ysMul(x,z)) %(ys_exchange_first_slots)% %implied
    . ysMul(ysInv(ysTwo),ysMul(ysTwo,x)) = x %(ys_inv_two_cancel)% %implied
  forall x : YSScalar
    . ysAdmissible(x) => ysMul(ysQuadratic(x),ysPositiveCycle(x)) = ysPlus(x)
        %(ys_quadratic_positive)% %implied
    . ysAdmissible(x) => ysMul(ysQuadratic(x),ysSignedCycle(x)) = ysMinus(x)
        %(ys_quadratic_signed)% %implied
    . ysAdmissible(x) => ysMul(ysQuadratic(x),ysAdd(ysPositiveCycle(x),ysSignedCycle(x))) = ysTwo
        %(ys_quadratic_full_sum)% %implied
    . ysAdmissible(x) => ysMul(ysQuadratic(x),ysSub(ysPositiveCycle(x),ysSignedCycle(x))) = ysMul(ysTwo,x)
        %(ys_quadratic_full_difference)% %implied
    . ysAdmissible(x) => ysMul(ysQuadratic(x),ysHalfAverage(x)) = ysOne
        %(ys_quadratic_half_average)% %implied
    . ysAdmissible(x) => ysMul(ysQuadratic(x),ysHalfDifference(x)) = x
        %(ys_quadratic_half_difference)% %implied
    . ysAdmissible(x) => ysHalfAverage(x) = ysDyadicCycle(x)
        %(ys_exact_haar_average)% %implied
    . ysAdmissible(x) => ysHalfDifference(x) = ysMul(x,ysDyadicCycle(x))
        %(ys_exact_haar_difference)% %implied
end

%% Interpret ITZ as the integers, or as Z_2. The supplied parity predicates
%% select the two parity classes. The two monotone affine equations use
%% accelerated Collatz (3*x+1)/2 and x/2.
spec CollatzSpectralReturn = TelescopeAffineBlocks then
  op coThree : ITZ
  ops coMultiplier : FBit -> ITZ;
      coFirst : FBit * ITZ -> ITZ;
      coAffine : FBit * ITZ -> ITZ;
      coPairMultiplier, coPairOffset : FBit * FBit -> ITZ;
      coPairValue : FBit * FBit * ITZ -> ITZ
  preds coParity : ITZ * FBit;
        coStep : FBit * ITZ * ITZ;
        coPair : FBit * FBit * ITZ * ITZ;
        coMarkedPair : FBit * FBit * ITZ * ITZ
  . coThree = itAdd(it1,itDouble(it1)) %(co_three_def)%
  . coMultiplier(fzero) = it1 %(co_mult_zero)%
  . coMultiplier(fone) = coThree %(co_mult_one)%
  forall e,f : FBit; p,x,y,z : ITZ
    . tgMultiply(it1,p)=p %(co_mul_left_one)%
    . tgMultiply(p,it1)=p %(co_mul_right_one)%
    . coAffine(e,x)=itAdd(tgMultiply(coMultiplier(e),x),tgDigit(e))
          %(co_affine_def)%
    . coParity(x,e) => itDouble(coFirst(e,x))=coAffine(e,x)
          %(co_parity_division)%
    . coStep(e,x,y) <=> coParity(x,e) /\ itDouble(y)=coAffine(e,x)
          %(co_step_def)%
    . coPairMultiplier(e,f)=tgMultiply(coMultiplier(f),coMultiplier(e))
          %(co_pair_multiplier_def)%
    . coPairOffset(e,f)=itAdd(tgMultiply(coMultiplier(f),tgDigit(e)),itDouble(tgDigit(f)))
          %(co_pair_offset_def)%
    . coPairValue(e,f,x)=itAdd(tgMultiply(coPairMultiplier(e,f),x),coPairOffset(e,f))
          %(co_pair_value_def)%
    . coPair(e,f,x,z) <=> itQuad(z)=coPairValue(e,f,x) %(co_pair_def)%
    . coMarkedPair(e,f,x,z) <=> (exists y : ITZ . coStep(e,x,y) /\ coStep(f,y,z))
          %(co_marked_pair_def)%

  forall e,f : FBit; p,x,y,z : ITZ
    . tgMultiply(p,itDouble(x))=itDouble(tgMultiply(p,x))
          %(co_commute_doubling)% %implied
    . tgMultiply(p,coAffine(e,x)) =
        itAdd(tgMultiply(p,tgMultiply(coMultiplier(e),x)),tgMultiply(p,tgDigit(e)))
          %(co_affine_distribute)% %implied
    . tgMultiply(coMultiplier(f),tgMultiply(coMultiplier(e),x)) =
        tgMultiply(coPairMultiplier(e,f),x) %(co_collect_multiplier)% %implied
    . tgMultiply(coMultiplier(f),coAffine(e,x)) =
        itAdd(tgMultiply(coPairMultiplier(e,f),x),tgMultiply(coMultiplier(f),tgDigit(e)))
          %(co_multiply_affine)% %implied
    . itAdd(itAdd(tgMultiply(coPairMultiplier(e,f),x),
                  tgMultiply(coMultiplier(f),tgDigit(e))),itDouble(tgDigit(f)))=
        coPairValue(e,f,x) %(co_collect_pair)% %implied
    . itAdd(tgMultiply(coMultiplier(f),coAffine(e,x)),itDouble(tgDigit(f)))=
        coPairValue(e,f,x) %(co_expand_pair)% %implied
    . itDouble(y)=coAffine(e,x) =>
        itDouble(coAffine(f,y))=coPairValue(e,f,x)
          %(co_pair_square)% %implied
    . itDouble(y)=coAffine(e,x) /\ itDouble(z)=coAffine(f,y) =>
        coPair(e,f,x,z) %(co_forward_pair)% %implied
    . coPair(e,f,x,z) /\ itDouble(y)=coAffine(e,x) =>
        itDouble(z)=coAffine(f,y) %(co_reverse_pair)% %implied
    . coStep(e,x,y) => y=coFirst(e,x) %(co_midpoint_unique)% %implied
    . coStep(e,x,y) /\ coStep(f,y,z) =>
        coPair(e,f,x,z) /\ coParity(x,e) /\ coParity(coFirst(e,x),f)
          %(co_marked_pair_forward_at_midpoint)% %implied
    . coMarkedPair(e,f,x,z) =>
        coPair(e,f,x,z) /\ coParity(x,e) /\ coParity(coFirst(e,x),f)
          %(co_marked_pair_forward)% %implied
    . coPair(e,f,x,z) /\ coParity(x,e) /\ coParity(coFirst(e,x),f) =>
        coStep(e,x,coFirst(e,x)) /\ coStep(f,coFirst(e,x),z)
          %(co_marked_pair_backward_at_midpoint)% %implied
    . coPair(e,f,x,z) /\ coParity(x,e) /\ coParity(coFirst(e,x),f) =>
        coMarkedPair(e,f,x,z) %(co_marked_pair_backward)% %implied
    . coMarkedPair(e,f,x,z) <=>
        coPair(e,f,x,z) /\ coParity(x,e) /\ coParity(coFirst(e,x),f)
          %(co_marked_pair_exact)% %implied

  . coPairMultiplier(fzero,fzero)=it1 %(co_multiplier_00)% %implied
  . coPairMultiplier(fzero,fone)=coThree %(co_multiplier_01)% %implied
  . coPairMultiplier(fone,fzero)=coThree %(co_multiplier_10)% %implied
  . coPairMultiplier(fone,fone)=tgMultiply(coThree,coThree) %(co_multiplier_11)% %implied
  . coPairOffset(fzero,fzero)=it0 %(co_offset_00)% %implied
  . coPairOffset(fzero,fone)=itDouble(it1) %(co_offset_01)% %implied
  . coPairOffset(fone,fzero)=it1 %(co_offset_10)% %implied
  . coPairOffset(fone,fone)=itAdd(coThree,itDouble(it1)) %(co_offset_11)% %implied
  forall x,z : ITZ
    . coPair(fzero,fzero,x,z) <=> x=itQuad(z) %(co_zero_pair_shift)% %implied
    . coPair(fone,fzero,x,z) <=>
        itQuad(z)=itAdd(tgMultiply(coThree,x),it1)
        %(co_ten_pair_original_cycle_equation)% %implied
    . coPair(fone,fone,x,z) <=>
        itQuad(z)=itAdd(tgMultiply(tgMultiply(coThree,coThree),x),itAdd(coThree,itDouble(it1)))
        %(co_eleven_pair_original_equation)% %implied
end

%% Interpret coParityCode in the 2-adic instance of the integer-affine laws.
%% This is the digit recursion of the actual parity itinerary. Its existence
%% and bijection on Z_2 are proved using the contracting inverse branches.
spec CollatzParityTelescopeReturn = CollatzSpectralReturn then
  op coParityCode : ITZ -> ITZ
  op coBaseFourDigit : FBit * FBit -> ITZ

  forall e,f : FBit; x,y,z : ITZ
    . coStep(e,x,y) => coParityCode(x)=itPush(tgDigit(e),coParityCode(y))
          %(co_parity_shift)% 
    . coBaseFourDigit(e,f)=itAdd(tgDigit(e),itDouble(tgDigit(f)))
          %(co_base_four_digit_def)%
    . itPush(tgDigit(e),tgDigit(f))=coBaseFourDigit(e,f)
          %(co_digit_is_push)% %implied
    . itPush(tgDigit(e),itPush(tgDigit(f),z))=
        itAdd(itPush(tgDigit(e),tgDigit(f)),itQuad(z))
          %(co_collect_two_digit_pushes)% %implied
    . itPush(tgDigit(e),itPush(tgDigit(f),z))=
        itAdd(coBaseFourDigit(e,f),itQuad(z))
          %(co_repack_lsb_two_digits)% %implied
    . coStep(e,x,y) /\ coStep(f,y,z) =>
        coParityCode(x)=itAdd(coBaseFourDigit(e,f),itQuad(coParityCode(z)))
          %(co_original_pair_is_telescope)% %implied
    . coMarkedPair(e,f,x,z) =>
        coParityCode(x)=itAdd(coBaseFourDigit(e,f),itQuad(coParityCode(z)))
          %(co_original_marked_pair_is_telescope)% %implied
    . coStep(fone,x,y) /\ coStep(fzero,y,x) =>
        coParityCode(x)=itAdd(it1,itQuad(coParityCode(x)))
          %(co_known_ten_cycle_parity_code)% %implied
end


%% Actual infinite singleton: cell(t,i,j) is lattice site i-j.
%% This is the singleton equation from CentrePrefixData. No wraparound.
spec Rule30ActualSpectralReturn = TelescopeAffineBlocks then
  ops rsCell : VNat * VNat * VNat -> FBit;
      rsInitial : VNat * VNat -> FBit;
      rsCentre : VNat -> FBit;
      rsCons : FBit * VWord -> VWord;
      rsWindow : VNat * VNat -> VWord;
      rsLagXor : VNat * VNat * VNat -> VWord
  pred rsWindowLaw : VNat
  . rsInitial(vZ,vZ) = fone %(rs_singleton_black)%
  forall i,j : VNat
    . rsInitial(vZ,vS(j)) = fzero %(rs_singleton_west_white)%
    . rsInitial(vS(i),vZ) = fzero %(rs_singleton_east_white)%
    . rsInitial(vS(i),vS(j)) = rsInitial(i,j) %(rs_same_site)%
  forall t,i,j : VNat
    . rsCell(vZ,i,j) = rsInitial(i,j) %(rs_initial_row)%
    . rsCell(vS(t),i,j) =
        ruleBit(rsCell(t,i,vS(j)),rsCell(t,i,j),rsCell(t,vS(i),j)) %(rs_actual_step)%
    . rsCentre(t) = rsCell(t,vZ,vZ) %(rs_actual_centre)%
  forall w : VWord
    . rsCons(fzero,w) = vZero(w) %(rs_cons_zero)%
    . rsCons(fone,w) = vOne(w) %(rs_cons_one)%
  forall t,u,n : VNat
    . rsWindow(t,vZ) = vNil %(rs_window_empty)%
    . rsWindow(t,vS(n)) = rsCons(rsCentre(t),rsWindow(vS(t),n)) %(rs_window_step)%
    . rsLagXor(t,u,vZ) = vNil %(rs_lag_empty)%
    . rsLagXor(t,u,vS(n)) =
        rsCons(fadd(rsCentre(t),rsCentre(u)),rsLagXor(vS(t),vS(u),n)) %(rs_lag_step)%
    . rsWindowLaw(n) <=>
        (forall s,r : VNat . tgNonzero(rsLagXor(s,r,n)) = fzero <=>
               rsWindow(s,n) = rsWindow(r,n)) %(rs_window_law_def)%
  . (rsWindowLaw(vZ) /\ (forall n : VNat . rsWindowLaw(n) => rsWindowLaw(vS(n)))) =>
        (forall n : VNat . rsWindowLaw(n)) %(rs_window_induction)%

  forall a,b : FBit; w,z : VWord
    . fadd(a,b) = fzero <=> a = b %(rs_xor_zero_exact)% %implied
    . rsCons(a,w) = rsCons(b,z) <=> a = b /\ w = z %(rs_cons_read_exact)% %implied
    . tgNonzero(rsCons(a,w)) = fzero <=> a = fzero /\ tgNonzero(w) = fzero
         %(rs_cons_lag_zero)% %implied
  forall t,i,j,n,u : VNat
    . rsCell(vS(t),i,j) =
        atSeam(blkProd(blkLeft(rsCell(t,i,vS(j)),rsCell(t,i,j)),blkRight(rsCell(t,vS(i),j))))
         %(rs_rule30_matrix_reads_actual_row)% %implied
    . rsCentre(vZ) = fone %(rs_centre_zero_black)% %implied
    . rsCentre(vS(vZ)) = fone %(rs_centre_one_black)% %implied
    . rsWindowLaw(vZ) %(rs_window_law_base)% %implied
    . tgNonzero(rsLagXor(t,u,vS(n))) = fzero <=>
        rsCentre(t) = rsCentre(u) /\ tgNonzero(rsLagXor(vS(t),vS(u),n)) = fzero
          %(rs_lag_step_is_head_and_tail)% %implied
    . rsWindow(t,vS(n)) = rsWindow(u,vS(n)) <=>
        rsCentre(t) = rsCentre(u) /\ rsWindow(vS(t),n) = rsWindow(vS(u),n)
          %(rs_window_step_is_head_and_tail)% %implied
    . rsWindowLaw(n) =>
        (tgNonzero(rsLagXor(vS(t),vS(u),n)) = fzero <=>
         rsWindow(vS(t),n) = rsWindow(vS(u),n)) %(rs_lag_law_at_successors)% %implied
    . rsWindowLaw(n) =>
        (tgNonzero(rsLagXor(t,u,vS(n))) = fzero <=>
         rsWindow(t,vS(n)) = rsWindow(u,vS(n))) %(rs_window_step_at_pair)% %implied
    . rsWindowLaw(n) => rsWindowLaw(vS(n)) %(rs_window_law_step)% %implied
    . rsWindowLaw(n) %(rs_window_law_all)% %implied
    . tgNonzero(rsLagXor(t,u,n)) = fzero <=> rsWindow(t,n) = rsWindow(u,n)
         %(rs_lag_boolean_zero_exact)% %implied
    . tgValue(rsLagXor(t,u,n)) = it0 <=> rsWindow(t,n) = rsWindow(u,n)
         %(rs_actual_lag_base_four_zero_exact)% %implied
end

%% The quotient interface is Z_2/Z with low-to-high base-four digits.
%% Tail series are actual geometric sums of the singleton centre above.
%% rqSmall(t) means the rational lift lies in a common interval of
%% diameter < 1, for example [-1/2,1/6). Rational-tail boundedness is
%% supplied in the written proof. No aperiodicity premise is imported.
spec Rule30ActualPeriodArithmetic = Rule30ActualSpectralReturn then
  sorts RQTails,RQClass
  ops rqTail : VNat -> RQTails;
      rqClass : RQTails -> RQClass;
      rqFour : RQClass -> RQClass;
      rqPower : VNat * RQClass -> RQClass
  preds rqSmall : VNat;
        rqRational : RQTails;
        rqAnnihilator, rqEventually, rqPowerLaw, rqCommuteLaw, rqShiftLaw, rqPropagateLaw : VNat
  forall a,b : RQClass; n,t,u,p : VNat
    . rqFour(a) = rqFour(b) => a = b %(rq_quotient_four_injective)%
    . rqPower(vZ,a) = a %(rq_power_zero)%
    . rqPower(vS(n),a) = rqFour(rqPower(n,a)) %(rq_power_successor)%
    . rqClass(rqTail(t)) = rqFour(rqClass(rqTail(vS(t)))) %(rq_tail_shift)%
    . itAfter(itAfter(t,p),u) = itAfter(itAfter(t,u),p) %(rq_index_swap)%
    . itAfter(itAfter(t,p),u) = itAfter(t,itAfter(p,u)) %(rq_index_association)%
    . rqTail(t) = rqTail(u) => rsCentre(t) = rsCentre(u) %(rq_reads_first_digit)%
    . (forall j : VNat . rsCentre(itAfter(t,j)) = rsCentre(itAfter(u,j))) =>
         rqTail(t) = rqTail(u) %(rq_digit_extensionality)%
    . rqSmall(t) /\ rqSmall(u) /\ rqClass(rqTail(t)) = rqClass(rqTail(u)) =>
         rqTail(t) = rqTail(u) %(rq_small_lifts_unique)%
    . rqRational(rqTail(vZ)) => (exists h : VNat . forall j : VNat . rqSmall(itAfter(h,j)))
         %(rq_rational_tails_enter_interval)%
    . rqPower(p,rqClass(rqTail(vZ))) = rqClass(rqTail(vZ)) /\ not p = vZ =>
         rqRational(rqTail(vZ)) %(rq_integer_annihilator_is_rational)%
    . rqAnnihilator(p) <=> rqPower(p,rqClass(rqTail(vZ))) = rqClass(rqTail(vZ))
         %(rq_annihilator_def)%
    . rqEventually(p) <=> (exists h : VNat . forall j : VNat .
         rsCentre(itAfter(h,j)) = rsCentre(itAfter(itAfter(h,p),j))) %(rq_eventual_def)%
    . rqPowerLaw(n) <=> (forall x,y : RQClass . rqPower(n,x) = rqPower(n,y) => x = y)
         %(rq_power_law_def)%
    . rqCommuteLaw(n) <=> (forall x : RQClass . rqPower(n,rqFour(x)) = rqFour(rqPower(n,x)))
         %(rq_commute_law_def)%
    . rqShiftLaw(n) <=> (forall j : VNat . rqPower(n,rqClass(rqTail(itAfter(j,n)))) = rqClass(rqTail(j)))
         %(rq_shift_law_def)%
    . rqPropagateLaw(t) <=> (forall q : VNat . rqAnnihilator(q) <=>
            rqPower(q,rqClass(rqTail(t))) = rqClass(rqTail(t))) %(rq_propagate_law_def)%
  . (rqPowerLaw(vZ) /\ (forall n : VNat . rqPowerLaw(n) => rqPowerLaw(vS(n)))) =>
        (forall n : VNat . rqPowerLaw(n)) %(rq_power_induction)%
  . (rqCommuteLaw(vZ) /\ (forall n : VNat . rqCommuteLaw(n) => rqCommuteLaw(vS(n)))) =>
        (forall n : VNat . rqCommuteLaw(n)) %(rq_commute_induction)%
  . (rqShiftLaw(vZ) /\ (forall n : VNat . rqShiftLaw(n) => rqShiftLaw(vS(n)))) =>
        (forall n : VNat . rqShiftLaw(n)) %(rq_shift_induction)%
  . (rqPropagateLaw(vZ) /\ (forall n : VNat . rqPropagateLaw(n) => rqPropagateLaw(vS(n)))) =>
        (forall n : VNat . rqPropagateLaw(n)) %(rq_propagate_induction)%
  forall n,t,p,j,h : VNat; a,b : RQClass
    . rqPowerLaw(vZ) %(rq_power_base)% %implied
    . rqPowerLaw(n) => rqPowerLaw(vS(n)) %(rq_power_step)% %implied
    . rqPowerLaw(n) %(rq_power_all)% %implied
    . rqPower(n,a) = rqPower(n,b) => a = b %(rq_power_injective)% %implied
    . rqCommuteLaw(vZ) %(rq_commute_base)% %implied
    . rqCommuteLaw(n) => rqCommuteLaw(vS(n)) %(rq_commute_step)% %implied
    . rqCommuteLaw(n) %(rq_commute_all)% %implied
    . rqPower(n,rqFour(a)) = rqFour(rqPower(n,a)) %(rq_power_commutes)% %implied
    . rqShiftLaw(vZ) %(rq_shift_base)% %implied
    . rqShiftLaw(n) => rqPower(n,rqClass(rqTail(itAfter(vS(t),n)))) = rqClass(rqTail(vS(t)))
         %(rq_shift_at_successor)% %implied
    . rqShiftLaw(n) => rqShiftLaw(vS(n)) %(rq_shift_step)% %implied
    . rqShiftLaw(n) %(rq_shift_all)% %implied
    . rqPower(n,rqClass(rqTail(itAfter(t,n)))) = rqClass(rqTail(t)) %(rq_shift_exact)% %implied
    . (rqPower(p,rqClass(rqTail(t))) = rqClass(rqTail(t))) <=>
          (rqPower(p,rqClass(rqTail(vS(t)))) = rqClass(rqTail(vS(t)))) %(rq_fixed_locus_step)% %implied
    . rqPropagateLaw(vZ) %(rq_propagate_base)% %implied
    . rqPropagateLaw(t) => rqPropagateLaw(vS(t)) %(rq_propagate_step)% %implied
    . rqPropagateLaw(t) %(rq_propagate_all)% %implied
    . rqAnnihilator(p) <=> rqPower(p,rqClass(rqTail(t))) = rqClass(rqTail(t))
         %(rq_propagated_annihilator)% %implied
    . rqClass(rqTail(t)) = rqClass(rqTail(itAfter(t,p))) <=> rqAnnihilator(p)
         %(rq_tail_class_equal_exact)% %implied
    . rqTail(t) = rqTail(itAfter(t,p)) => rqAnnihilator(p)
         %(rq_matching_tails_yield_annihilator)% %implied
    . rqEventually(p) => rqAnnihilator(p) %(rq_period_yields_annihilator)% %implied
    . rqAnnihilator(p) /\ not p = vZ => (exists u : VNat . forall k : VNat . rqSmall(itAfter(u,k)))
         %(rq_annihilator_gives_small_suffix)% %implied
    . (forall k : VNat . rqSmall(itAfter(h,k))) =>
         rqSmall(itAfter(h,j)) /\ rqSmall(itAfter(itAfter(h,j),p)) %(rq_both_lifts_small)% %implied
    . rqAnnihilator(p) /\ rqSmall(t) /\ rqSmall(itAfter(t,p)) =>
         rsCentre(t) = rsCentre(itAfter(t,p)) %(rq_annihilator_matches_centres)% %implied
    . rqAnnihilator(p) /\ (forall k : VNat . rqSmall(itAfter(h,k))) =>
         rsCentre(itAfter(h,j)) = rsCentre(itAfter(itAfter(h,p),j)) %(rq_centres_match_on_small_suffix)% %implied
    . rqAnnihilator(p) /\ not p = vZ => rqEventually(p) %(rq_annihilator_yields_eventual_period)% %implied
    . not p = vZ => (rqEventually(p) <=> rqAnnihilator(p)) %(rq_actual_eventual_period_exact)% %implied
end


%% B(n,k;x) is the upper binomial tail with n trials and threshold k.
%% The finite recurrence implements the probability of at least k successes.
%% Interpret x in [0,1] by the functional calculus of the original transfer.
spec YangBernsteinPositiveFilter =
  sort YBFReal
  free type YBFNat ::= ybfZ | ybfS(YBFNat)
  ops ybfZero, ybfOne : YBFReal;
      ybfMix : YBFReal * YBFReal * YBFReal -> YBFReal;
      ybfFilter : YBFNat * YBFNat * YBFReal -> YBFReal
  preds ybfUnit : YBFReal;
        ybfLE : YBFReal * YBFReal;
        ybfLayer : YBFNat

  . ybfUnit(ybfZero) %(ybf_zero_unit)%
  . ybfUnit(ybfOne) %(ybf_one_unit)%
  . ybfLE(ybfZero,ybfOne) %(ybf_endpoints_order)%
  forall s : YBFReal
    . ybfLE(s,s) %(ybf_order_reflexive)%
    . ybfUnit(s) => ybfLE(s,ybfOne) %(ybf_unit_below_one)%
  forall x,a,b,c,d : YBFReal
    %% Mix(x,a,b) = x*a + (1-x)*b for the real interpretation.
    . ybfUnit(x) /\ ybfUnit(a) /\ ybfUnit(b) =>
      ybfUnit(ybfMix(x,a,b)) %(ybf_mixture_unit)%
    . ybfUnit(x) /\ ybfLE(a,c) /\ ybfLE(b,d) =>
      ybfLE(ybfMix(x,a,b),ybfMix(x,c,d)) %(ybf_mixture_order)%

  forall n,k : YBFNat; x : YBFReal
    . k=ybfZ \/ (exists u : YBFNat . k=ybfS(u)) %(ybf_nat_cases)%
    . ybfFilter(n,ybfZ,x)=ybfOne %(ybf_empty_threshold)%
    . ybfFilter(ybfZ,ybfS(k),x)=ybfZero %(ybf_empty_trials)%
    . ybfFilter(ybfS(n),ybfS(k),x)=
      ybfMix(x,ybfFilter(n,k,x),ybfFilter(n,ybfS(k),x)) %(ybf_pascal_tail)%
    . ybfLayer(n) <=>
      (forall u : YBFNat; a : YBFReal . ybfUnit(a) =>
        ybfUnit(ybfFilter(n,u,a)) /\
        ybfLE(ybfFilter(n,ybfS(u),a),ybfFilter(n,u,a))) %(ybf_layer_def)%

  . (ybfLayer(ybfZ) /\ (forall n : YBFNat . ybfLayer(n) => ybfLayer(ybfS(n)))) =>
    (forall n : YBFNat . ybfLayer(n)) %(ybf_free_induction)%

  forall n,k : YBFNat; x : YBFReal
    . ybfUnit(ybfFilter(ybfZ,k,x)) %(ybf_base_range)% %implied
    . ybfLE(ybfFilter(ybfZ,ybfS(k),x),ybfFilter(ybfZ,k,x))
        %(ybf_base_monotone)% %implied
    . ybfLayer(ybfZ) %(ybf_layer_base)% %implied
    . ybfLayer(n) /\ ybfUnit(x) => ybfUnit(ybfFilter(n,k,x))
        %(ybf_prior_range)% %implied
    . ybfLayer(n) /\ ybfUnit(x) => ybfLE(ybfFilter(n,ybfS(k),x),ybfFilter(n,k,x))
        %(ybf_prior_monotone)% %implied
    . ybfLayer(n) /\ ybfUnit(x) => ybfUnit(ybfFilter(ybfS(n),ybfS(k),x))
        %(ybf_step_nonzero_range)% %implied
    . ybfLayer(n) /\ ybfUnit(x) => ybfUnit(ybfFilter(ybfS(n),k,x))
        %(ybf_step_range)% %implied
    . ybfLayer(n) /\ ybfUnit(x) =>
      ybfLE(ybfFilter(ybfS(n),ybfS(ybfS(k)),x),ybfFilter(ybfS(n),ybfS(k),x))
        %(ybf_step_nonzero_monotone)% %implied
    . ybfLayer(n) /\ ybfUnit(x) =>
      ybfLE(ybfFilter(ybfS(n),ybfS(k),x),ybfFilter(ybfS(n),k,x))
        %(ybf_step_monotone)% %implied
    . ybfLayer(n) => ybfLayer(ybfS(n)) %(ybf_layer_step)% %implied
    . ybfLayer(n) %(ybf_layer_induction)% %implied
    . ybfUnit(x) => ybfUnit(ybfFilter(n,k,x)) %(ybf_probability_filter_positive)% %implied
    . ybfUnit(x) => ybfLE(ybfFilter(n,ybfS(k),x),ybfFilter(n,k,x))
        %(ybf_above_threshold_monotone)% %implied
end

%% Tail(m,r) is the limiting physical spectral mass above r.
%% LimitRead(m,r) is the limsup of moving-cut filter readings at a fixed r.
%% The strict-band inequalities follow from the binomial concentration estimate
%% and weak convergence for finite subprobability measures. Their analytic
%% proof is in the companion note. They quantify over two distinct thresholds.
spec YangBernsteinBandReturn = YangBernsteinPositiveFilter then
  sorts YBFMeasure, YBFThreshold
  ops ybfTailMass, ybfLimitRead : YBFMeasure * YBFThreshold -> YBFReal
  preds ybfBelow : YBFThreshold * YBFThreshold;
        ybfPhysicalCeiling, ybfFilterCertificate : YBFMeasure * YBFThreshold

  forall q,r : YBFThreshold
    . ybfBelow(q,r) => (exists s : YBFThreshold . ybfBelow(q,s) /\ ybfBelow(s,r))
        %(ybf_intermediate_band)%
  forall m : YBFMeasure; q,r : YBFThreshold
    . ybfPhysicalCeiling(m,q) <=>
      (forall s : YBFThreshold . ybfBelow(q,s) => ybfTailMass(m,s)=ybfZero)
        %(ybf_ceiling_by_open_bands)%
    . ybfFilterCertificate(m,q) <=>
      (forall s : YBFThreshold . ybfBelow(q,s) => ybfLimitRead(m,s)=ybfZero)
        %(ybf_certificate_by_all_margins)%
    . ybfBelow(q,r) => ybfLE(ybfTailMass(m,r),ybfLimitRead(m,q))
        %(ybf_filter_lower_band)%
    . ybfBelow(q,r) => ybfLE(ybfLimitRead(m,r),ybfTailMass(m,q))
        %(ybf_filter_upper_band)%
    . ybfUnit(ybfTailMass(m,q)) %(ybf_tail_nonnegative)%
    . ybfUnit(ybfLimitRead(m,q)) %(ybf_read_nonnegative)%
  forall a : YBFReal
    . ybfUnit(a) /\ ybfLE(a,ybfZero) => a=ybfZero %(ybf_positive_zero_squeeze)%

  forall m : YBFMeasure; q,r : YBFThreshold
    . ybfBelow(q,r) /\ ybfLimitRead(m,q)=ybfZero => ybfTailMass(m,r)=ybfZero
        %(ybf_zero_read_returns_band)% %implied
    . ybfBelow(q,r) /\ ybfTailMass(m,q)=ybfZero => ybfLimitRead(m,r)=ybfZero
        %(ybf_zero_band_bounds_read)% %implied
    . ybfPhysicalCeiling(m,q) => ybfFilterCertificate(m,q)
        %(ybf_ceiling_gives_certificate)% %implied
    . ybfFilterCertificate(m,q) => ybfPhysicalCeiling(m,q)
        %(ybf_certificate_gives_ceiling)% %implied
    . ybfPhysicalCeiling(m,q) <=> ybfFilterCertificate(m,q)
        %(ybf_exact_rate_free_band_return)% %implied
end


%% Ratio equations on one commuting physical spectral algebra. Scalar variables
%% model x^n, r^n and the marked spectral response.
spec YangDyadicBand =
  sort YLScalar
  ops ylUnit : YLScalar;
      ylAdd, ylSub, ylMul : YLScalar * YLScalar -> YLScalar;
      ylSq, ylDen, ylComplement : YLScalar -> YLScalar
  preds ylRead : YLScalar * YLScalar * YLScalar;
        ylDoubleRead : YLScalar * YLScalar
  forall x,y,z : YLScalar
    . ylMul(ylMul(x,y),z) = ylMul(x,ylMul(y,z)) %(yl_assoc)%
    . ylMul(ylAdd(x,y),z) = ylAdd(ylMul(x,z),ylMul(y,z)) %(yl_right_dist)%
    . ylSq(x) = ylMul(x,x) %(yl_sq_def)%
    . ylSq(ylMul(x,y)) = ylMul(ylSq(x),ylSq(y)) %(yl_sq_product)%
    . ylComplement(x) = ylSub(ylUnit,x) %(yl_complement_def)%
    . ylDen(x) = ylAdd(ylSq(x),ylSq(ylComplement(x))) %(yl_den_def)%
    . ylRead(x,y,z) <=> (x = ylMul(z,ylAdd(x,y)) /\
                         y = ylMul(ylComplement(z),ylAdd(x,y))) %(yl_ratio_def)%
    . ylDoubleRead(x,y) <=> (ylSq(x) = ylMul(y,ylDen(x)) /\
                             ylSq(ylComplement(x)) = ylMul(ylComplement(y),ylDen(x)))
          %(yl_doubled_ratio_def)%
  forall p,s : YLScalar
    . ylAdd(ylMul(ylSq(p),s),ylMul(ylSq(ylComplement(p)),s)) = ylMul(ylDen(p),s)
          %(yl_fold_den)% %implied
  forall p,q,s : YLScalar
    . ylDoubleRead(p,q) => ylMul(ylSq(p),s) = ylMul(q,ylMul(ylDen(p),s))
          %(yl_double_first_scaled)% %implied
    . ylDoubleRead(p,q) =>
         ylMul(ylSq(ylComplement(p)),s) = ylMul(ylComplement(q),ylMul(ylDen(p),s))
          %(yl_double_second_scaled)% %implied
  forall x,y,p,q : YLScalar
    . ylRead(x,y,p) => ylSq(x) = ylMul(ylSq(p),ylSq(ylAdd(x,y)))
          %(yl_square_first_channel)% %implied
    . ylRead(x,y,p) => ylSq(y) = ylMul(ylSq(ylComplement(p)),ylSq(ylAdd(x,y)))
          %(yl_square_second_channel)% %implied
    . ylRead(x,y,p) => ylAdd(ylSq(x),ylSq(y)) = ylMul(ylDen(p),ylSq(ylAdd(x,y)))
          %(yl_paired_denominator)% %implied
    . ylRead(x,y,p) /\ ylDoubleRead(p,q) =>
          ylSq(x) = ylMul(q,ylAdd(ylSq(x),ylSq(y))) %(yl_doubling_first_return)% %implied
    . ylRead(x,y,p) /\ ylDoubleRead(p,q) =>
          ylSq(y) = ylMul(ylComplement(q),ylAdd(ylSq(x),ylSq(y)))
          %(yl_doubling_second_return)% %implied
    . ylRead(x,y,p) /\ ylDoubleRead(p,q) => ylRead(ylSq(x),ylSq(y),q)
          %(yl_exact_dyadic_ratio)% %implied
end


%% This module is the 0-truncated predicate fragment of the slice adjunction.
%% HPBase and HPField carry original boundary and field marks. The explicit
%% pullback domain is the subobject of compatible pairs; it can be empty.
spec HigherToposMarks =
  sorts HPBase, HPField, HPRefinement, HPBasePredicate, HPFieldPredicate
  ops hpBoundary : HPField -> HPBase;
      hpRefines : HPRefinement -> HPBase
  preds hpHoldsBase : HPBasePredicate * HPBase;
        hpHoldsField : HPFieldPredicate * HPField;
        hpRestrict : HPBasePredicate * HPField;
        hpSome, hpAll : HPFieldPredicate * HPBase;
        hpMatch : HPRefinement * HPField;
        hpSomePull, hpAllPull : HPFieldPredicate * HPRefinement;
        hpMeetSome : HPFieldPredicate * HPBasePredicate * HPBase;
        hpImpliesAll : HPFieldPredicate * HPBasePredicate * HPBase

  forall p : HPBasePredicate; f : HPField
    . hpRestrict(p,f) <=> hpHoldsBase(p,hpBoundary(f)) %(hp_pull_definition)%
  forall p : HPFieldPredicate; b : HPBase
    . hpSome(p,b) <=> (exists f : HPField . hpBoundary(f)=b /\ hpHoldsField(p,f))
        %(hp_sigma_definition)%
    . hpAll(p,b) <=> (forall f : HPField . hpBoundary(f)=b => hpHoldsField(p,f))
        %(hp_pi_definition)%
  forall r : HPRefinement; f : HPField
    . hpMatch(r,f) <=> hpBoundary(f)=hpRefines(r) %(hp_pullback_definition)%
  forall p : HPFieldPredicate; r : HPRefinement
    . hpSomePull(p,r) <=> (exists f : HPField . hpMatch(r,f) /\ hpHoldsField(p,f))
        %(hp_pull_sigma_definition)%
    . hpAllPull(p,r) <=> (forall f : HPField . hpMatch(r,f) => hpHoldsField(p,f))
        %(hp_pull_pi_definition)%
  forall p : HPFieldPredicate; q : HPBasePredicate; b : HPBase
    . hpMeetSome(p,q,b) <=> (exists f : HPField .
         hpBoundary(f)=b /\ hpHoldsField(p,f) /\ hpRestrict(q,f))
         %(hp_sigma_meet_definition)%
    . hpImpliesAll(p,q,b) <=> (forall f : HPField .
         hpBoundary(f)=b /\ hpRestrict(q,f) => hpHoldsField(p,f))
         %(hp_pi_implies_definition)%

  forall p : HPFieldPredicate; f : HPField; b : HPBase
    . hpHoldsField(p,f) => hpSome(p,hpBoundary(f)) %(hp_sigma_unit)% %implied
    . hpAll(p,hpBoundary(f)) => hpHoldsField(p,f) %(hp_pi_counit)% %implied
    . hpSome(p,b) => (exists w : HPField . hpBoundary(w)=b /\ hpHoldsField(p,w))
        %(hp_sigma_recovers_original_field)% %implied
    . hpAll(p,b) /\ hpBoundary(f)=b => hpHoldsField(p,f)
        %(hp_pi_tests_original_field)% %implied
  forall p : HPFieldPredicate; q : HPBasePredicate
    . (forall b : HPBase . hpSome(p,b) => hpHoldsBase(q,b)) <=>
      (forall f : HPField . hpHoldsField(p,f) => hpRestrict(q,f))
        %(hp_sigma_left_adjunction)% %implied
    . (forall f : HPField . hpRestrict(q,f) => hpHoldsField(p,f)) <=>
      (forall b : HPBase . hpHoldsBase(q,b) => hpAll(p,b))
        %(hp_pi_right_adjunction)% %implied
  forall p : HPFieldPredicate; r : HPRefinement
    . hpSomePull(p,r) <=> hpSome(p,hpRefines(r))
        %(hp_sigma_beck_chevalley)% %implied
    . hpAllPull(p,r) <=> hpAll(p,hpRefines(r))
        %(hp_pi_beck_chevalley)% %implied
    . hpSomePull(p,r) =>
       (exists f : HPField . hpBoundary(f)=hpRefines(r) /\ hpHoldsField(p,f))
        %(hp_pullback_recovers_original_mark)% %implied
  forall p : HPFieldPredicate; q : HPBasePredicate; b : HPBase
    . hpMeetSome(p,q,b) <=> hpSome(p,b) /\ hpHoldsBase(q,b)
        %(hp_sigma_frobenius)% %implied
    . hpImpliesAll(p,q,b) <=> (hpHoldsBase(q,b) => hpAll(p,b))
        %(hp_pi_implication_projection)% %implied
end

%% A probe ranges over full marked linear combinations of original Wilson
%% words, not isolated labels of basis words. A cover bears one continuum
%% system, physical lag and fixed ceiling. Local tests are restrictions of
%% the original Gram form, and the final premise is the separate spectral
%% calculus theorem on a total span in that original system.
spec YangPhysicalProbeDescent =
  sorts HPSystem, HPLag, HPCeiling, HPChart, HPVector
  preds hyChart : HPSystem * HPChart;
        hyProbe : HPSystem * HPVector;
        hyAdmits : HPSystem * HPChart * HPVector;
        hyCover : HPSystem;
        hyOriginalGram : HPSystem * HPLag * HPCeiling * HPVector;
        hyLocalGram : HPSystem * HPChart * HPLag * HPCeiling;
        hyGlobalGram : HPSystem * HPLag * HPCeiling;
        hyAllCharts : HPSystem * HPLag * HPCeiling;
        hyAcceptedTotal : HPSystem;
        hyValidClock : HPLag * HPCeiling;
        hyOriginalPhysicalGap : HPSystem * HPLag * HPCeiling

  forall s : HPSystem; c : HPChart; v : HPVector; t : HPLag; q : HPCeiling
    . hyChart(s,c) /\ hyAdmits(s,c,v) => hyProbe(s,v) %(hy_incidence_preserves_scope)%
    . hyCover(s) <=> (forall w : HPVector . hyProbe(s,w) =>
         (exists u : HPChart . hyChart(s,u) /\ hyAdmits(s,u,w)))
         %(hy_cover_definition)%
    . hyLocalGram(s,c,t,q) <=>
         (forall w : HPVector . hyAdmits(s,c,w) => hyOriginalGram(s,t,q,w))
         %(hy_local_gram_definition)%
    . hyGlobalGram(s,t,q) <=>
         (forall w : HPVector . hyProbe(s,w) => hyOriginalGram(s,t,q,w))
         %(hy_global_gram_definition)%
    . hyAllCharts(s,t,q) <=>
         (forall u : HPChart . hyChart(s,u) => hyLocalGram(s,u,t,q))
         %(hy_all_charts_definition)%
    . hyAcceptedTotal(s) /\ hyValidClock(t,q) =>
         (hyGlobalGram(s,t,q) <=> hyOriginalPhysicalGap(s,t,q))
         %(hy_import_exact_total_spectral_test)%

  forall s : HPSystem; c : HPChart; v : HPVector; t : HPLag; q : HPCeiling
    . hyGlobalGram(s,t,q) /\ hyChart(s,c) => hyLocalGram(s,c,t,q)
         %(hy_grain_restriction)% %implied
    . hyGlobalGram(s,t,q) => hyAllCharts(s,t,q)
         %(hy_global_restricts_to_every_chart)% %implied
    . hyAllCharts(s,t,q) /\ hyChart(s,c) /\ hyAdmits(s,c,v) =>
         hyOriginalGram(s,t,q,v) %(hy_chart_tests_original_vector)% %implied
    . hyCover(s) /\ hyAllCharts(s,t,q) /\ hyProbe(s,v) => hyOriginalGram(s,t,q,v)
         %(hy_original_vector_return)% %implied
    . hyCover(s) /\ hyAllCharts(s,t,q) => hyGlobalGram(s,t,q)
         %(hy_covered_gram_descent)% %implied
    . hyCover(s) => (hyAllCharts(s,t,q) <=> hyGlobalGram(s,t,q))
         %(hy_covered_gram_iff)% %implied
    . hyCover(s) /\ hyAcceptedTotal(s) /\ hyValidClock(t,q) =>
         (hyAllCharts(s,t,q) <=> hyOriginalPhysicalGap(s,t,q))
         %(hy_gap_descends_on_same_physical_system)% %implied
end


%% A real scalar interface for the normalized-trace Wilson proof.
%% rho is the Ricci lower bound and ell = beta * alpha_rho.
%% Every named scalar premise is an elementary real-arithmetic identity
%% or order law. Ground-state, covariance and limiting premises appear
%% only in the second specification.
spec WilsonStrongCouplingAlgebra =
  sort WScalar
  ops wZero, wOne : WScalar;
      wAdd, wSub, wMul, wDiv : WScalar * WScalar -> WScalar;
      wTwo, wFour, wNine, wEighteen, wTwenty : WScalar -> WScalar;
      wSqrt, wExp, wAcosh : WScalar -> WScalar
  preds wLe, wLt : WScalar * WScalar;
        wStrong : WScalar * WScalar
  ops wC, wD, wHalfGap, wTransfer, wEdge : WScalar * WScalar -> WScalar
  forall a,b,c : WScalar
  . wLt(a,b) /\ wLt(b,c) => wLt(a,c) %(wa_lt_trans)%
  . wLe(a,b) /\ wLe(b,c) => wLe(a,c) %(wa_le_trans)%
  . wLt(a,b) => wLe(a,b) %(wa_strict_to_weak)%
  . wLe(a,a) %(wa_le_refl)%
  . wLt(a,b) => not wLe(b,a) %(wa_incompatible)%
  . wLt(wTwenty(b),a) <=> wLt(wTwo(b),wSub(a,wEighteen(b)))
       %(wa_twenty_to_e)%
  . wLt(wTwenty(b),a) <=> wLt(b,wSub(wDiv(a,wTwo(wOne)),wNine(b)))
       %(wa_twenty_to_half)%
  . wAdd(wNine(b),wSub(wDiv(a,wTwo(wOne)),wNine(b))) = wDiv(a,wTwo(wOne))
       %(wa_half_gap_restore)%
  . wLt(a,b) => wLt(wAdd(c,a),wAdd(c,b)) %(wa_add_strict)%
  . wLe(a,b) => wLe(wAdd(c,a),wAdd(c,b)) %(wa_add_mono)%
  . wLt(wZero,a) /\ wLt(a,b) => wLt(wDiv(wMul(a,a),b),b)
       %(wa_compare_square_division)%
  . wLe(a,b) /\ wLe(wZero,c) => wLe(wMul(a,c),wMul(b,c))
       %(wa_nonnegative_multiplication)%
  . wLt(wZero,a) => wLt(wZero,wTwo(a)) %(wa_two_positive)%
  . wLt(wZero,a) /\ wLt(a,b) => wLt(wZero,wSub(wMul(b,b),wMul(a,a)))
       %(wa_square_difference_positive)%
  . wLt(wZero,a) => wLt(wZero,wSqrt(a)) %(wa_sqrt_pos)%
  . wLt(wZero,a) => wMul(wSqrt(a),wSqrt(a)) = a %(wa_sqrt_square)%
  . wMul(wTwo(a),wTwo(a)) = wFour(wMul(a,a)) %(wa_square_two)%
  . wMul(wAdd(a,b),wSub(a,b)) = wSub(wMul(a,a),wMul(b,b))
       %(wa_difference_of_squares)%
  . wSub(a,wSub(a,b)) = b %(wa_sub_involution)%
  . wLt(wZero,a) /\ wLt(a,b) /\ wLt(wZero,c) =>
       wLt(wDiv(a,wAdd(b,c)),wOne) %(wa_ratio_strict_contraction)%
  . wLt(wZero,a) /\ wLt(a,b) /\ wLt(wZero,c) /\
       wMul(c,c)=wSub(wMul(b,b),wMul(a,a)) =>
       wExp(wSub(wZero,wAcosh(wDiv(b,a))))=wDiv(a,wAdd(b,c))
       %(wa_acosh_exp_identity)%
  . wLt(wZero,a) /\ wLt(a,b) => wLt(wZero,wAcosh(wDiv(b,a)))
       %(wa_acosh_positive)%
  . wStrong(a,b) <=> (wLt(wZero,b) /\ wLt(wTwenty(b),a)) %(wa_strong_def)%
  . wC(a,b)=wSub(a,wEighteen(b)) %(wa_c_def)%
  . wHalfGap(a,b)=wSub(wDiv(a,wTwo(wOne)),wNine(b)) %(wa_half_gap_def)%
  . wD(a,b)=wSqrt(wSub(wMul(wC(a,b),wC(a,b)),wMul(wTwo(b),wTwo(b))))
       %(wa_d_def)%
  . wTransfer(a,b)=wDiv(wTwo(b),wAdd(wC(a,b),wD(a,b))) %(wa_transfer_def)%
  . wEdge(a,b)=wAcosh(wDiv(wC(a,b),wTwo(b))) %(wa_edge_def)%
  forall rho,ell : WScalar
  . wStrong(rho,ell) => wLt(wZero,ell) %(wa_ell_strict)% %implied
  . wStrong(rho,ell) => wLt(wZero,wTwo(ell)) %(wa_twice_ell_strict)% %implied
  . wStrong(rho,ell) => wLt(wTwo(ell),wC(rho,ell))
       %(wa_c_strict)% %implied
  . wStrong(rho,ell) => wLt(ell,wHalfGap(rho,ell))
       %(wa_half_gap_strict)% %implied
  . wStrong(rho,ell) =>
      wLt(wAdd(wNine(ell),wDiv(wMul(ell,ell),wHalfGap(rho,ell))),
           wDiv(rho,wTwo(wOne))) %(wa_no_first_hessian_crossing)% %implied
  . wStrong(rho,ell) =>
      wLt(wZero,wSub(wMul(wC(rho,ell),wC(rho,ell)),wMul(wTwo(ell),wTwo(ell))))
       %(wa_discriminant_positive)% %implied
  . wStrong(rho,ell) => wLt(wZero,wD(rho,ell)) %(wa_d_positive)% %implied
  . wStrong(rho,ell) =>
      wMul(wD(rho,ell),wD(rho,ell)) =
      wSub(wMul(wC(rho,ell),wC(rho,ell)),wMul(wTwo(ell),wTwo(ell)))
       %(wa_d_square)% %implied
  . wStrong(rho,ell) =>
      wMul(wAdd(wC(rho,ell),wD(rho,ell)),wSub(wC(rho,ell),wD(rho,ell))) =
       wFour(wMul(ell,ell)) %(wa_exact_score_factorization)% %implied
  . wStrong(rho,ell) => wLt(wTransfer(rho,ell),wOne)
       %(wa_strict_transfer)% %implied
  . wStrong(rho,ell) => wLt(wZero,wEdge(rho,ell)) %(wa_positive_edge)% %implied
  . wStrong(rho,ell) =>
      wExp(wSub(wZero,wEdge(rho,ell)))=wTransfer(rho,ell)
       %(wa_transfer_edge_exact)% %implied
end

%% The original operator and its positive-time clock. The companion proof
%% establishes the Hessian, conditional-score and Poincare comparison on each
%% genuine finite Wilson slice. Spacings measure the original physical time.
spec WilsonStrongCouplingClock = WilsonStrongCouplingAlgebra then
  sorts WCut, WTrajectory
  ops wRicci, wStrength, wSpacing, wCenteredNorm, wPhysicalGap : WCut -> WScalar;
      wTrajectoryRicci, wTrajectoryStrength : WTrajectory -> WScalar
  preds wOriginalWilson, wMarkedClock : WCut;
        wOriginalTrajectory, wRefinesToZero : WTrajectory;
        wCutOf : WTrajectory * WCut;
        wUniformStrictTransfer : WTrajectory * WScalar;
        wCenteredPositiveTimeCollapse, wNontrivialStrongHeatLimit : WTrajectory
  forall c : WCut
  . wOriginalWilson(c) /\ wStrong(wRicci(c),wStrength(c)) =>
      wLe(wCenteredNorm(c),wTransfer(wRicci(c),wStrength(c)))
       %(wc_import_ground_state_score_poincare)% 
  . wOriginalWilson(c) => wMarkedClock(c) %(wc_original_clock)% 
  forall c : WCut; x : WScalar
  . wMarkedClock(c) /\ wLt(wZero,wSpacing(c)) /\ wLt(wZero,x) /\
      wLe(wCenteredNorm(c),wExp(wSub(wZero,x))) =>
      wLe(wDiv(x,wSpacing(c)),wPhysicalGap(c))
       %(wc_import_physical_lag_spectral_calculus)% 
  forall p : WTrajectory; c : WCut
  . wOriginalTrajectory(p) /\ wCutOf(p,c) =>
     (wOriginalWilson(c) /\ wRicci(c)=wTrajectoryRicci(p) /\
      wStrength(c)=wTrajectoryStrength(p)) %(wc_fixed_theta)% 
  forall p : WTrajectory; x : WScalar
  . wUniformStrictTransfer(p,x) <=>
       (wLt(x,wOne) /\ (forall c : WCut . wCutOf(p,c) => wLe(wCenteredNorm(c),x)))
       %(wc_uniform_def)% 
  . wUniformStrictTransfer(p,x) /\ wRefinesToZero(p) =>
     wCenteredPositiveTimeCollapse(p) %(wc_import_geometric_decay_at_fixed_time)% 
  . wCenteredPositiveTimeCollapse(p) => not wNontrivialStrongHeatLimit(p)
       %(wc_import_injectivity_of_fixed_time_heat)% 
  forall c : WCut
  . wOriginalWilson(c) /\ wStrong(wRicci(c),wStrength(c)) =>
      wLe(wCenteredNorm(c),wExp(wSub(wZero,wEdge(wRicci(c),wStrength(c)))))
       %(wc_exact_norm_ceiling)% %implied
  . wOriginalWilson(c) /\ wStrong(wRicci(c),wStrength(c)) /\
      wLt(wZero,wSpacing(c)) =>
      wLe(wDiv(wEdge(wRicci(c),wStrength(c)),wSpacing(c)),wPhysicalGap(c))
       %(wc_original_cut_gap)% %implied
  forall p : WTrajectory; c : WCut
  . wOriginalTrajectory(p) /\ wStrong(wTrajectoryRicci(p),wTrajectoryStrength(p)) /\
      wCutOf(p,c) =>
      wLe(wCenteredNorm(c),wTransfer(wTrajectoryRicci(p),wTrajectoryStrength(p)))
       %(wc_same_trajectory_cut_bound)% %implied
  forall p : WTrajectory
  . wOriginalTrajectory(p) /\ wStrong(wTrajectoryRicci(p),wTrajectoryStrength(p)) =>
      wUniformStrictTransfer(p,wTransfer(wTrajectoryRicci(p),wTrajectoryStrength(p)))
       %(wc_uniform_original_trajectory)% %implied
  . wOriginalTrajectory(p) /\ wStrong(wTrajectoryRicci(p),wTrajectoryStrength(p)) /\
      wRefinesToZero(p) => wCenteredPositiveTimeCollapse(p)
       %(wc_strong_coupling_fixed_time_collapse)% %implied
  . wOriginalTrajectory(p) /\ wStrong(wTrajectoryRicci(p),wTrajectoryStrength(p)) /\
      wRefinesToZero(p) => not wNontrivialStrongHeatLimit(p)
       %(wc_same_trajectory_excludes_nontrivial_limit)% %implied
end


%% For a finite central quotient p:Gtilde -> G with identical pulled-back
%% Wilson action and boundary conditions, cqLift is pullback of marked words
%% and cqAverage is normalized linkwise averaging over ker(p).
%% The strict-half Gram premise is obtained by independence of the two
%% lifted half-edge sets conditional on the downstairs assignment.
%% The positive-time premise keeps the original physical time on both cuts.
spec CentralQuotientWilsonReturn =
  sorts CQUpper, CQLower, CQNumber, CQTime
  op cqZero : CQNumber
  ops cqLift : CQLower -> CQUpper;
      cqAverage : CQUpper -> CQLower;
      cqUpperVacuum : CQUpper;
      cqLowerVacuum : CQLower;
      cqUpperGram : CQUpper * CQUpper -> CQNumber;
      cqLowerGram : CQLower * CQLower -> CQNumber;
      cqUpperEvolve : CQTime * CQUpper -> CQUpper;
      cqLowerEvolve : CQTime * CQLower -> CQLower;
      cqProduct : CQNumber * CQNumber -> CQNumber
  preds cqPositiveTime : CQTime;
        cqLE : CQNumber * CQNumber;
        cqUpperCentered : CQUpper;
        cqLowerCentered : CQLower;
        cqUpperNull : CQUpper;
        cqLowerNull : CQLower;
        cqUpperCeiling, cqLowerCeiling : CQTime * CQNumber

  forall a,b : CQUpper; f,g : CQLower; s : CQTime; q : CQNumber
    . cqAverage(cqLift(f)) = f %(cq_haar_average_retraction)%
    . cqUpperGram(a,b) = cqLowerGram(cqAverage(a),cqAverage(b))
        %(cq_conditional_independence_reflected_gram)%
    . cqUpperVacuum = cqLift(cqLowerVacuum) %(cq_matched_vacuum)%
    . cqPositiveTime(s) =>
        cqUpperEvolve(s,a) = cqLift(cqLowerEvolve(s,cqAverage(a)))
        %(cq_pulled_kernel_same_time)%
    . cqUpperCentered(a) <=> cqUpperGram(cqUpperVacuum,a)=cqZero
        %(cq_upper_centered_def)%
    . cqLowerCentered(f) <=> cqLowerGram(cqLowerVacuum,f)=cqZero
        %(cq_lower_centered_def)%
    . cqUpperNull(a) <=> cqUpperGram(a,a)=cqZero %(cq_upper_null_def)%
    . cqLowerNull(f) <=> cqLowerGram(f,f)=cqZero %(cq_lower_null_def)%
    . cqUpperCeiling(s,q) <=>
        (forall u : CQUpper . cqUpperCentered(u) =>
           cqLE(cqUpperGram(u,cqUpperEvolve(s,u)),cqProduct(q,cqUpperGram(u,u))))
        %(cq_upper_ceiling_def)%
    . cqLowerCeiling(s,q) <=>
        (forall v : CQLower . cqLowerCentered(v) =>
           cqLE(cqLowerGram(v,cqLowerEvolve(s,v)),cqProduct(q,cqLowerGram(v,v))))
        %(cq_lower_ceiling_def)%

    . cqAverage(cqUpperVacuum)=cqLowerVacuum
        %(cq_average_returns_vacuum)% %implied
    . cqUpperGram(cqLift(f),cqLift(g)) = cqLowerGram(f,g)
        %(cq_lift_mixed_gram)% %implied
    . cqUpperGram(cqUpperVacuum,a)=cqLowerGram(cqLowerVacuum,cqAverage(a))
        %(cq_vacuum_mixed_gram)% %implied
    . cqUpperCentered(a) <=> cqLowerCentered(cqAverage(a))
        %(cq_average_reflects_centering)% %implied
    . cqLowerCentered(f) <=> cqUpperCentered(cqLift(f))
        %(cq_lift_reflects_centering)% %implied
    . cqUpperNull(a) <=> cqLowerNull(cqAverage(a))
        %(cq_average_reflects_os_null)% %implied
    . cqLowerNull(f) <=> cqUpperNull(cqLift(f))
        %(cq_lift_reflects_os_null)% %implied
    . cqPositiveTime(s) =>
        cqAverage(cqUpperEvolve(s,a)) = cqLowerEvolve(s,cqAverage(a))
        %(cq_average_time_intertwiner)% %implied
    . cqPositiveTime(s) =>
        cqUpperEvolve(s,cqLift(f)) = cqLift(cqLowerEvolve(s,f))
        %(cq_lift_time_intertwiner)% %implied
    . cqPositiveTime(s) =>
        cqUpperGram(a,cqUpperEvolve(s,b)) =
          cqLowerGram(cqAverage(a),cqLowerEvolve(s,cqAverage(b)))
        %(cq_average_returns_mixed_physical_heat)% %implied
    . cqPositiveTime(s) =>
        cqUpperGram(cqLift(f),cqUpperEvolve(s,cqLift(g))) =
          cqLowerGram(f,cqLowerEvolve(s,g))
        %(cq_lift_returns_mixed_physical_heat)% %implied
    . cqPositiveTime(s) /\ cqLowerCeiling(s,q) /\ cqUpperCentered(a) =>
        cqLE(cqUpperGram(a,cqUpperEvolve(s,a)),cqProduct(q,cqUpperGram(a,a)))
        %(cq_original_upper_probe_bound)% %implied
    . cqPositiveTime(s) /\ cqUpperCeiling(s,q) /\ cqLowerCentered(f) =>
        cqLE(cqLowerGram(f,cqLowerEvolve(s,f)),cqProduct(q,cqLowerGram(f,f)))
        %(cq_original_lower_probe_bound)% %implied
    . cqPositiveTime(s) /\ cqLowerCeiling(s,q) => cqUpperCeiling(s,q)
        %(cq_ceiling_lift)% %implied
    . cqPositiveTime(s) /\ cqUpperCeiling(s,q) => cqLowerCeiling(s,q)
        %(cq_ceiling_descend)% %implied
    . cqPositiveTime(s) => (cqUpperCeiling(s,q) <=> cqLowerCeiling(s,q))
        %(cq_same_physical_clock_exact_ceiling)% %implied
end


%% Relative squared norms on one original stationary Wilson slice.
%% The analytic companion proves the derivative with the conditional score
%% on the future gauge orbit and proves both discrepancy inequalities.
spec PhysicalQuotientScore =
  sorts QCSystem, QCWord, QCPhysicalSlice, QCBudget
  ops qcCost : QCSystem * QCPhysicalSlice -> QCBudget;
      qcOne, qcZero : QCBudget;
      qcRatio : QCBudget -> QCBudget
  preds qcLE : QCBudget * QCBudget;
        qcWord : QCSystem * QCWord;
        qcPoincareScore : QCSystem * QCPhysicalSlice * QCWord;
        qcReadBound : QCSystem * QCPhysicalSlice * QCWord * QCBudget;
        qcAtFixedLag, qcClosedMarkedLimit : QCSystem * QCPhysicalSlice;
        qcAllCutReads : QCSystem * QCPhysicalSlice * QCBudget;
        qcPhysicalSquaredCeiling : QCSystem * QCPhysicalSlice * QCBudget
  forall g : QCSystem; s : QCPhysicalSlice; w : QCWord; l,b : QCBudget
    . qcLE(l,b) => qcLE(qcRatio(l),qcRatio(b)) %(qc_ratio_increasing)%
    . qcLE(qcZero,l) => not qcLE(qcOne,qcRatio(l)) %(qc_ratio_strict)%
    . qcReadBound(g,s,w,l) /\ qcLE(l,b) => qcReadBound(g,s,w,b) %(qc_weaken_read_bound)%
    . qcPoincareScore(g,s,w) => qcReadBound(g,s,w,qcRatio(qcCost(g,s)))
          %(qc_import_projected_score_and_variance_inequality)%
    . qcAllCutReads(g,s,l) <=> (forall v : QCWord .
         qcWord(g,v) => qcReadBound(g,s,v,l)) %(qc_common_cut_read_def)%
    . qcAtFixedLag(g,s) /\ qcClosedMarkedLimit(g,s) /\ qcAllCutReads(g,s,l) =>
         qcPhysicalSquaredCeiling(g,s,l) %(qc_import_same_lag_total_domain_limit)%
  forall g : QCSystem; s : QCPhysicalSlice; w : QCWord; l : QCBudget
    . qcPoincareScore(g,s,w) /\ qcLE(qcCost(g,s),l) =>
         qcReadBound(g,s,w,qcRatio(l)) %(qc_uniform_bound_one_original_word)% %implied
  forall g : QCSystem; s : QCPhysicalSlice; l : QCBudget
    . (forall w : QCWord . qcWord(g,w) => qcPoincareScore(g,s,w)) /\ qcLE(qcCost(g,s),l) =>
         qcAllCutReads(g,s,qcRatio(l)) %(qc_uniform_bound_total_word_domain)% %implied
    . qcAtFixedLag(g,s) /\ qcClosedMarkedLimit(g,s) /\ qcLE(qcCost(g,s),l) /\
         (forall w : QCWord . qcWord(g,w) => qcPoincareScore(g,s,w)) =>
         qcPhysicalSquaredCeiling(g,s,qcRatio(l)) %(qc_same_physical_transfer_ceiling)% %implied
    . qcAtFixedLag(g,s) /\ qcClosedMarkedLimit(g,s) /\
         qcLE(qcZero,l) /\ qcLE(qcCost(g,s),l) /\
         (forall w : QCWord . qcWord(g,w) => qcPoincareScore(g,s,w)) =>
         (qcPhysicalSquaredCeiling(g,s,qcRatio(l)) /\ not qcLE(qcOne,qcRatio(l)))
          %(qc_strict_same_hamiltonian_ceiling)% %implied
end


%% Finite path variance on the original Markov law. All vector norms are
%% squared L2 norms on that law. Boundary pullback is an orthogonal projection.
%% The analytic proof supplies the centered adapted increments, endpoint
%% projection, and, separately, the fibrewise weighted Poisson equation.
spec WilsonPathScore =
  sorts WPSPath, WPSVec, WPSReal
  free type WPSNat ::= wpsZ | wpsS(WPSNat)
  ops wpsZero : WPSReal;
      wpsPlus : WPSReal * WPSReal -> WPSReal;
      wpsAdd : WPSVec * WPSVec -> WPSVec;
      wpsEnergy : WPSPath * WPSVec -> WPSReal;
      wpsStep, wpsHistory : WPSPath * WPSNat -> WPSVec;
      wpsBudget : WPSPath * WPSNat -> WPSReal;
      wpsProject : WPSPath * WPSVec -> WPSVec;
      wpsRaw, wpsEndpoint : WPSPath -> WPSVec;
      wpsAdjusted : WPSPath * WPSVec -> WPSVec
  preds wpsLE : WPSReal * WPSReal;
        wpsOrth : WPSPath * WPSVec * WPSVec;
        wpsAdapted : WPSPath;
        wpsTerminal : WPSPath * WPSNat;
        wpsSeam : WPSPath * WPSVec;
        wpsVarianceLaw : WPSNat;
        wpsMin : WPSPath * WPSReal

  forall p : WPSPath; v,w : WPSVec; n : WPSNat; a,b,c : WPSReal
    . wpsLE(a,a) %(wps_reflexive)%
    . wpsLE(a,b) /\ wpsLE(b,c) => wpsLE(a,c) %(wps_transitive)%
    . wpsOrth(p,v,w) =>
        wpsEnergy(p,wpsAdd(v,w)) = wpsPlus(wpsEnergy(p,v),wpsEnergy(p,w))
          %(wps_pythagoras)%
    . wpsLE(wpsEnergy(p,wpsProject(p,v)),wpsEnergy(p,v)) %(wps_projection_contracts)%
    . wpsEnergy(p,wpsHistory(p,wpsZ)) = wpsZero %(wps_zero_history)%
    . wpsBudget(p,wpsZ) = wpsZero %(wps_budget_zero)%
    . wpsHistory(p,wpsS(n)) = wpsAdd(wpsHistory(p,n),wpsStep(p,n)) %(wps_history_succ)%
    . wpsBudget(p,wpsS(n)) = wpsPlus(wpsBudget(p,n),wpsEnergy(p,wpsStep(p,n)))
          %(wps_budget_succ)%
    . wpsAdapted(p) => wpsOrth(p,wpsHistory(p,n),wpsStep(p,n))
          %(wps_import_martingale_increment)%
    . wpsTerminal(p,n) => wpsProject(p,wpsHistory(p,n)) = wpsEndpoint(p)
          %(wps_import_projected_endpoint_identity)%
    . wpsProject(p,wpsRaw(p)) = wpsEndpoint(p) %(wps_import_raw_endpoint_identity)%
    . wpsAdjusted(p,v) = wpsAdd(wpsRaw(p),v) %(wps_adjusted_def)%
    . wpsSeam(p,v) => wpsProject(p,wpsAdjusted(p,v)) = wpsProject(p,wpsRaw(p))
          %(wps_import_divergence_zero_on_fibre)%
    . (exists u : WPSVec . wpsSeam(p,u) /\ wpsAdjusted(p,u) = wpsEndpoint(p))
          %(wps_import_weighted_poisson_attainment)%
    . wpsMin(p,a) <=> ((exists u : WPSVec . wpsSeam(p,u) /\
                                            wpsEnergy(p,wpsAdjusted(p,u)) = a)
        /\ (forall u : WPSVec . wpsSeam(p,u) => wpsLE(a,wpsEnergy(p,wpsAdjusted(p,u)))))
          %(wps_minimum_definition)%
  forall n : WPSNat
    . wpsVarianceLaw(n) <=> (forall p : WPSPath . wpsAdapted(p) =>
          wpsEnergy(p,wpsHistory(p,n)) = wpsBudget(p,n)) %(wps_induction_invariant)%
  . (wpsVarianceLaw(wpsZ) /\ (forall n : WPSNat . wpsVarianceLaw(n) => wpsVarianceLaw(wpsS(n))))
       => (forall n : WPSNat . wpsVarianceLaw(n)) %(wps_free_nat_induction)%

  forall p : WPSPath; v : WPSVec; n : WPSNat; a : WPSReal
    . wpsVarianceLaw(wpsZ) %(wps_base_variance)% %implied
    . wpsAdapted(p) =>
        wpsEnergy(p,wpsHistory(p,wpsS(n))) =
           wpsPlus(wpsEnergy(p,wpsHistory(p,n)),wpsEnergy(p,wpsStep(p,n)))
          %(wps_successor_pythagoras)% %implied
    . wpsVarianceLaw(n) => wpsVarianceLaw(wpsS(n)) %(wps_variance_step)% %implied
    . wpsVarianceLaw(n) %(wps_all_finite_variances)% %implied
    . wpsAdapted(p) => wpsEnergy(p,wpsHistory(p,n)) = wpsBudget(p,n)
          %(wps_martingale_exact_variance)% %implied
    . wpsTerminal(p,n) => wpsLE(wpsEnergy(p,wpsEndpoint(p)),wpsEnergy(p,wpsHistory(p,n)))
          %(wps_projection_decreases_path_variance)% %implied
    . wpsTerminal(p,n) /\ wpsAdapted(p) => wpsLE(wpsEnergy(p,wpsEndpoint(p)),wpsBudget(p,n))
          %(wps_original_marked_endpoint_bound)% %implied
    . wpsTerminal(p,n) /\ wpsAdapted(p) /\ wpsLE(wpsBudget(p,n),a) =>
         wpsLE(wpsEnergy(p,wpsEndpoint(p)),a) %(wps_return_charged_bound)% %implied
    . wpsSeam(p,v) => wpsProject(p,wpsAdjusted(p,v)) = wpsEndpoint(p)
          %(wps_same_endpoint_after_seam)% %implied
    . wpsSeam(p,v) => wpsLE(wpsEnergy(p,wpsEndpoint(p)),wpsEnergy(p,wpsAdjusted(p,v)))
          %(wps_seam_cannot_reduce_endpoint_variance)% %implied
    . (exists u : WPSVec . wpsSeam(p,u) /\
                  wpsEnergy(p,wpsAdjusted(p,u)) = wpsEnergy(p,wpsEndpoint(p)))
          %(wps_endpoint_variance_attained)% %implied
    . wpsMin(p,wpsEnergy(p,wpsEndpoint(p))) %(wps_exact_physical_seam_minimum)% %implied
end
