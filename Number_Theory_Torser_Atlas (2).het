%% BEGIN_H24_ADJOINTS_GUIDE
%% CONSTRUCTIVE COMORPHISM, TRIPLE ADJOINTS, AND EVERY HYPOTHESIS
%% Continuation of the single Number_Theory_Torser_Atlas, 25 November 2026.
%%
%% The complete native proof is H24Complete.agda and its embedded imports.
%% All modules are checked with Agda --safe --without-K --double-check, with
%% fresh interfaces. The recovered RHPrelude and RHH24 are reused unchanged.
%% No mathematical library, postulate, hole, global function extensionality,
%% choice operator or K/UIP axiom is added. Parameters in theorem types remain
%% parameters: safe typechecking does not give inhabitants to arbitrary types.
%%
%% 1. THE CONSTRUCTED TRIPLE
%%
%% For f:X->Y and A:X->Type, retain the actual fibre
%%   Fib_f(y) = Sigma(x:X).(f(x)=y).
%% Define
%%   (f*B)(x)      = B(f(x)),
%%   (Sigma_f A)y  = Sigma(u:Fib_f(y)).A(u.first),
%%   (Pi_f A)y     = Pi(u:Fib_f(y)).A(u.first).
%% The equality witness in u is part of its type and is not discarded.
%%
%% For h:Hom_Y(Sigma_f A,B) and k:Hom_X(A,f*B), the left transposes are
%%   L(h)_x(a) = h_(f(x))((x,refl),a),
%%   L^-1(k)_y((x,p),a) = transport_B(p,k_x(a)).
%% For h:Hom_X(f*B,A) and k:Hom_Y(B,Pi_f A), the right transposes are
%%   R(h)_y(b)(x,p) = h_x(transport_B(p^-1,b)),
%%   R^-1(k)_x(b) = k_(f(x))(b)(x,refl).
%% Substitution proves both beta laws. Identity elimination on p proves the eta
%% laws, with every function equality stated at an arbitrary argument. Units
%% and counits are the transposes of identity maps. Their four triangle laws
%% therefore compute by the same pairing, evaluation and identity elimination.
%% The six functor laws and four naturality laws are checked in the same core.
%%
%% The H24 policy reconstructs all 25 recovered universal theorem families from
%% their explicit constructive recipes. Old theorem declarations are removed
%% from its imported definitions-only module. The one rank-recursive builder
%% constructs each clause's complete term and pattern syntax. The independent
%% Python replay verifies source identity, contexts, all premises and ranks;
%% Agda checks the resulting dependent proof terms. This is verified recipe
%% reconstruction, not a claim to discover arbitrary proofs automatically.
%% The 244 shared / 246 expanded construction counts are syntax counts, not
%% minimum inference counts, proof grades, or bit clocks.
%%
%% 2. BASE CHANGE, CANONICITY, AND CALCULATION REDUCTIONS
%%
%% For g:Y'->Y use the actual pullback
%%   X' = Sigma(y':Y').Fib_f(g(y')).
%% The fibre comparison inserts the supplied point y' and reflexivity:
%%   I(x,p) = ((y',(x,p)),refl).
%% Its inverse sends (((y'',(x,p)),r)) to
%%   P(((y'',(x,p)),r)) = (x,p . ap_g(r)).
%% Identity elimination and the path right-unit law give their inverse returns.
%% Sigma comparisons retain the same payload, while Pi comparisons precompose
%% the entire section with I or P. This proves both Beck--Chevalley returns.
%% It selects no point from any fibre. The empty-source instance separately
%% constructs its vacuous Pi section and refutes a putative fibre selector.
%%
%% H24FamilyCalculations.agda adds native constructive proofs of:
%%   Sigma_f(A times f*B) ~= (Sigma_f A) times B       [Frobenius]
%%   Sigma_g(Sigma_f A) ~= Sigma_(g o f) A
%%   Pi_g(Pi_f A) ~= Pi_(g o f) A.
%% The Sigma composition sends ((y,q),((x,p),a)) to
%%   ((x,ap_g(p).q),a);
%% its inverse inserts y=f(x), with inner equality refl.
%% Pi composition precomposes a section with those same fibre maps. Both
%% inverse directions are checked, pointwise where the result is a function.
%% Frobenius moves B evidence with its retained equality p and returns it with
%% p^-1. Equality induction proves both inverse equations.
%%
%% Canonicity is proved at the universal property, not by choosing a code:
%% if L(h)=k pointwise, then h=L^-1(k) at every original pair; if R^-1(h)=k,
%% then h=R(k) at every original section argument. These uniqueness proofs
%% reduce to the supplied equality at p=refl. They determine the transposes
%% relative to the given f and indexed families, without a global normal-form
%% oracle or an extensionality axiom.
%%
%% For independent positive/negative evidence families A=(A+,A-), define
%%   Hom_s(A,B)=Hom(A+,B+) times Hom(B-,A-).
%% Reusing the one unsigned triple gives
%%   Sigma^s_f A=(Sigma_f A+,Pi_f A-),
%%   f* A=(f*A+,f*A-),
%%   Pi^s_f A=(Pi_f A+,Sigma_f A-).
%% All eight rail components of the two hom-equivalence inverse laws are
%% checked. Negative evidence is independently typed; it is not silently
%% identified with classical complement. When negative evidence is an actual
%% refuter, not(Sigma_i A_i) <-> Pi_i not(A_i) is constructed by pairing and
%% evaluation, with both pointwise inverse laws.
%%
%% 3. A CONCRETE CONSTRUCTIVE INSTITUTION COMORPHISM
%%
%% H24Comorphism.agda constructs an evidence-valued institution presentation.
%% Signatures are atom types A. Sentences use atoms, top, bottom, conjunction,
%% disjunction, implication, and all/some over arbitrary retained small domains
%% I. Models are valuations A->Type. Satisfaction is the recursive evidence
%% type Sem(V,formula). Signature arrows rename atoms; model reduct precomposes
%% the valuation. Formula equality is a structural setoid with pointwise binder
%% congruence. Its equivalence laws, renaming laws, and evidence invariance are
%% proved structurally; no equality of whole functions is postulated.
%%
%% For any supplied frame f:F, the actual comorphism is
%%   Phi(A)=A times F,
%%   Phi(h)(a,g)=(h(a),g),
%%   alpha_f=rename(a |-> (a,f)),
%%   beta_f(W)(a)=W(a,f).
%% The record EvidenceComorphism is inhabited by these definitions and their
%% proved identity/composition, sentence naturality, model naturality, and
%% satisfaction maps:
%%   Sem(beta_f W,p) -> Sem(W,alpha_f p),
%%   Sem(W,alpha_f p) -> Sem(beta_f W,p).
%% The proof recurses through the entire formula. Implication transports its
%% input in the reverse direction; all/some preserve the original bound type,
%% witness and dependent evidence. This is an actual constructed framed
%% comorphism. It does not assert that every arbitrary logic translation has
%% the same properties, nor register a new Hets logic plugin.
%%
%% There is an explicit expansion expand(V)(a,g)=V(a), so
%%   beta_f(expand(V))(a)=V(a)
%% by computation. Consequently translated entailments reflect to the same
%% original formula and full original hypothesis context. No model-existence
%% or global model-choice principle is required for this concrete expansion.
%% Erasing the frame after sentence encoding returns the original formula in
%% the structural setoid, preserving every quantifier.
%%
%% 4. H24 CONSTRUCTION COMMUTES WITH THE PROOF TRANSLATION
%%
%% H24RuleComorphism.agda imports the SAME RHH24.Derivation, rather than adding
%% a second proof-tree datatype. Given S with judgements J, form target
%% judgements J times F. At (j,f) use the original rule at j, its original charge,
%% and every original premise tagged with the same f. Translation and reduct
%% are structural recursions on all children. The full-tree relation TreeSame
%% records identical rules and pointwise equality of every finite premise
%% tree. It avoids assuming equality of function-valued child arrays.
%%
%% Both decode(encode_f(p)) ~= p and encode_f(decode(q)) ~= q are constructed.
%% Every root assumption and every addressed child assumption is preserved in
%% both directions. Recharting composes, and work is unchanged, by induction.
%%
%% The source calibration and tight ranked policy pull back by projection:
%%   targetPotential(j,f)=sourcePotential(j),
%%   targetRank(j,f)=sourceRank(j),
%%   targetChosen(j,f)=sourceChosen(j).
%% Their local identity, tightness and rank decrease proofs are the original
%% ones at j, so no additional feasibility or termination assumption appears.
%% Fuel induction then constructs
%%   decode(buildFuel(targetPolicy,n,(j,f))) ~= buildFuel(sourcePolicy,n,j),
%% and at the rank-derived public fuel,
%%   decode(build(targetPolicy,(j,f))) ~= build(sourcePolicy,j),
%%   build(targetPolicy,(j,f)) ~= encode_f(build(sourcePolicy,j)).
%% This is a theorem about the actual recursive producer. Its induction visits
%% every original premise, rather than assuming a completed target proof.
%% The original calibrated minimum theorem applies to the constructed target
%% proof because every source rule, charge, competitor and rank is retained.
%%
%% For an admitted task domain use J equal to that domain, with its actual
%% closure certificate. A tight policy on all raw judgements is not asserted.
%% The four earlier original equational goals and their direct H24 certificates
%% remain unchanged. Existing matrix, dagger and paracollatz source returns
%% provide their concrete coefficient interpretations, not extra logical rules.
%%
%% 5. WHAT 'EVERY HYPOTHESIS' MEANS IN THE PROOF OBJECT
%%
%% A context Gamma=(H1,...,Hn) is interpreted by the full ordered product
%%   Env_V(Gamma)=Sem(V,H1) times ... times Sem(V,Hn).
%% Entails(Gamma,P) is a function from this actual evidence to Sem(V,P), uniform
%% in V. Given a constructor for each hypothesis from Delta, their product
%% supplied:Env_V(Delta)->Env_V(Gamma) gives
%%   substituteAllHypotheses(supplied,t)(V,d)=t(V,supplied(V,d)).
%% Empty/cons constructors assemble the evidence one hypothesis at a time.
%% For Delta empty this closes the theorem. Translation and reflection carry
%% this complete environment; none of its inputs is relabeled as a proof.
%%
%% The theorem noBlanketErasure proves why a missing input cannot simply be
%% removed: a proposed universal eraser would turn bottom |- bottom into
%% empty |- bottom, which evaluates to an element of the empty type. This
%% constructive countermodel is not a claim about which particular number-
%% theory statements are true; it characterizes the missing constructor exactly.
%%
%% The compact hypothesis ledger and complete declaration index distinguish
%% definitions, structure parameters, admitted source theorems, constructed
%% returns, and remaining instance obligations. Source assumptions keep their
%% identity and context even when a literal subexpression is shared in a DAG.
%%
%% 6. NUMBER-THEORY REDUCTIONS AND MINIMAL DEPENDENCIES
%%
%% RHCriteriaMaps.agda constructs the exact logical maps with their local
%% analytic bridges as explicit arguments:
%% * all-character Dirichlet GRH -> primitive-character Dirichlet GRH;
%% * the converse requires only ancestor-zero transfer in one direction;
%% * all-character GRH -> full RH uses the trivial-character zeta identity and
%%   classification of a nontrivial zero into the open strip, without conductor
%%   computation or a primitive-ancestor construction;
%% * RH/GRH <-> the corresponding fixed-point statements requires only the
%%   line/fixed-point maps; involutivity is not used by those equivalences;
%% * Robin <-> Lagarias composes the two source equivalence maps;
%% * strict Lagarias for n>1 plus equality at n=1 gives weak Lagarias for n>=1
%%   by induction/case analysis, with no limit argument;
%% * an actual counterexample refutes RH; no constructive counterexample
%%   extractor from a bare negation of RH is asserted.
%%
%% Two unnecessary imports are removed in the Hets development:
%%   RH26_DAGGER_ZERO_RETURN -> RH26_TARGET_DEFINITIONS,
%%   AT26_CharacterBridge -> RH26_TARGET_DEFINITIONS.
%% Their analytic contracts remain in the source layers that actually use them.
%% The original global polynomial statement remains the explicitly scoped
%% guarded Q_gt producer and its paid wrapper. These new categorical proofs
%% neither enlarge its input class nor identify proof grade with bit time.
%%
%% The dated external receipt records MIT's November 24 report of checked RH,
%% Dirichlet-GRH and arithmetic consequences. Its reported dependencies are
%% propext, Classical.choice and Quot.sound. These reports are retained as an
%% external classical branch, not a local constructive discharge or a replay
%% of the complete analytic proof. Exact source URLs and fingerprints accompany
%% the receipt; source pages and the large external proof are not duplicated.
%%
%% 7. HETS AND NATIVE CHECKING ARE SEPARATE CHECKS
%%
%% AD26 is the first-order, set-indexed constructor presentation of the family
%% maps. Its PiApply(section,x) omits a path argument, so it is expressly not
%% a generic erasure of arbitrary path-dependent Agda families. The native
%% proof retains all path witnesses and requires no UIP. No erasure axiom
%% is added. Support commutes with Sigma and pullback; only
%%   support(Pi_f A) -> Pi_f(support A)
%% is asserted without an actual supplied section in the converse direction.
%%
%% Hets static analysis checks the complete CASL source and signatures. Native
%% Agda checks the constructive proof terms. Neither receipt is represented
%% as the other. The source theorem contracts for Galois/analysis and the
%% external classical branch keep their stated foundations and exact domains.
%%
%% Primary background references (the new proof terms are included, not copied):
%% https://easychair.org/publications/open/zPd [institution comorphisms]
%% https://www.paultaylor.eu/prafm/html/s94.html [dependent products]
%% https://agda.readthedocs.io/en/v2.9.0/language/safe-agda.html
%% https://agda.readthedocs.io/en/v2.9.0/language/without-k.html
%% https://math.mit.edu/~drew/grh/
%% https://math.mit.edu/~drew/grh/arith-audit.log
%% END_H24_ADJOINTS_GUIDE

