%% BEGIN_H24_DIRECT_CONSTRUCTOR_PY
%% #!/usr/bin/env python3
%% """Source-equational H24 proof construction, with an independent tiny kernel.
%%
%% This file uses only the Python standard library.  Its planner produces an
%% admitted equation-task policy, NOT proofs.  ``build`` is the sole proof-object
%% constructor: it recursively discharges the complete chosen premise list.
%% ``check`` then validates the serialized proof independently, using exactly
%% Refl, Sym, Trans, Cong and Inst.  Inst accepts only the explicit source
%% equation schemas checked against the actual CASL source declarations.  The
%% portable route is ``--atlas FILE``: it reads every selected source spec from
%% that ONE delivered Hets file, with no companion source fragments.  The older
%% ``--source-dir`` route remains available for development.  Fingerprints cover
%% selected source blocks, so embedding this checker and its certificates in
%% the atlas does not create a whole-file hash self-reference.
%%
%% The deterministic normalizer has two deliberately small admitted languages:
%% coordinate expansion for the PN25 vector/matrix definitions, and finite
%% recipe expansion for the GT25 definition.  It is not a universal equation
%% solver, a shortest-proof search, an E invocation, or a symbolic-algebra oracle.
%% """
%%
%% from __future__ import annotations
%%
%% import argparse
%% from collections import Counter
%% from dataclasses import dataclass
%% import hashlib
%% import json
%% from pathlib import Path
%% import re
