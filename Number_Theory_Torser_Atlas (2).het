%% BEGIN_H24_DIRECT_CHARGE_ACCOUNT
%% EXACT CHARGE ACCOUNTING FOR THE CONSTRUCTED PROOF
%%
%% The primitive proof checker, rather than a claimed optimum, determines the
%% actual rule instances being counted. Let a reachable proof node v have rule
%% kind k(v), nonnegative configured charge c(k(v)), and its complete ordered
%% premise list children(v). A repeated child id is a repeated premise occurrence.
%% First check that every child exists, has the required equation and sorts, and
%% has smaller rank in the actual construction policy. Reject cycles, missing
%% children, invalid source instances and incomplete premise lists.
%%
%% Expanded proof-tree charge is the constructor recurrence
%%     T(v) = c(k(v)) + SUM_[each occurrence u in children(v)] T(u).
%% Caching this arithmetic is permitted; it does not discard repeated summands.
%% The checker can also return the pair of exact counters obtained by charging
%% every primitive rule one unit, and by charging only Inst nodes one unit.
%% These are different useful observables; neither is a bit-clock measurement.
%%
%% For the shared DAG, collect only nodes reachable from the declared roots.
%%     D = SUM_[distinct reachable v] c(k(v)).
%% If multiple roots are compared, report individual T(root), their sum as an
%% expanded forest, and D for their union, rather than adding per-root DAG sizes
%% and calling the result a shared cost.
%%
%% An independent expanded-tree check uses edge multiplicities. Initialize
%% mu(root)=1 (add one per root occurrence for a forest), process parents before
%% children, and add mu(v) to mu(u) for EVERY occurrence of child u of v. Then
%%     T(root) = SUM_v mu(v)*c(k(v)).
%% This equality follows by substituting the constructor recurrence. It detects
%% the common mistake of using a set of child ids instead of their ordered list.
%% For a DAG, D<=T because every reachable node has positive multiplicity and
%% all charges are nonnegative. Equality is not automatic when subproofs share.
%%
%% An H24 local calibration c(v)+SUM_child V(child)=V(v)+slack(v) telescopes to
%%     T(root)=V(root)+SUM_v mu(v)*slack(v)
%% for the actual expanded proof tree. It does not automatically telescope to
%% D for a shared DAG: each node was charged once, whereas incoming uses can be
%% multiple. A distinct shared-account/reserve proof is needed to price sharing.
%% Moreover values assigned after constructing just this proof do not establish
%% a lower bound against every competing original proof. That requires a fixed
%% calibration valid for every admitted rule of the competitor class.
%%
%% Generator work and checker work are separate observables. A memoized checker
%% may inspect each node once, but must pay the actual serialized term sizes,
%% substitution visits, sort checks, equation comparisons, child edges and source
%% schema validation. Instrumentation counters can report those operations; a
%% claim about primitive bit time additionally requires the chosen local-machine
%% implementation bound. No assertion T=D=elapsed time is made.
%% END_H24_DIRECT_CHARGE_ACCOUNT

%% BEGIN_H24_DIRECT_BRIDGE_PROOF
%% H24 SOURCE-EQUATION PROOF GENERATION: BRIDGE AND ACTUAL INSTANCE
%% 25 November 2026
%%
%% The fragment h24_bridge.het.inc contains four specifications and ten implied
%% returns. It imports the original HP25 constructor and uses the SAME
%% HC24Proof/HC24Forest. It introduces only primitive rule tags, not another
%% proof syntax or a second build algorithm.
%%
%% 1. EXACT SOURCE SEMANTICS
%% HB25_SourceTerms describes typed term interpretation at the abstract algebra
%% interface. Application interpretation is an actual operation on interpreted
%% argument lists. Equation injection keeps both endpoints. The source port
%% hb25SourceInstance accepts exactly the checked original source schemas and
%% sort-correct substitutions. Its truth is the original source assumption
%% under substitution; no pending target or derived lemma enters that port.
%% The concrete interpreter is the original many-sorted PN25/GT25 algebra,
%% embedded in a tagged value union. The source_dictionary, source_concordance,
%% checked renaming blocks and explicit substitutions are in proofs.json.
%%
%% 2. THE SMALL INDEPENDENT KERNEL
%% HB25_EquationKernel defines exactly Refl, Sym, Trans, Cong and Inst. Sym has
%% one specific reversed premise; Trans has both endpoint-matching premises;
%% Cong has the ENTIRE ordered, arity-matched argument-equation list; Inst has
%% no hidden premises and cites its exact validated original source instance.
%% The checker traverses the existing HC24 tree/forest. Every primitive has
%% unit charge. Source assumptions occur exactly at Inst tags; the four pure
%% logical rule forms add none. Actual packet support is therefore inherited
%% from the original HC24 recursive support reader, not a new summary flag.
%%
%% Local rule soundness is proved by the five cases. In Cong, argument-list
%% induction gives equality of the full interpreted argument vectors; operation
%% congruence then gives the original endpoint equality. Inst uses the named
%% source equation only. Mutual induction on HC24 proof/forest gives whole-proof
%% truth and Work=bt25Charge(number of primitive occurrences).
%%
%% 3. H24 IS THE PRODUCER, NOT AN OPTIMALITY DECORATION
%% HB25_AdmittedNormalizationPolicy says: for EVERY task IN THE PLAN DOMAIN,
%% its selected primitive passes the local kernel, every premise occurrence is
%% again in the domain, every child's natural rank is strictly smaller, and the
%% primitive charge is one. It deliberately makes no admission claim about
%% arbitrary raw equations, many of which are false.
%%
%% The actual Python Planner produces task/rule/premise/rank records.
%% No proof object is supplied by planning. ProofBuilder.build is the sole proof
%% node constructor; it recursively builds every chosen premise and then makes
%% the selected primitive node. This is hp25Build's existing ranked construction.
%% The independent check function reads the serialized policy and proofs, checks
%% all source substitutions and equations, and validates every task rank and
%% complete premise family. It does not trust the planner's output assertions.
%%
%% CASL fuel induction, simultaneous with the premise-list induction, proves
%% that the same hp25Build passes this kernel and returns the ORIGINAL equation.
%% Strong rank induction proves that ANY sufficient rank-derived fuel returns
%% the identical tree. Thus the memoized Python builder realizes the same proof
%% with shared storage. The HC24 node count still counts repeated premise
%% occurrences; distinct serialized DAG node count is a different observable.
%% PlanCountAt is a separate structural fold over the same selected rule data,
%% never an assumed optimum or a claimed original-input bit-time bound.
%%
%% No hc24Valid, tightness, zero excess or arbitrary shortest-proof conclusion
%% is asserted. Those notions retain their existing explicit local-calibration
%% requirements. Using H24 as this well-founded source-proof constructor needs
%% none of them. No potential is manufactured from a discovered proof's work.
%%
%% 4. THE FIVE CONCRETE ORIGINAL EQUATIONS
%% policy.json retains the original equation ASTs and target conjunctions:
%%   pn25_six_period_and_actual_involution:
%%     j57 -> p41: pn25U3(pn25U3(v)) = v.
%%   pn25_shift_is_linear:
%%     j154 -> p99: pn25U(pn25Add(v,w)) = pn25Add(pn25U(v),pn25U(w));
%%     j189 -> p127: pn25U(pn25Scale(r,v)) = pn25Scale(r,pn25U(v)).
%%   pn25_actual_six_channel_matrix_return:
%%     j218 -> p157: pn25NativeRead(pn25NativeMatrix(v)) = v.
%%   gt25_admitted_recipe_is_same_paracollatz_operation:
%%     j350 -> p249: gt25EvaluateRecipe(gt25PNRecipe,v) = pn25Normalize(v).
%%
%% These are the four original goal labels and all five equation conjuncts,
%% not substituted new question families. The executable verifies source labels
%% and renamings against the actual atlas/fragments. Its independent kernel
%% accepted 250 primitive DAG nodes. The plan contains exactly 250 retained
%% tasks, is closed under all premise occurrences, and each rank is zero at a
%% leaf or one plus the maximum child rank. The dedicated validation JSON
%% records the exact concrete evidence hashes seen by this bridge audit.
%%
%% 5. TESSERACT RETURN AND VERIFICATION STATUS
%% HB25_GeneratedProofPacketReturn invokes the existing hp25BuildPacket and
%% hc24DecodePacket. In every retained frame the decoded payload is the same
%% H24-produced checked proof, its conclusion is the exact original equation,
%% and that equation is true in the same source model. Recharting cannot change
%% the equation endpoints, source dependencies or proof occurrence structure.
%%
%% Native Hets parsed/statically analyzed the full combined source, including
%% all four bridge specs, with exit 0 and no diagnostics. See
%% h24_bridge_validation.json and h24_bridge_parse.log. The CASL implied goals
%% have adjacent written induction proofs but are not claimed as freshly ATP
%% replayed by this receipt. The actual four-target proof production is the
%% separate executable constructor plus independently checked serialized
%% primitive derivations, recorded in receipt.json.
%% END_H24_DIRECT_BRIDGE_PROOF

