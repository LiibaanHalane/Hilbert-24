%%     Number_Theory_Torser_Atlas.het NATIVE_REPLAY_PY native_replay.py
%% The displayed command is one shell command (join its wrapped lines).
%%   python3 native_replay.py Number_Theory_Torser_Atlas.het /path/hets /path/eprover
%%   python3 normalize_metagraph.py Number_Theory_Torser_Atlas.het
%%   python3 calculation_replay.py Number_Theory_Torser_Atlas.het
